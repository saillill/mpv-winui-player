<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
        <RootNamespace>mpv_winrt_test</RootNamespace>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\mpv-winrt-projection\mpv-winrt-projection.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework" />
        <Using Include="System.Text.RegularExpressions" />
        <Using Include="System.Threading.Tasks" />
    </ItemGroup>

    <ItemGroup>
        <!--
          The linked file that ControlBarLayoutGrammarTests.cs documents and
          depends on, and which was never added.

          The test class carries `using mpv_winui.Domains.Playback;` and its own
          summary says the class under test "is compiled into this assembly via a
          linked Compile item (see mpv-winrt-test.csproj)". That item was absent,
          so the file did not compile, so this project could not build, which is
          the mechanical reason its tests were never run by anything. The source
          file is the app's own, linked rather than copied so the test cannot
          drift from what ships, and it is deliberately free of UI types so this
          works without a WinUI runtime.
        -->
        <Compile Include="..\mpv-winui\Domains\Playback\ControlBarLayoutGrammar.cs" Link="Player\ControlBarLayoutGrammar.cs" />
    </ItemGroup>

    <PropertyGroup>
        <!--
          This test project is architecture neutral (AnyCPU), so $(Platform) is
          "AnyCPU" when it is built on its own and the native payloads would be
          looked for under libs\bin\AnyCPU\, which does not exist. Normalise to a
          real architecture first, preferring whatever the build asked for.
        -->
        <NativePlatform Condition="'$(Platform)' == 'x64' or '$(Platform)' == 'ARM64'">$(Platform)</NativePlatform>
        <NativePlatform Condition="'$(NativePlatform)' == ''">x64</NativePlatform>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Resolved per platform and configuration, matching where the two
          producers actually write:

            mpv-2.dll      libs\bin\<Platform>\                (fetch-mpv-libs.ps1)
            mpv_winrt.dll  ..\bin\<Platform>\<Configuration>\  (mpv-winrt.vcxproj OutDir)

          These used to be a flat ..\libs\bin\mpv-2.dll and a hardcoded
          ..\x64\Debug\mpv-winrt\mpv_winrt.dll. Neither path exists in this
          repository's layout, so the copy steps silently matched nothing and this
          test project could not have been run even if something had called it.
        -->
        <Content Include="..\libs\bin\$(NativePlatform)\mpv-2.dll" Condition="Exists('..\libs\bin\$(NativePlatform)\mpv-2.dll')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <!--
          MediaInfo is loaded at runtime by MpvPlayer (LoadLibraryW), because the
          native component links it only when the build has it. That makes it a
          payload this project needs too: without it Ready() is false and every
          tag and cover call returns empty, which looks exactly like the feature
          being broken.
        -->
        <Content Include="..\libs\bin\$(NativePlatform)\MediaInfo.dll" Condition="Exists('..\libs\bin\$(NativePlatform)\MediaInfo.dll')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\bin\$(NativePlatform)\$(Configuration)\mpv_winrt\mpv_winrt.dll" Condition="Exists('..\bin\$(NativePlatform)\$(Configuration)\mpv_winrt\mpv_winrt.dll')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
