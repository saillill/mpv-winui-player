  <Import Project="$(PackagesDir)Microsoft.Windows.CppWinRT.$(CppWinRTVersion)\build\native\Microsoft.Windows.CppWinRT.props" Condition="Exists('$(PackagesDir)Microsoft.Windows.CppWinRT.$(CppWinRTVersion)\build\native\Microsoft.Windows.CppWinRT.props')" />
  <Import Project="$(PackagesDir)Microsoft.Windows.SDK.BuildTools.$(SdkBuildToolsVersion)\build\Microsoft.Windows.SDK.BuildTools.props" Condition="Exists('$(PackagesDir)Microsoft.Windows.SDK.BuildTools.$(SdkBuildToolsVersion)\build\Microsoft.Windows.SDK.BuildTools.props')" />
  <Import Project="$(PackagesDir)Microsoft.Windows.SDK.BuildTools.MSIX.$(SdkBuildToolsMsixVersion)\build\Microsoft.Windows.SDK.BuildTools.MSIX.props" Condition="Exists('$(PackagesDir)Microsoft.Windows.SDK.BuildTools.MSIX.$(SdkBuildToolsMsixVersion)\build\Microsoft.Windows.SDK.BuildTools.MSIX.props')" />
