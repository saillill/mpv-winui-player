    <SdkBuildToolsVersion>10.0.28000.2526</SdkBuildToolsVersion>
    <SdkBuildToolsMsixVersion>1.7.260610101</SdkBuildToolsMsixVersion>
    <WebView2Version>1.0.4129.50</WebView2Version>
