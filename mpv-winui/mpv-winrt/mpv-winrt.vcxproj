    <WinAppSdkBaseVersion>2.0.4</WinAppSdkBaseVersion>
    <WinAppSdkDWriteVersion>2.1.0</WinAppSdkDWriteVersion>
    <WinAppSdkFoundationVersion>2.3.12</WinAppSdkFoundationVersion>
