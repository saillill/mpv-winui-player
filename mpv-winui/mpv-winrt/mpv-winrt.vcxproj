  <!--
    Unconditional: the output layout is per-platform by construction
    ($(Platform) is in the path), so there is nothing platform-specific left to
    gate. The previous x64-only conditions meant an ARM64 build dropped its
    component somewhere the app project does not look for it.
  -->
  <PropertyGroup>
    <TargetName>mpv_winrt</TargetName>
    <OutDir>$(ProjectDir)..\bin\$(Platform)\$(Configuration)\mpv_winrt\</OutDir>
    <IntDir>$(ProjectDir)..\obj\$(Platform)\$(Configuration)\mpv_winrt\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <WarningLevel>Level4</WarningLevel>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalOptions>%(AdditionalOptions) /bigobj /utf-8</AdditionalOptions>
      <PreprocessorDefinitions>_WINRT_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalUsingDirectories>$(WindowsSDK_WindowsMetadata);$(AdditionalUsingDirectories)</AdditionalUsingDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateWindowsMetadata>true</GenerateWindowsMetadata>
      <ModuleDefinitionFile>mpv_winrt.def</ModuleDefinitionFile>
    </Link>
  </ItemDefinitionGroup>
  <!--
    Native library layout: arch-independent headers, per-architecture libraries
    and runtime DLLs.

      libs\include            headers, shared by every architecture
      libs\lib\<Platform>\    mpv.lib and friends
      libs\bin\<Platform>\    mpv-2.dll and friends

    $(Platform) is used verbatim (x64, ARM64) so the directory name and the
    MSBuild platform cannot disagree. The previous flat libs\lib + libs\bin
    layout could only ever describe one architecture, which is why the ARM64
    wiring was missing rather than merely wrong.
  -->
  <PropertyGroup Label="NativeLibraryLayout">
    <LibsDir>$(MSBuildThisFileDirectory)..\libs\</LibsDir>
    <MpvIncludeDir>$(LibsDir)include</MpvIncludeDir>
    <MpvLibDir>$(LibsDir)lib\$(Platform)</MpvLibDir>
    <MpvRuntimeDir>$(LibsDir)bin\$(Platform)</MpvRuntimeDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(IntDir)Generated Files\sources;$(MpvIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(MpvLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>mpv.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(IntDir)Generated Files\sources;$(MpvIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalDependencies>mpv.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(MpvLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
