  <!--
    Fails the build when the native libraries for the target architecture are not
    on disk.

    This replaces a silent failure. Previously an ARM64 (or Win32) build simply
    did not receive the mpv include/library paths, so the compiler failed with a
    missing-header error that named a header rather than the missing architecture,
    and the app project had no guard at all, so a package could be produced with
    no mpv engine in it. An absent library is a packaging problem and should say
    so, with the path it looked in and the command that fixes it.

    x64 ships in-repo through the restore/download path; ARM64 has no upstream
    x64-only builder equivalent yet, so when this fires for ARM64 the message
    says what to supply rather than pretending it can be fetched.
  -->
  <Target Name="CheckNativeLibraries" BeforeTargets="ClCompile">
    <Error Condition="!Exists('$(MpvIncludeDir)\mpv\client.h')"
           Text="mpv headers are missing: '$(MpvIncludeDir)\mpv\client.h'. Run tools\fetch-mpv-libs.ps1 (or .\build.ps1 -FetchMpvLibs) to install the mpv development libraries." />
    <Error Condition="!Exists('$(MpvLibDir)\mpv.lib')"
           Text="The mpv import library for platform '$(Platform)' is missing: '$(MpvLibDir)\mpv.lib'. The mpv development libraries are per-architecture and live in libs\lib\&lt;Platform&gt;\ and libs\bin\&lt;Platform&gt;\. x64 is available via tools\fetch-mpv-libs.ps1; for ARM64 an aarch64 libmpv import library must be supplied and placed at that path before this configuration can build." />
  </Target>
</Project>