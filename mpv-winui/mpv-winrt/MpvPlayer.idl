// Value types live in Types\, event argument types in Events\; the runtime
// classes (MpvPlayer / MpvPreviewer) stay at the project root. MIDL resolves
// these relative to this file, and the generated .g.h / .winmd are emitted by
// name into the intermediate directory, so the grouping is source-only.
import "Types/DisplayColorKind.idl";
import "Types/DiscType.idl";
import "Types/MpvPlaylistItem.idl";
import "Types/MpvChapter.idl";
import "Types/MpvEdition.idl";
import "Types/MpvAudioDevice.idl";
import "Types/MpvProfile.idl";
import "Types/MpvMenuItem.idl";
import "Types/MpvTrack.idl";
import "Events/PlaybackStateChangedEventArgs.idl";
import "Events/VolumeChangedEventArgs.idl";
import "Events/PositionChangedEventArgs.idl";
import "Events/SpeedChangedEventArgs.idl";
import "Events/MediaInfoChangedEventArgs.idl";
import "Events/NetworkInfoChangedEventArgs.idl";
import "Events/FileFailedEventArgs.idl";
import "Events/TrackListChangedEventArgs.idl";
import "Events/TrackListCountChangedEventArgs.idl";
import "Events/WindowChangedEventArgs.idl";

import "Events/MpvLogEventArgs.idl";

import "Types/MpvGpuAdapter.idl";

import "Events/PlaybackFailedEventArgs.idl";

namespace mpv_winrt
{
	delegate void MediaLoadedEventHandler();
	delegate void PlaybackFailedEventHandler(PlaybackFailedEventArgs args);
	delegate void SeekEventHandler();
	delegate void VoConfiguredEventHandler();
	delegate void MpvLogEventHandler(MpvLogEventArgs args);
	delegate void MpvPropertyChangedEventHandler(String name, String value);
	delegate void FileStartedEventHandler();
	delegate void FileLoadedEventHandler();
	delegate void FileFailedEventHandler(FileFailedEventArgs args);
	delegate void FileEndedEventHandler();
	delegate void FileStoppedEventHandler();
	delegate void SeekStartedEventHandler();
	delegate void PlaybackRestartedEventHandler();
	delegate void SwapChainChangedEventHandler();
	delegate void TrackChangedEventHandler();
	delegate void BufferingChangedEventHandler(Boolean isBuffering);

	delegate void PlaybackStateChangedEventHandler(PlaybackStateChangedEventArgs args);
	delegate void VolumeChangedEventHandler(VolumeChangedEventArgs args);
	delegate void PositionChangedEventHandler(PositionChangedEventArgs args);
	delegate void SpeedChangedEventHandler(SpeedChangedEventArgs args);
	delegate void MediaInfoChangedEventHandler(MediaInfoChangedEventArgs args);
	delegate void NetworkInfoChangedEventHandler(NetworkInfoChangedEventArgs args);
	delegate void TrackListChangedEventHandler(TrackListChangedEventArgs args);
	delegate void TrackListCountChangedEventHandler(TrackListCountChangedEventArgs args);
	delegate void WindowChangedEventHandler(WindowChangedEventArgs args);
	delegate void DiscMenuActiveChangedEventHandler(Boolean isActive);
	delegate void LoopFileChangedEventHandler();
	delegate void LoopPlaylistChangedEventHandler();
	delegate void ShuffleChangedEventHandler();
	delegate void PlaylistChangedEventHandler();

	runtimeclass MpvPlayer
	{
		MpvPlayer();
		void Initialize(String configPath, UInt32 width, UInt32 height, Int32 volume, DisplayColorKind colorKind, Int32 refreshRate);
		void InitializeForPreview(UInt32 width, UInt32 height);
		void Destroy();
		void UpdateSize(UInt32 width, UInt32 height);
		void LoadFile(String url, Double position);
		void LoadList(String url);
		void AttachSwapChain(Microsoft.UI.Xaml.Controls.SwapChainPanel panel);
		void UpdateSwapChainScale(Single scaleX, Single scaleY);
		void UpdateDisplayColorInfo(DisplayColorKind colorKind);
		void UpdateDisplayRefreshRate(Int32 refreshRate);

		void Play();
		void Pause();
		void Stop();
		void TogglePlayPause();
		Boolean IsPaused();

		void Command(Windows.Foundation.Collections.IVector<String> args);
		void CommandString(String cmd);
		void ApplyCommandStrings(Windows.Foundation.Collections.IVector<String> commands);
		UInt64 ObserveProperty(String name, MpvPropertyChangedEventHandler handler);
		void UnobserveProperty(UInt64 handle);
		void SetLogLevel(String level);
		String GetCurrentFilePath();
		Double AbLoopA();
		Double AbLoopB();
		Windows.Foundation.Collections.IVectorView<MpvGpuAdapter> GetGpuAdapters();

		void PlaylistPlayIndex(Int32 index);
		void PlaylistMove(Int32 from, Int32 to);
		void PlaylistRemove(Int32 index);
		void PlaylistNext();
		void PlaylistPrevious();
		void PlaylistShuffle();

		String GetWatchHistoryPath();
		String GetWatchLaterFolderPath();
		Boolean SaveWatchHistory();
		String GetCurrentPath();

		Double Volume();
		void Volume(Double value);
		Boolean IsMuted();
		void IsMuted(Boolean value);

		Double Position();
		void Position(Double value);
		Double Duration();

		Int32 CurrentVideoTrack();
		void CurrentVideoTrack(Int32 value);
		Int32 CurrentAudioTrack();
		void CurrentAudioTrack(Int32 value);
		Int32 CurrentSubtitleTrack();
		void CurrentSubtitleTrack(Int32 value);
		Int32 CurrentSecondSubtitleTrack();
		void CurrentSecondSubtitleTrack(Int32 value);

		void AddSubtitle(String url, Boolean selected, String title);

		Double PlaybackSpeed();
		void PlaybackSpeed(Double value);

		Boolean LoopFile();
		void LoopFile(Boolean enabled);
		void SetLoopPlaylist(Boolean enabled);
		Boolean LoopPlaylist();
		void SetShuffle(Boolean enabled);
		Boolean Shuffle();

		void SetAspectRatio(String ratio);

		void SetHoverSec(Double sec);
		void SetDrawPreview(Int32 x, Int32 y, Int32 w, Int32 h);
		void ClearPreview();

		Windows.Foundation.Collections.IVectorView<MpvPlaylistItem> GetPlaylist();

		Windows.Foundation.Collections.IVectorView<MpvTrack> GetAudioTracks();
		Windows.Foundation.Collections.IVectorView<MpvTrack> GetVideoTracks();
		Windows.Foundation.Collections.IVectorView<MpvTrack> GetSubtitleTracks();
		Windows.Foundation.Collections.IVectorView<MpvChapter> GetChapters();
		Windows.Foundation.Collections.IVectorView<MpvEdition> GetEditions();
		Windows.Foundation.Collections.IVectorView<MpvAudioDevice> GetAudioDevices();
		Windows.Foundation.Collections.IVectorView<MpvProfile> GetProfiles();
		Int32 CurrentChapter();
		Int32 Edition();
		void Edition(Int32 value);
		Int32 CurrentEdition();
		String GetDiscPath(DiscType type);
		void SetDiscPath(DiscType type, String path);

		Windows.Foundation.Collections.IVectorView<MpvMenuItem> GetMenu();
		Windows.Foundation.Collections.IVectorView<String> GetSubtitleExtensions();
		String GetVersion();

		event FileStartedEventHandler FileStarted;
		event FileLoadedEventHandler FileLoaded;
		event FileFailedEventHandler FileFailed;
		event FileEndedEventHandler FileEnded;
		event FileStoppedEventHandler FileStopped;
		event SeekStartedEventHandler SeekStarted;
		event PlaybackRestartedEventHandler PlaybackRestarted;
		event TrackChangedEventHandler TrackChanged;
		event BufferingChangedEventHandler BufferingChanged;

		event PlaybackStateChangedEventHandler PlaybackStateChanged;
		event VolumeChangedEventHandler VolumeChanged;
		event PositionChangedEventHandler PositionChanged;
		event SpeedChangedEventHandler SpeedChanged;
		event MediaInfoChangedEventHandler MediaInfoChanged;
		event NetworkInfoChangedEventHandler NetworkInfoChanged;
		event TrackListChangedEventHandler TrackListChanged;
		event TrackListCountChangedEventHandler TrackListCountChanged;
		event SwapChainChangedEventHandler SwapChainChanged;
		event WindowChangedEventHandler WindowChanged;
		event DiscMenuActiveChangedEventHandler DiscMenuActiveChanged;
		event LoopFileChangedEventHandler LoopFileChanged;
		event LoopPlaylistChangedEventHandler LoopPlaylistChanged;
		event ShuffleChangedEventHandler ShuffleChanged;
		event PlaylistChangedEventHandler PlaylistChanged;
		event MediaLoadedEventHandler MediaLoaded;
		event PlaybackFailedEventHandler PlaybackFailed;
		event SeekEventHandler Seeked;
		event VoConfiguredEventHandler VoConfigured;
		event MpvLogEventHandler LogMessage;
	};
}
