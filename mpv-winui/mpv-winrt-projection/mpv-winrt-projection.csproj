<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Platform>AnyCPU</Platform>
        <UseWinUI>true</UseWinUI>
        <CsWinRTIncludes>mpv_winrt</CsWinRTIncludes>
        <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
        <CsWinRTGenerateAotProjection>true</CsWinRTGenerateAotProjection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!--
          Pinned to the WinUI version the app's Windows App SDK 2.5.1
          meta-package resolves (see mpv-winui.csproj), NOT floating.

          This project deliberately keeps taking the single component rather
          than the meta-package: it publishes a nupkg of its own
          (GeneratePackageOnBuild), so its reference graph is what consumers
          inherit, and there is no reason for a projection package to drag in
          Widgets/AI/ML/Search. Pinning to 2.3.9 is what makes that safe: it is
          the exact version 2.5.1 pins, so the component cannot drift out of
          the family the app ships. Bump this in the same commit that bumps the
          meta-package, and let the dependency note below be the reminder.
        -->
        <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!--
      Architecture, normalised. The property at the top of the file forces
      $(Platform) to AnyCPU, so a path written with $(Platform) would look under
      bin\AnyCPU\; and when this project is built as a dependency of the app or
      of mpv-winrt-test, MSBuild passes Platform down as a global property, which
      the AnyCPU assignment cannot override. Deriving a separate property keeps
      the native paths correct in both cases.
    -->
    <PropertyGroup>
        <NativeArch Condition="'$(Platform)' == 'x64' or '$(Platform)' == 'ARM64'">$(Platform)</NativeArch>
        <NativeArch Condition="'$(NativeArch)' == ''">x64</NativeArch>
    </PropertyGroup>

    <!--
      Built-by-reference, or built-already. This is the choice mpv-winui.csproj
      already makes and it is made here for the same reason: `dotnet build`
      cannot build a C++ project, because VCTargetsPath is a Visual Studio
      component (MSB4278).

      Unlike the app, this project's choice was not cosmetic: mpv-winrt-test
      references this project, so an unconditional ProjectReference to the
      vcxproj meant `dotnet test mpv-winrt-test` could never run at all, which is
      the mechanical reason that test project was never executed by anything.
      With the default path, the C++ component is expected to have been built
      already by build.ps1, and the projection is generated from its winmd.
    -->
    <ItemGroup Condition="'$(BuildMpvWinrtWithReference)' == 'true'">
        <ProjectReference Include="..\mpv-winrt\mpv-winrt.vcxproj">
            <PrivateAssets>all</PrivateAssets>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup Condition="'$(BuildMpvWinrtWithReference)' != 'true'">
        <Reference Include="mpv_winrt.winmd">
            <HintPath>..\bin\$(NativeArch)\$(Configuration)\mpv_winrt\mpv_winrt.winmd</HintPath>
        </Reference>
    </ItemGroup>

    <PropertyGroup>
        <PackageId>mpv-winrt-projection</PackageId>
        <PackageVersion>0.3.0-prerelease</PackageVersion>
        <PackageAuthors>ikas</PackageAuthors>
        <PackageDescription>mpv-winrt-projection</PackageDescription>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="$(OutputPath)mpv-winrt-projection.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
        <!--
          Both of these paths used to be wrong, and the package still built:
          `..\$(NativeArch)\$(Configuration)\mpv-winrt\mpv_winrt.dll` has no
          counterpart in this layout (the C++ component writes to
          bin\<arch>\<config>\mpv_winrt\), and `..\libs\bin\mpv-2.dll` predates the
          per-architecture split. A missing Pack file is not an error, so the
          produced nupkg simply shipped without the native payload it advertises
          in runtimes\win-<arch>\native.
        -->
        <None Include="..\bin\$(NativeArch)\$(Configuration)\mpv_winrt\mpv_winrt.dll" Pack="true" PackagePath="runtimes\win-$(NativeArch)\native" />
        <None Include="..\libs\bin\$(NativeArch)\mpv-2.dll" Pack="true" PackagePath="runtimes\win-$(NativeArch)\native" />
    </ItemGroup>
</Project>
