<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>mpv_conf_test</RootNamespace>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="NLog" Version="6.2.0" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework" />
        <Using Include="System.Text" />
        <Using Include="System.Text.Json" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\mpv-winui\Modules\FileSystem\FileService.cs" Link="FileSystem\FileService.cs" />
        <Compile Include="..\mpv-winui\Modules\MpvConf\Conf\**\*.cs" Link="MpvConf\Conf\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\mpv-winui\Modules\MpvConf\Option\**\*.cs" Link="MpvConf\Conf\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\mpv-winui\Modules\MpvConf\Schema\**\*.cs" Link="MpvConf\Conf\%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="..\mpv-winui\Modules\Menu\MpvMenu\**\*.cs" Link="Menu\MpvMenu\%(RecursiveDir)%(Filename)%(Extension)" />
        <!-- The quote/unquote pair. Linked rather than project-referenced so the
             round-trip assertion runs here: the defect it guards against (an
             escaped value re-escaped on every launch, reaching 896 MB) was
             invisible to every static checker, because none of them write a
             value out and read it back. -->
        <Compile Include="..\mpv-winui\Modules\Settings\MpvConfValueCodec.cs" Link="Settings\MpvConfValueCodec.cs" />
        <!-- The settings store's own value converter. Linked for the same reason:
             it is a pure function, and the defect it carried was invisible to
             every static checker. A REG_DWORD bool is surfaced by
             ApplicationDataContainer as an unsigned integral, while the bool arm
             matched `int` only, so EnableDebugLog read back as false while both
             the registry and the settings window said "enabled", and two days of
             app logs contained zero DEBUG and zero INFO lines. -->
        <Compile Include="..\mpv-winui\Modules\Settings\SettingValueCodec.cs" Link="Settings\SettingValueCodec.cs" />
        <!-- The control bar's width/orientation tiers. Linked for the same
             reason: the rules are pure data, and the two defects they carried
             (a portrait window that was never recognised as portrait, and an
             overflow button decided by a question the menu does not ask) are
             only visible by asking the table directly. -->
        <Compile Include="..\mpv-winui\Modules\Player\ControlBarAdaptiveLayout.cs" Link="Player\ControlBarAdaptiveLayout.cs" />
        <Compile Include="..\mpv-winui\Modules\Player\LibraryIndexLetter.cs" Link="Player\LibraryIndexLetter.cs" />
    <Compile Include="..\mpv-winui\Modules\Player\IndexRailHover.cs" Link="Player\IndexRailHover.cs" />
        <Compile Include="..\mpv-winui\Modules\Player\Audio\SpectrumAnalyzer.cs" Link="Player\Audio\SpectrumAnalyzer.cs" />
        <Compile Include="..\mpv-winui\Modules\Player\Audio\AlbumColorExtractor.cs" Link="Player\Audio\AlbumColorExtractor.cs" />
        <Compile Include="..\mpv-winui\Infrastructure\Motion\SpringMath.cs" Link="Motion\SpringMath.cs" />
        <!-- The atomic-replace writer the settings layer now uses for mpv.conf,
             its state file and script-opts. Linked for the usual reason: the
             property that matters is not "it wrote something" but "a reader
             either sees the whole old file or the whole new one, and no
             temporary is left behind", which only a real file system can show. -->
        <Compile Include="..\mpv-winui\Modules\Common\Utils\AtomicFile.cs" Link="Common\Utils\AtomicFile.cs" />
        <!-- The mpvw:// protocol contract. Linked for the usual reason, and here
             it is the whole point: the scheme was written in four places (two
             constants and two string literals) and the parser accepted a fifth
             value, so a registration could succeed and produce an association the
             app then ignored. Nothing in the build could see that because none of
             those values was reachable from a test. Pure BCL on purpose. -->
        <Compile Include="..\mpv-winui\Modules\Activation\MpvProtocolUri.cs" Link="Activation\MpvProtocolUri.cs" />
        <!-- The language-code guard. Linked for the usual reason: the code comes
             from a stored setting and used to be concatenated into a path and an
             mpv command unvalidated, so what matters is exactly which inputs are
             accepted, which is a pure predicate and testable on its own. -->
        <Compile Include="..\mpv-winui\Lexicon\Language\LanguageCode.cs" Link="Language\LanguageCode.cs" />
    </ItemGroup>

    <!--
      A Content item used to point at ..\mpv-winui\Data\MpvConfEditor\*.json.
      That directory does not exist and is not in the repository, and no test in
      this project reads a data file at all, so the item resolved to nothing and
      always had. Removed rather than redirected: the option schema now lives in
      mpv-winui\MpvConfOptions\mpv-options.json (shipped with the app) and
      appdata-sample\mpv-conf-editor\, and if a test ever needs one of those, the
      dependency should be added together with the test that uses it.
    -->

    <ItemGroup>
      <Compile Remove="..\mpv-winui\Modules\MpvConf\Option\MpvConfOptionControl.xaml.cs" />
      <Compile Remove="..\mpv-winui\Modules\MpvConf\Option\MpvConfOptionControlBase.cs" />
    </ItemGroup>
</Project>
