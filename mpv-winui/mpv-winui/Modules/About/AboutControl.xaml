<UserControl
    x:Class="mpv_winui.Modules.About.AboutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel MinWidth="400" Spacing="12">
        <!-- App identity card: name, version, project link. -->
        <Border
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="AppNameTextBlock"
                    FontSize="20"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="AppVersionTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Engine card: the bundled mpv and its upstream links. -->
        <Border
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel Spacing="6">
                <TextBlock
                    x:Name="MpvSectionTitle"
                    FontSize="14"
                    FontWeight="SemiBold" />
                <TextBlock
                    x:Name="MpvVersionTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    x:Name="MpvLinkButton"
                    Padding="0"
                    HorizontalAlignment="Left"
                    NavigateUri="https://github.com/mpv-player/mpv" />
            </StackPanel>
        </Border>

        <!-- Project card. -->
        <Border
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <StackPanel Spacing="6">
                <TextBlock
                    x:Name="ProjectSectionTitle"
                    FontSize="14"
                    FontWeight="SemiBold" />
                <HyperlinkButton
                    x:Name="ProjectLinkButton"
                    Padding="0"
                    HorizontalAlignment="Left"
                    NavigateUri="https://github.com/ikas-mc/mpv-winui-player" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
