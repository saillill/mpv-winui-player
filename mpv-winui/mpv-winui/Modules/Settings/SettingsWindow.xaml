<Window
    x:Class="mpv_winui.Modules.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="SettingsTitleText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Settings" />
                <!-- Search lives in the window top bar (Win11-settings style):
                     pill-shaped, leading glyph, placeholder from AppLang. -->
                <Grid
                    Grid.Column="1"
                    Width="340"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <AutoSuggestBox
                        x:Name="SearchBox"
                        Height="32"
                        CornerRadius="16"
                        Padding="34,0,10,0"
                        PlaceholderText="Find a setting"
                        QuerySubmitted="SearchBox_QuerySubmitted"
                        SuggestionChosen="SearchBox_SuggestionChosen"
                        TextChanged="SearchBox_TextChanged" />
                    <FontIcon
                        Glyph="&#xE721;"
                        FontSize="14"
                        Margin="14,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Border>
        <Frame
            x:Name="PageFrame"
            Grid.Row="1"
            Loaded="PageFrame_Loaded" />
    </Grid>
</Window>
