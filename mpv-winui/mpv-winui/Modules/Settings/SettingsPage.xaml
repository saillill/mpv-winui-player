<Page
    x:Class="mpv_winui.Modules.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:mpv_winui.Modules.Settings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        WinUI 3 settings shell: NavigationView (icon pane) on the left,
        search + options + reset footer in the content area. The category
        items are built in code so their labels follow AppLang on language
        switches without rebuilding the page.
    -->
    <NavigationView
        x:Name="CategoryNav"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="240"
        PaneDisplayMode="Left"
        SelectionChanged="CategoryNav_SelectionChanged">
        <NavigationView.Content>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    Grid.Row="0"
                    Margin="12,10,12,4"
                    PlaceholderText="Search"
                    QueryIcon="Find"
                    QuerySubmitted="SearchBox_QuerySubmitted"
                    SuggestionChosen="SearchBox_SuggestionChosen"
                    TextChanged="SearchBox_TextChanged" />

                <!-- Windows-Settings-style sub-page breadcrumb: back chevron +
                     "category > section", shown only while drilled into a
                     section (built in UpdateOptions). -->
                <Grid
                    x:Name="BreadcrumbBar"
                    Grid.Row="1"
                    Margin="12,2,12,4"
                    ColumnSpacing="4"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="BreadcrumbBackButton"
                        Grid.Column="0"
                        MinWidth="32"
                        MinHeight="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BreadcrumbBack_Click">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock
                        x:Name="BreadcrumbText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Sub-category overview: section cards shown instead of the
                     option list when a category holds more than one section. -->
                <ListView
                    x:Name="SectionsHost"
                    Grid.Row="2"
                    Margin="12,4,12,0"
                    Padding="0,0,4,0"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    Visibility="Collapsed" />

                <ctl:OptionListControl
                    x:Name="OptionsControl"
                    Grid.Row="2"
                    ShowHeaders="False" />

                <Border
                    Grid.Row="3"
                    Padding="16,10"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="SaveStatusText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <Button
                            x:Name="ResetButton"
                            Grid.Column="1"
                            MinWidth="96"
                            Click="OnResetClick" />
                        <Button
                            x:Name="ResetAllButton"
                            Grid.Column="2"
                            MinWidth="96"
                            Click="OnResetAllClick" />
                    </Grid>
                </Border>
            </Grid>
        </NavigationView.Content>
    </NavigationView>
</Page>
