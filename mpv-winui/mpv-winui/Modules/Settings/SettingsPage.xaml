<Page
    x:Class="mpv_winui.Modules.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ar="using:mpv_winui.Modules.ActivationRegistration"
    xmlns:ctl="using:mpv_winui.Modules.Settings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Mirrors OptionListViewItemStyle: section cards must sit in the
             same padded content area as the option cards, not inside the
             ListView's default 12px item chrome. -->
        <Style
            x:Key="SectionCardListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </Page.Resources>

    <!--
        WinUI 3 settings shell: NavigationView (icon pane) on the left,
        search + options + reset footer in the content area. The category
        items are built in code so their labels follow AppLang on language
        switches without rebuilding the page.

        The pane is hidden while customizing: the folder tree already lists
        the same categories, and showing both reads as a duplicated sidebar.

        The two mode thresholds are set, and set equal, so the pane collapses to
        the icon rail at exactly the width the window's search pill gives up its
        place (MpvNarrowLayoutThreshold, one token, two files). Unset they fall
        back to the defaults, which sit far below where this window's top bar
        runs out of room, so the pane stayed expanded while the pill was squeezed
        and the two ends of one breakpoint disagreed. NavigationView animates
        the transition itself; the threshold is what picks the width, and the
        pair above makes that width a stated number instead of a framework
        default.
    -->
    <NavigationView
        x:Name="CategoryNav"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="240"
        PaneDisplayMode="Auto"
        SizeChanged="SettingsPage_SizeChanged"
        CompactModeThresholdWidth="{StaticResource MpvNarrowLayoutThreshold}"
        ExpandedModeThresholdWidth="{StaticResource MpvNarrowLayoutThreshold}"
        SelectionChanged="CategoryNav_SelectionChanged">
        <NavigationView.Resources>
            <!-- One surface for pane and content: no inner grey layers, the
                 window background shows through on both sides. -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        </NavigationView.Resources>
        <NavigationView.Content>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The three rows below are the rows of one content column,
                     and every row carries the same pair: MaxWidth plus
                     HorizontalAlignment="Stretch". Each row is the direct child
                     of the page Grid, so it fills the content area's width up to
                     the column's cap, and the three then share one left edge.

                     Stretch rather than Center, deliberately. A centred row is
                     arranged at its *desired* width, and a row whose width comes
                     from its content (the breadcrumb's "back chevron + title",
                     or a ScrollViewer wrapping a column of cards) desires only
                     as much as it happens to hold. The column then shrank and
                     the page floated in the middle of the window: the title sat
                     near the window centre while the cards began somewhere else
                     again. Stretch gives all three the same finite width, so they
                     cannot disagree about where the column starts.

                     Keep these three as direct children. A wrapper Grid would
                     have to reproduce that same finite width, and an earlier
                     attempt to fix this by centring a wrapper is what produced
                     the shrinking it was meant to cure.

                     The cap still applies: past MpvContentMaxWidth the column
                     stops growing and the layout centres the capped column, which
                     is what Windows Settings does on a wide display.

                     The column's sub-rows add no horizontal padding of their
                     own. Every row starts at the column's own x and the content
                     inside it does too, so the breadcrumb, the option cards and
                     the footer share one left edge instead of two insets stacked
                     on the cards but not on the other two. -->
                <Grid
                    x:Name="BreadcrumbBar"
                    Grid.Row="0"
                    MaxWidth="{StaticResource MpvContentMaxWidth}"
                    HorizontalAlignment="Stretch"
                    Margin="{StaticResource MpvBreadcrumbBarMargin}"
                    ColumnSpacing="{StaticResource MpvSpaceM}"
                    Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource MpvSpaceM}">
                            <!-- A plain TextBlock with a Tapped handler, not a
                                 Button. Every earlier attempt kept the category
                                 inside a Button and tried to make its
                                 ContentPresenter agree with the sibling
                                 TextBlocks about where the baseline goes; the
                                 leftover offset lived in that presenter and was
                                 invisible in the markup. The wrapping frame was
                                 the problem, so it is gone: all three trail
                                 elements are now the same element type with the
                                 same metrics, and the baselines match because
                                 there is no second layout authority between them.

                                 The trail is text only: the leading back
                                 chevron is gone. It was a second way to do what
                                 the category caption already does (clear the
                                 drilled-in section and return to the category
                                 overview), and the caption is the better
                                 affordance because it names where the click
                                 lands. Its hover state is therefore expressed
                                 with the caption's own properties rather than a
                                 wrapping control, for the reason above: an
                                 Opacity bump and a Foreground lift, toggled from
                                 the pointer handlers, cost no layout and add no
                                 element between the captions. -->
                            <TextBlock
                                x:Name="BreadcrumbCategoryText"
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="24"
                                FontWeight="SemiBold"
                                LineHeight="{StaticResource MpvBreadcrumbLineHeight}"
                                LineStackingStrategy="BlockLineHeight"
                                Tapped="BreadcrumbCategory_Tapped"
                                PointerEntered="BreadcrumbCategory_PointerEntered"
                                PointerExited="BreadcrumbCategory_PointerExited"
                                TextTrimming="CharacterEllipsis"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="BreadcrumbSeparator"
                                VerticalAlignment="Center"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                LineHeight="{StaticResource MpvBreadcrumbLineHeight}"
                                LineStackingStrategy="BlockLineHeight"
                                Text="&#x203A;"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="BreadcrumbSection"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                LineHeight="{StaticResource MpvBreadcrumbLineHeight}"
                                LineStackingStrategy="BlockLineHeight"
                                Margin="{StaticResource MpvBreadcrumbSectionNudge}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                </Grid>

                <!-- Sub-category overview: section cards shown instead of the
                     option list when a category holds more than one section. -->
                <!-- One scrolling surface per category page: common options
                     directly on the overview, then the advanced entry cards. -->
                <Grid Grid.Row="1">
                    <!-- Browsing layout: one column of cards under the trail.

                         The column has exactly one gutter, defined here: a
                         ScrollViewer that is inset 12 from the content area
                         (so the column does not touch the NavigationView pane
                         or the window edge) and otherwise exactly the column
                         width. The controls inside it add no horizontal padding
                         of their own, so every card starts on the column's own
                         x. This used to be described in two places at once (here
                         and inside OptionListControl), which stacked 20px on the
                         left of the cards while the breadcrumb above and the
                         footer below kept 12, leaving the cards looking both
                         misaligned and off-centre.

                         Horizontal scrolling stays disabled: left at its
                         default (Enabled/Auto) the ScrollViewer would measure
                         its content against infinite width, giving the column
                         no finite width to be centred within.

                         This ScrollViewer is the ONE scrolling surface for the
                         category page. The ListViews inside it are
                         height-constrained and have their own scrolling turned
                         off (see OptionListControl), because two nested
                         scrollers in one page is what makes a scroll gesture
                         ambiguous and what let a click re-enter layout while a
                         scroll was still settling. One owner, one scrollbar.

                         The width clamp sits on the ScrollViewer itself, in
                         the same shape as the breadcrumb row above and the
                         footer below: MaxWidth caps the element's own box, and
                         the row's 12px inset lives inside that box. Putting
                         the MaxWidth on the inner panel instead - with the
                         inset on the ScrollViewer - made this the only row
                         whose cap and inset were on different elements, so its
                         content column measured 1060 where the other two
                         measured 1036, and the cards sat 12px wider on each
                         side than the title they hang under.

                         It follows that the content here is measured at finite
                         height, so an inner ListView cannot virtualise.
                         That cost is bounded by the fold rule: the largest
                         generated section (205 rows) is a folded section, so it
                         reaches this list as one card, not 205 rows. -->
                    <ScrollViewer
                        x:Name="BrowseHost"
                        MaxWidth="{StaticResource MpvContentMaxWidth}"
                        HorizontalAlignment="Stretch"
                        Margin="{StaticResource MpvBrowseHostMargin}"
                        Padding="0"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled">
                        <StackPanel HorizontalAlignment="Stretch">
                            <ctl:OptionListControl x:Name="OptionsControl" ShowHeaders="False" />
                            <!-- Scrolling off, like OptionListView inside the
                                 control above. This list is measured at
                                 infinite height by the StackPanel, so leaving
                                 its own ScrollViewer enabled made it report
                                 its viewport height instead of its content
                                 height - the section cards past the first
                                 screenful were then neither drawn nor included
                                 in BrowseHost's scroll extent. BrowseHost owns
                                 the page's only scroll; every list inside it
                                 must decline its own. -->
                            <ListView
                                x:Name="SectionsHost"
                                Margin="0,4,0,0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                SelectionMode="None"
                                IsItemClickEnabled="False"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ItemContainerStyle="{StaticResource SectionCardListViewItemStyle}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Customize layout: bookmark-manager shape — the folder
                         tree on the left, the cards of the selected folder on
                         the right. Cards are dragged from right to left to file
                         them, and folders are reordered within the tree. -->
                    <Grid
                        x:Name="CustomizeRoot"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Scope notice: this whole mode is presentation-only,
                             and a rename is per-language unless told otherwise.
                             Both facts are easy to get wrong, so they are stated
                             up front rather than buried in a dialog. -->
                        <InfoBar
                            x:Name="CustomizeScopeBar"
                            Grid.Row="0"
                            Margin="12,0,12,8"
                            IsClosable="True"
                            IsOpen="True"
                            Severity="Informational" />

                        <Grid
                            Grid.Row="1"
                            ColumnSpacing="{StaticResource MpvSpaceM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SidebarColumn" Width="272" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: categories (1st level) each holding their
                                 folders (2nd level). Collapsible to the arrow
                                 rail on the far left. -->
                            <Border
                                x:Name="SidebarPanel"
                                Grid.Column="0"
                                Margin="12,4,0,12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Header: caption + "add" button. The
                                         button opens a menu of what can be
                                         added, rather than claiming a single
                                         action it cannot honour. -->
                                    <Grid
                                        Grid.Row="0"
                                        Margin="12,8,8,4"
                                        ColumnSpacing="{StaticResource MpvSpaceCompact}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="TreeTitleText"
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            x:Name="AddCategoryButton"
                                            Grid.Column="1"
                                            MinWidth="0"
                                            Padding="{StaticResource MpvCompactButtonPadding}"
                                            Click="AddCategoryButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource MpvSpaceCompact}">
                                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                                <TextBlock x:Name="AddCategoryButtonText" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="CollapseSidebarButton"
                                            Grid.Column="2"
                                            MinWidth="0"
                                            Padding="{StaticResource MpvCompactButtonPadding}"
                                            Click="CollapseSidebar_Click">
                                            <FontIcon FontSize="14" Glyph="&#xE76B;" />
                                        </Button>
                                    </Grid>

                                    <!-- Hint under the header, so "add" does not
                                         have to explain itself in the caption. -->
                                    <TextBlock
                                        x:Name="TreeHintText"
                                        Grid.Row="1"
                                        Margin="12,0,12,8"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        TextWrapping="Wrap" />

                                    <ScrollViewer Grid.Row="2" Padding="4,0,4,8">
                                        <!-- The template is declared against
                                             TreeViewNode, which is what a TreeView
                                             over RootNodes actually hands its
                                             template. Declaring it against the
                                             payload type instead is what crashed the
                                             page: the generated binding component
                                             then hard-casts the TreeViewNode, and
                                             NavigationView's MenuItems.Clear()
                                             re-enters that component with the wrong
                                             object, throwing InvalidCastException.
                                             Content stays typed as object here, so
                                             ToString() is a plain virtual call and
                                             cannot fail. -->
                                        <TreeView
                                            x:Name="FolderTree"
                                            AllowDrop="True"
                                            CanDragItems="True"
                                            CanReorderItems="True"
                                            DragItemsCompleted="FolderTree_DragItemsCompleted"
                                            ItemInvoked="FolderTree_ItemInvoked"
                                            SelectionMode="Single"
                                            SelectionChanged="FolderTree_SelectionChanged">
                                            <TreeView.ItemTemplate>
                                                <DataTemplate x:DataType="TreeViewNode">
                                                    <Grid
                                                        MinHeight="32"
                                                        ColumnSpacing="{StaticResource MpvSpaceS}"
                                                        ContextFlyout="{x:Bind local:TreeHelpers.MenuFor(Content)}"
                                                        Opacity="{x:Bind local:TreeHelpers.OpacityFor(Content)}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Double-bar drag handle:
                                                             the affordance itself
                                                             signals the row can be
                                                             reordered. -->
                                                        <FontIcon
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Glyph="&#xE76F;"
                                                            ToolTipService.ToolTip="{x:Bind local:TreeHelpers.DragTip(Content)}" />
                                                        <FontIcon
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Glyph="{x:Bind local:TreeHelpers.GlyphFor(Content)}" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Text="{x:Bind local:TreeHelpers.TextFor(Content)}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <!-- Custom folders only:
                                                             an inline pencil, so the
                                                             rename entry is visible
                                                             instead of hidden in the
                                                             context menu. The button
                                                             carries no text of its
                                                             own, so the rename
                                                             caption is both its
                                                             tooltip and its
                                                             accessible name.
                                                             The padding is not a
                                                             scale step: it is
                                                             sized so this button
                                                             keeps the row height
                                                             of the tree row it
                                                             sits in. -->
                                                        <Button
                                                            Grid.Column="3"
                                                            MinWidth="0"
                                                            Padding="{StaticResource MpvTinyButtonPadding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            AutomationProperties.Name="{x:Bind local:TreeHelpers.EditTip(Content)}"
                                                            Click="EditTreeNode_Click"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="{x:Bind local:TreeHelpers.EditTip(Content)}"
                                                            Visibility="{x:Bind local:TreeHelpers.EditVisibility(Content)}">
                                                            <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Collapsed rail: a single arrow that brings the
                                 tree back. Kept in the same column slot so the
                                 right pane does not jump. -->
                            <Button
                                x:Name="ExpandSidebarButton"
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                Margin="12,4,0,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Click="ExpandSidebar_Click"
                                Visibility="Collapsed">
                                <FontIcon FontSize="14" Glyph="&#xE76C;" />
                            </Button>

                            <!-- Right: the cards of whatever is selected on the
                                 left. The pane's caption and its two create
                                 actions live inside the control's own toolbar,
                                 so they share one row instead of the caption
                                 sitting on a row of its own above it.

                                 Wrapped in a ScrollViewer because this pane,
                                 unlike the browsing one, is given a finite
                                 height (a star row of CustomizeHost) and the
                                 list inside declines its own scrolling. Without
                                 a host scroll the rows past the first screenful
                                 were simply unreachable - visible in no state,
                                 scrollable by no gesture. Same shape as
                                 BrowseHost: one scrolling surface, 12px gutter,
                                 no MaxWidth (the pane is already narrower than
                                 the reading column). -->
                            <ScrollViewer
                                Grid.Column="1"
                                Margin="0,4,0,12"
                                Padding="0"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled">
                                <ctl:OptionListControl
                                    x:Name="CustomizeOptionsControl"
                                    ShowHeaders="False" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- The footer bar, third row of the same content column. Its
                     12/10 padding is not a scale step: it is the optical match
                     to the breadcrumb row above it, vertically centred against
                     the same 32px controls. The 12 horizontal half matters as
                     well as the vertical one: this row shares the column's x
                     with the two above it, so its inset has to match theirs.

                     The Windows settings relationship between a page and its
                     footer is: a status line where there is one, and the
                     actions collected at the end of the row, most consequential
                     last. The browsing footer already ends with the widest
                     scope (重置所有设置 after 重置当前分类) and that order is kept;
                     what was missing is that 自定义 is a different kind of act
                     from either reset. It switches modes, it does not undo
                     anything, so it no longer reads as the first of three
                     identical buttons: its own group, then the divider, then
                     the two resets. The divider is what makes the footer read
                     as groups instead of a row of buttons, and it is the same
                     kind of separator the player's own toolbars use. -->
                <Border
                    Grid.Row="2"
                    MaxWidth="{StaticResource MpvContentMaxWidth}"
                    HorizontalAlignment="Stretch"
                    Padding="{StaticResource MpvFooterPadding}"
                    BorderThickness="0">
                    <Grid ColumnSpacing="{StaticResource MpvSpaceM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Status line: reset confirmations, apply/discard
                             feedback and the unsaved-changes warning share it. -->
                        <TextBlock
                            x:Name="SaveStatusText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />

                        <StackPanel
                            x:Name="BrowseActions"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="{StaticResource MpvSpaceM}"
                            VerticalAlignment="Center">
                            <!-- Mode switch: one button, on its own. -->
                            <ToggleButton
                                x:Name="CustomizeToggle"
                                MinWidth="96"
                                Click="OnCustomizeToggleClick">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource MpvSpaceS}">
                                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                    <TextBlock x:Name="CustomizeToggleText" />
                                </StackPanel>
                            </ToggleButton>

                            <Border
                                Width="1"
                                Height="20"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- Resets: narrowing scope on the left, widest
                                 last, which is the order Windows settings puts a
                                 page's destructive actions in. -->
                            <Button
                                x:Name="ResetButton"
                                MinWidth="96"
                                Click="OnResetClick" />
                            <Button
                                x:Name="ResetAllButton"
                                MinWidth="96"
                                Click="OnResetAllClick" />
                        </StackPanel>

                        <!-- Customize footer: a different job, so a different
                             set of buttons. Undo/redo step through the session
                             as bare icons; apply keeps what is on screen and
                             exits. There is deliberately no "don't save" button
                             — closing asks the question, and offers discarding
                             as one of its answers. -->
                        <StackPanel
                            x:Name="CustomizeActions"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="{StaticResource MpvSpaceS}"
                            Visibility="Collapsed">
                            <Button
                                x:Name="CustomizeUndoButton"
                                MinWidth="0"
                                Padding="{StaticResource MpvCompactButtonPadding}"
                                Click="CustomizeUndo_Click">
                                <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                            </Button>
                            <Button
                                x:Name="CustomizeRedoButton"
                                MinWidth="0"
                                Padding="{StaticResource MpvCompactButtonPadding}"
                                Click="CustomizeRedo_Click">
                                <FontIcon FontSize="14" Glyph="&#xE7A6;" />
                            </Button>
                            <Button
                                x:Name="CustomizeApplyButton"
                                MinWidth="116"
                                Click="CustomizeApply_Click">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource MpvSpaceS}">
                                    <FontIcon FontSize="14" Glyph="&#xE73E;" />
                                    <TextBlock x:Name="CustomizeApplyButtonText" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="CustomizeExitButton"
                                MinWidth="96"
                                Click="CustomizeExit_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView.Content>
    </NavigationView>
</Page>
