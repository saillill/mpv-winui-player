<Page
    x:Class="mpv_winui.Modules.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ar="using:mpv_winui.Modules.ActivationRegistration"
    xmlns:ctl="using:mpv_winui.Modules.Settings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Mirrors OptionListViewItemStyle: section cards must sit in the
             same padded content area as the option cards, not inside the
             ListView's default 12px item chrome. -->
        <Style
            x:Key="SectionCardListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </Page.Resources>

    <!--
        WinUI 3 settings shell: NavigationView (icon pane) on the left,
        search + options + reset footer in the content area. The category
        items are built in code so their labels follow AppLang on language
        switches without rebuilding the page.
    -->
    <NavigationView
        x:Name="CategoryNav"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="240"
        PaneDisplayMode="Left"
        SelectionChanged="CategoryNav_SelectionChanged">
        <NavigationView.Resources>
            <!-- One surface for pane and content: no inner grey layers, the
                 window background shows through on both sides. -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        </NavigationView.Resources>
        <NavigationView.Content>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Windows-Settings-style sub-page breadcrumb: back chevron +
                     "category > section", shown on every option page (built
                     in UpdateOptions). The search box lives in the window's
                     top bar, outside this page. -->
                <Grid
                    x:Name="BreadcrumbBar"
                    Grid.Row="0"
                    MaxWidth="1060"
                    HorizontalAlignment="Stretch"
                    Margin="12,4,12,12"
                    ColumnSpacing="10"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="BreadcrumbBackButton"
                        Grid.Column="0"
                        MinWidth="32"
                        MinHeight="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BreadcrumbBack_Click">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="&#xE72B;" />
                    </Button>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <Button
                            x:Name="BreadcrumbCategoryLink"
                            Padding="0"
                            Margin="0"
                            MinWidth="0"
                            MinHeight="0"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Click="BreadcrumbCategory_Click"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="BreadcrumbSeparator"
                            VerticalAlignment="Center"
                            FontSize="26"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="&#x203A;"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="BreadcrumbSection"
                            VerticalAlignment="Center"
                            FontSize="24"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Sub-category overview: section cards shown instead of the
                     option list when a category holds more than one section. -->
                <!-- One scrolling surface per category page: common options
                     directly on the overview, then the advanced entry cards. -->
                <Grid Grid.Row="1">
                    <!-- Browsing layout: one column of cards under the trail. -->
                    <ScrollViewer x:Name="BrowseHost" Padding="12,4,12,0">
                        <StackPanel MaxWidth="1060" HorizontalAlignment="Stretch">
                            <ctl:OptionListControl x:Name="OptionsControl" ShowHeaders="False" />
                            <ListView
                                x:Name="SectionsHost"
                                Margin="8,4,32,0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                SelectionMode="None"
                                IsItemClickEnabled="False"
                                ItemContainerStyle="{StaticResource SectionCardListViewItemStyle}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Customize layout: bookmark-manager shape — the folder
                         tree on the left, the cards of the selected folder on
                         the right. Cards are dragged from right to left to file
                         them, and folders are reordered within the tree. -->
                    <Grid x:Name="CustomizeHost" Visibility="Collapsed" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: categories (1st level) each holding their
                             folders (2nd level). -->
                        <Border
                            Grid.Column="0"
                            Margin="12,4,0,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Name="TreeTitleText"
                                    Grid.Row="0"
                                    Margin="12,10,12,6"
                                    FontSize="14"
                                    FontWeight="SemiBold" />
                                <ScrollViewer Grid.Row="1" Padding="4,0,4,8">
                                    <!-- Content template only: the TreeView
                                         generates its own containers, so the
                                         template must not be a TreeViewItem. -->
                                    <TreeView
                                        x:Name="FolderTree"
                                        AllowDrop="True"
                                        CanDragItems="True"
                                        CanReorderItems="True"
                                        DragItemsCompleted="FolderTree_DragItemsCompleted"
                                        ItemInvoked="FolderTree_ItemInvoked"
                                        SelectionMode="Single"
                                        SelectionChanged="FolderTree_SelectionChanged">
                                        <TreeView.ItemTemplate>
                                            <DataTemplate x:DataType="local:TreeViewNodeContent">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Glyph="{x:Bind Glyph}" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Text="{x:Bind Text}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </TreeView.ItemTemplate>
                                        <TreeView.ItemContainerStyle>
                                            <!-- The node carries its own flyout,
                                                 built by the page; the container
                                                 just exposes it. -->
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="ContextFlyout" Value="{Binding Edit.Menu}" />
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                    </TreeView>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Right: the cards of whatever is selected on the left. -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Name="CustomizePaneTitle"
                                Grid.Row="0"
                                Margin="4,6,32,6"
                                FontSize="16"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <ctl:OptionListControl x:Name="CustomizeOptionsControl" Grid.Row="1" ShowHeaders="False" />
                        </Grid>
                    </Grid>
                </Grid>

                <Border
                    Grid.Row="2"
                    Padding="16,10"
                    BorderThickness="0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="SaveStatusText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <!-- Inline customize mode: turns the rows above into
                             drag-reorderable, editable, deletable entries. -->
                        <ToggleButton
                            x:Name="CustomizeToggle"
                            Grid.Column="1"
                            MinWidth="96"
                            Click="OnCustomizeToggleClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                <TextBlock x:Name="CustomizeToggleText" />
                            </StackPanel>
                        </ToggleButton>
                        <Button
                            x:Name="ResetButton"
                            Grid.Column="2"
                            MinWidth="96"
                            Click="OnResetClick" />
                        <Button
                            x:Name="ResetAllButton"
                            Grid.Column="3"
                            MinWidth="96"
                            Click="OnResetAllClick" />
                    </Grid>
                </Border>
            </Grid>
        </NavigationView.Content>
    </NavigationView>
</Page>
