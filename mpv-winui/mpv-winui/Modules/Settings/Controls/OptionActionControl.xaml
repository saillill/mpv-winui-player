<local:OptionControlBase
    x:Class="mpv_winui.Modules.Settings.Controls.OptionActionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Settings.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Column="0"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock x:Name="LabelText" Style="{StaticResource MpvOptionLabelStyle}" />
            <TextBlock x:Name="DescriptionText" Style="{StaticResource MpvOptionDescriptionStyle}" />
            <TextBlock x:Name="WarningText" Style="{StaticResource MpvOptionWarningStyle}" />
        </StackPanel>
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="6">
            <Button
                x:Name="ActionButton"
                MinWidth="120"
                HorizontalAlignment="Right"
                Click="OnActionClick" />
            <TextBlock
                x:Name="StatusText"
                HorizontalAlignment="Right"
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</local:OptionControlBase>
