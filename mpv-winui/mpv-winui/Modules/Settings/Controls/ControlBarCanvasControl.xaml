<local:OptionControlBase
    x:Class="mpv_winui.Modules.Settings.Controls.ControlBarCanvasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:mpv_winui.Modules.Settings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootPanel">
        <StackPanel Spacing="8">
            <TextBlock
                x:Name="BarHint"
                FontSize="12"
                Visibility="Collapsed"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <!-- The card's bar strip, laid out in the real bar's forced zones:
                 原版 = left zone (transport + repeat/random) | right zone;
                 居中 = left zone | centered transport | right zone. Each zone
                 is a designated frame (指定框) with a rounded border; hidden
                 buttons are simply absent, so the row always compacts inside
                 its frame. Cells are cached per id and RepositionThemeTransition
                 makes hide/show/reorder slide smoothly. -->
            <Grid x:Name="BarHost">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="4"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource ControlFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel
                        x:Name="ZoneLeft"
                        Orientation="Horizontal"
                        Spacing="3"
                        VerticalAlignment="Center">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </StackPanel.Transitions>
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="1"
                    Padding="4"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource ControlFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel
                        x:Name="ZoneCenter"
                        Orientation="Horizontal"
                        Spacing="3"
                        VerticalAlignment="Center">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </StackPanel.Transitions>
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="2"
                    Padding="4"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource ControlFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel
                        x:Name="ZoneRight"
                        Orientation="Horizontal"
                        Spacing="3"
                        VerticalAlignment="Center">
                        <StackPanel.Transitions>
                            <TransitionCollection>
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </StackPanel.Transitions>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Candidate drawer (only visible when editing): one card per
                 remaining hidden button (icon + localized label below, "+" in
                 the top-right corner to add it straight to the bar). -->
            <TextBlock
                x:Name="AvailableCaption"
                FontSize="12"
                Visibility="Collapsed"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel
                x:Name="AvailableBar"
                Orientation="Horizontal"
                Spacing="4"
                Visibility="Collapsed" />
        </StackPanel>

        <!-- Floating drag ghost overlay (StackPanel ignores Canvas positions). -->
        <Canvas
            x:Name="GhostOverlay"
            IsHitTestVisible="False" />
    </Grid>
</local:OptionControlBase>
