<local:OptionControlBase
    x:Class="mpv_winui.Modules.Settings.Controls.OptionStringControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Settings.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        VerticalAlignment="Center"
        Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InputColumn" Width="260" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Column="0"
            VerticalAlignment="Center"
            Spacing="2">
            <TextBlock
                x:Name="LabelText"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="DescriptionText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemErrorTextColor}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="WarningText"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
        <Grid Grid.Column="1" VerticalAlignment="Center">
            <TextBox
                x:Name="InputBox"
                Width="260"
                MaxWidth="260"
                HorizontalAlignment="Left"
                LostFocus="OnLostFocus"
                KeyDown="OnKeyDown"
                TextChanged="InputBox_TextChanged" />
            <Button
                x:Name="DisplayButton"
                Width="260"
                MaxWidth="260"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Left"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Click="OnDisplayClick" />
        </Grid>
        <StackPanel
            Grid.Column="2"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="ResetButton"
                MinWidth="64"
                VerticalAlignment="Center"
                Click="OnResetBindingClick"
                Content="Reset"
                Visibility="Collapsed" />
            <Button
                x:Name="OpenButton"
                MinWidth="96"
                VerticalAlignment="Center"
                Click="OnOpenFolderClick"
                Content="Open"
                Visibility="Collapsed" />
            <Button
                x:Name="BrowseButton"
                MinWidth="96"
                VerticalAlignment="Center"
                Click="OnBrowseClick"
                Content="Browse..."
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</local:OptionControlBase>
