<UserControl
    x:Class="mpv_winui.Modules.Settings.Controls.OptionListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:mpv_winui.Modules.Settings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="BooleanTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ctl:OptionBooleanControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ctl:OptionStringControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="IntegerTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ctl:OptionIntegerControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DoubleTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ctl:OptionDoubleControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TextListTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ctl:OptionStringListControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ColorTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ctl:OptionColorControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ActionTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ctl:OptionActionControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CheckListTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ctl:OptionCheckListControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LayoutTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ctl:OptionLayoutControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MultiListTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ctl:OptionMultiListControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ShaderListTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <ctl:OptionShaderListControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SectionHeaderTemplate" x:DataType="ctl:SectionHeaderItem">
            <TextBlock
                Margin="4,16,4,8"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="{x:Bind Caption}" />
        </DataTemplate>

        <!-- Customize mode's 2nd-level row: a section (column) the user can
             move or hide as a unit, exactly like a sidebar category. -->
        <DataTemplate x:Key="CustomizeSectionTemplate" x:DataType="ctl:SectionHeaderItem">
            <Border
                Margin="0,12,0,8"
                Padding="12,8,12,8"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8A5;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{x:Bind Caption}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind Edit.DeleteAutomationName}"
                        ToolTipService.ToolTip="{x:Bind Edit.SectionTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="SectionMoveUp_Click" Text="{x:Bind Edit.MoveUpCaption}" />
                                <MenuFlyoutItem Click="SectionMoveDown_Click" Text="{x:Bind Edit.MoveDownCaption}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="SectionHide_Click" Text="{x:Bind Edit.HideSectionCaption}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Inline customize mode row: drag to reorder and edit the raw mpv
             key/value, or delete the row (hide it, or restore it to its
             default). Label/description stay read-only: they are localized. -->
        <DataTemplate x:Key="CustomizeTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="12,12,12,12"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE76F;" />

                    <StackPanel Grid.Column="1" Spacing="6">
                        <!-- Label/description are read-only: they come from the
                             language files. There is deliberately no key/value
                             editor here either — this mode only rearranges the
                             page, it does not retarget options. -->
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{x:Bind Label}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind Key}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Bind Edit.DeleteAutomationName}"
                        ToolTipService.ToolTip="{x:Bind Edit.DeleteTooltip}">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="HideRow_Click" Text="{x:Bind Edit.HideCaption}" />
                                <MenuFlyoutItem Click="ResetRow_Click" Text="{x:Bind Edit.ResetCaption}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <ctl:OptionTemplateSelector
            x:Key="TemplateSelector"
            ActionTemplate="{StaticResource ActionTemplate}"
            BooleanTemplate="{StaticResource BooleanTemplate}"
            CheckListTemplate="{StaticResource CheckListTemplate}"
            ColorTemplate="{StaticResource ColorTemplate}"
            CustomizeOptionTemplate="{StaticResource CustomizeTemplate}"
            CustomizeSectionTemplate="{StaticResource CustomizeSectionTemplate}"
            DoubleTemplate="{StaticResource DoubleTemplate}"
            IntegerTemplate="{StaticResource IntegerTemplate}"
            LayoutTemplate="{StaticResource LayoutTemplate}"
            MultiListTemplate="{StaticResource MultiListTemplate}"
            SectionHeaderTemplate="{StaticResource SectionHeaderTemplate}"
            ShaderListTemplate="{StaticResource ShaderListTemplate}"
            TextListTemplate="{StaticResource TextListTemplate}"
            TextTemplate="{StaticResource TextTemplate}" />

        <Style
            x:Key="OptionListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <ListView
            x:Name="OptionListView"
            Grid.Row="1"
            Padding="8,0,32,0"
            DragItemsCompleted="OptionListView_DragItemsCompleted"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource OptionListViewItemStyle}"
            ItemTemplateSelector="{StaticResource TemplateSelector}"
            SelectionMode="None" />
    </Grid>
</UserControl>
