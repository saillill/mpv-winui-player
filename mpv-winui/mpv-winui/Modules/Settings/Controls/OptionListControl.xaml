<UserControl
    x:Class="mpv_winui.Modules.Settings.Controls.OptionListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:mpv_winui.Modules.Settings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="BooleanTemplate">
            <ctl:OptionBooleanControl
                Margin="0,0,0,2"
                VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate">
            <ctl:OptionStringControl
                Margin="0,0,0,2"
                VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="IntegerTemplate">
            <ctl:OptionIntegerControl
                Margin="0,0,0,2"
                VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="DoubleTemplate">
            <ctl:OptionDoubleControl
                Margin="0,0,0,2"
                VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="TextListTemplate">
            <ctl:OptionStringListControl
                Margin="0,0,0,2"
                VerticalAlignment="Center" />
        </DataTemplate>

        <DataTemplate x:Key="SectionHeaderTemplate" x:DataType="ctl:SectionHeaderItem">
            <Grid Margin="4,12,4,8">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Caption}" />
                    <Border
                        Height="1"
                        Margin="0,8,0,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <ctl:OptionTemplateSelector
            x:Key="TemplateSelector"
            BooleanTemplate="{StaticResource BooleanTemplate}"
            DoubleTemplate="{StaticResource DoubleTemplate}"
            IntegerTemplate="{StaticResource IntegerTemplate}"
            SectionHeaderTemplate="{StaticResource SectionHeaderTemplate}"
            TextListTemplate="{StaticResource TextListTemplate}"
            TextTemplate="{StaticResource TextTemplate}" />

        <Style
            x:Key="OptionListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style
            x:Key="SectionHeaderItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ListView
            x:Name="OptionListView"
            Grid.Row="1"
            Padding="8,0,8,0"
            ContainerContentChanging="OnContainerContentChanging"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource OptionListViewItemStyle}"
            ItemTemplateSelector="{StaticResource TemplateSelector}"
            SelectionMode="None" />
    </Grid>
</UserControl>
