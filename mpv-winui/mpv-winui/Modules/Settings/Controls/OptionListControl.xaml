<UserControl
    x:Class="mpv_winui.Modules.Settings.Controls.OptionListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:mpv_winui.Modules.Settings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="BooleanTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="{x:Bind Icon}"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="16"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ctl:OptionBooleanControl
                        Grid.Column="1"
                        Setting="{x:Bind}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="{x:Bind Icon}"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="16"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ctl:OptionStringControl
                        Grid.Column="1"
                        Setting="{x:Bind}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

