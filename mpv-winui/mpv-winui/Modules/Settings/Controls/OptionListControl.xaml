                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="{x:Bind Icon}"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="16"
