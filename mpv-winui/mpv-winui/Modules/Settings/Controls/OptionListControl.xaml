<UserControl
    x:Class="mpv_winui.Modules.Settings.Controls.OptionListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:mpv_winui.Modules.Settings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- One card shell for every option row. Eleven templates used to
             restate this same nine-line Border around a different control, so
             a change to the row's radius, padding or background meant eleven
             edits and any missed one was an invisible inconsistency. The shell
             now lives here once; each template says which control it hosts by
             setting the hosted control as its content. -->
        <Style x:Key="OptionCardStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Margin" Value="{StaticResource MpvOptionRowMargin}" />
            <Setter Property="Padding" Value="{StaticResource MpvCardPadding}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <DataTemplate x:Key="BooleanTemplate" x:DataType="ctl:Option">
            <Border Style="{StaticResource OptionCardStyle}">
                <ctl:OptionBooleanControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate" x:DataType="ctl:Option">
            <Border Style="{StaticResource OptionCardStyle}">
                <ctl:OptionStringControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="IntegerTemplate" x:DataType="ctl:Option">
            <Border Style="{StaticResource OptionCardStyle}">
                <ctl:OptionIntegerControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DoubleTemplate" x:DataType="ctl:Option">
            <Border Style="{StaticResource OptionCardStyle}">
                <ctl:OptionDoubleControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TextListTemplate" x:DataType="ctl:Option">
            <Border Style="{StaticResource OptionCardStyle}">
                <ctl:OptionStringListControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ColorTemplate" x:DataType="ctl:Option">
            <Border Style="{StaticResource OptionCardStyle}">
                <ctl:OptionColorControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ActionTemplate" x:DataType="ctl:Option">
            <Border Style="{StaticResource OptionCardStyle}">
                <ctl:OptionActionControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CheckListTemplate" x:DataType="ctl:Option">
            <Border Style="{StaticResource OptionCardStyle}">
                <ctl:OptionCheckListControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LayoutTemplate" x:DataType="ctl:Option">
            <Border Style="{StaticResource OptionCardStyle}">
                <ctl:OptionLayoutControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MultiListTemplate" x:DataType="ctl:Option">
            <Border Style="{StaticResource OptionCardStyle}">
                <ctl:OptionMultiListControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ShaderListTemplate" x:DataType="ctl:Option">
            <Border Style="{StaticResource OptionCardStyle}">
                <ctl:OptionShaderListControl
                    Setting="{x:Bind}"
                    VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SectionHeaderTemplate" x:DataType="ctl:SectionHeaderItem">
            <!-- Size, weight and margin come from MpvSectionHeaderStyle, which
                 derives from Body Strong; the ramp step was previously
                 restated here as a literal 16px (not a step on the ramp). -->
            <TextBlock
                Style="{StaticResource MpvSectionHeaderStyle}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="{x:Bind Caption}" />
        </DataTemplate>

        <!-- Customize mode's 2nd-level row: a section (column) the user can
             move or hide as a unit, exactly like a sidebar category. -->
        <DataTemplate x:Key="CustomizeSectionTemplate" x:DataType="ctl:SectionHeaderItem">
            <Border
                x:Name="SectionDragSurface"
                Margin="{StaticResource MpvOptionRowMarginXl}"
                Padding="12,8,12,8"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid ColumnSpacing="{StaticResource MpvSpaceM}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8A5;" />
                    <!-- Same element as SectionHeaderTemplate above (a section
                         caption), so it takes the same style rather than
                         restating its own size and weight. -->
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource MpvSectionHeaderStyle}"
                        Margin="0"
                        Text="{x:Bind Caption}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind Edit.MoreAutomationName}"
                        ToolTipService.ToolTip="{x:Bind Edit.SectionMoreTip}">
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="RenameSection_Click" Text="{x:Bind Edit.RenameCaption}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="SectionMoveUp_Click" Text="{x:Bind Edit.MoveUpCaption}" />
                                <MenuFlyoutItem Click="SectionMoveDown_Click" Text="{x:Bind Edit.MoveDownCaption}" />
                                <MenuFlyoutSeparator />
                                <!-- One slot for both directions: the caption
                                     comes from the folder's state, so a hidden
                                     folder offers a way back instead of
                                     offering to hide itself again. -->
                                <MenuFlyoutItem Click="SectionHide_Click" Text="{x:Bind HideToggleCaption}" />
                                <!-- Only a folder the user made can be deleted;
                                     IsCustom gates it so no built-in section is
                                     ever offered a destructive action. -->
                                <MenuFlyoutItem
                                    Click="SectionDelete_Click"
                                    Text="{x:Bind Edit.DeleteSectionCaption}"
                                    Visibility="{x:Bind DeleteVisibility}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A bare separator card between the folder's own members and the
             cards that live outside every folder, so the two groups read as
             different things instead of one long run. -->
        <DataTemplate x:Key="CustomizeSplitterTemplate" x:DataType="ctl:SectionHeaderItem">
            <Grid Margin="{StaticResource MpvSplitterMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind Caption}" />
            </Grid>
        </DataTemplate>

        <!-- Inline customize mode row: drag to reorder, drag onto a folder to
             move it there, or hide it. A hidden row keeps its normal opacity
             until the "show hidden" switch is on, at which point it comes back
             faded so it reads as set aside rather than present. -->
        <DataTemplate x:Key="CustomizeTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="{StaticResource MpvOptionRowMargin}"
                Padding="12,12,12,12"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ContextFlyout="{x:Bind Edit.RowMenu}"
                CornerRadius="4"
                Opacity="{x:Bind CardOpacity, Mode=OneWay}">
                <Grid ColumnSpacing="{StaticResource MpvSpaceM}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Double-bar drag handle: the row's own affordance for
                         "this can be dragged". -->
                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        Margin="0,2,0,0"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE76F;"
                        ToolTipService.ToolTip="{x:Bind Edit.DragHandleTip}" />

                    <StackPanel Grid.Column="1" Spacing="{StaticResource MpvSpaceCompact}">
                        <!-- Label/description are the built-in localized text
                             (or the user's own override); editing them opens
                             the rename dialog, which stores an override instead
                             of touching the language files. -->
                        <StackPanel Spacing="{StaticResource MpvSpaceXxs}">
                            <TextBlock
                                Style="{StaticResource BodyTextBlockStyle}"
                                FontWeight="SemiBold"
                                Text="{x:Bind Label}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- The setting's own key, shown only in customize mode
                             as the diagnostic under the card's real name. It
                             used to be set to 11px, below the 12px regular
                             floor the type guidance cites for legible UI text;
                             Caption is 12/16. -->
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind Key}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- The inline pencil is the rename gesture: the row's
                         name is the one thing about a card the user owns.
                         Everything else sits behind the ⋯ menu. -->
                    <Button
                        Grid.Column="2"
                        MinWidth="0"
                        Padding="{StaticResource MpvCompactButtonPadding}"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        AutomationProperties.Name="{x:Bind Edit.RenameCaption}"
                        Click="EditRowInline_Click"
                        ToolTipService.ToolTip="{x:Bind Edit.EditTip}">
                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                    </Button>

                    <Button
                        Grid.Column="3"
                        MinWidth="0"
                        Padding="{StaticResource MpvCompactButtonPadding}"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Bind Edit.MoreAutomationName}"
                        ToolTipService.ToolTip="{x:Bind Edit.MoreTip}">
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <!-- Customizing a row means re-labelling it, hiding
                                 it, or moving it. Nothing here creates or
                                 retypes an mpv key: the set of rows belongs to
                                 the app, only their presentation is the user's.

                                 Text-only, matching the card's right-click
                                 menu: one row offering two menus that look
                                 different reads as two different menus. -->
                            <MenuFlyout>
                                <MenuFlyoutItem Click="RenameRow_Click" Text="{x:Bind Edit.RenameCaption}" />
                                <MenuFlyoutSeparator />
                                <!-- One slot for both directions: the caption
                                     comes from the row's state, so a hidden row
                                     offers a way back instead of offering to
                                     hide itself again. -->
                                <MenuFlyoutItem Click="ToggleRowHidden_Click" Text="{x:Bind Edit.HideToggleCaption, Mode=OneWay}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <ctl:OptionTemplateSelector
            x:Key="TemplateSelector"
            ActionTemplate="{StaticResource ActionTemplate}"
            BooleanTemplate="{StaticResource BooleanTemplate}"
            CheckListTemplate="{StaticResource CheckListTemplate}"
            ColorTemplate="{StaticResource ColorTemplate}"
            CustomizeOptionTemplate="{StaticResource CustomizeTemplate}"
            CustomizeSectionTemplate="{StaticResource CustomizeSectionTemplate}"
            CustomizeSplitterTemplate="{StaticResource CustomizeSplitterTemplate}"
            DoubleTemplate="{StaticResource DoubleTemplate}"
            IntegerTemplate="{StaticResource IntegerTemplate}"
            LayoutTemplate="{StaticResource LayoutTemplate}"
            MultiListTemplate="{StaticResource MultiListTemplate}"
            SectionHeaderTemplate="{StaticResource SectionHeaderTemplate}"
            ShaderListTemplate="{StaticResource ShaderListTemplate}"
            TextListTemplate="{StaticResource TextListTemplate}"
            TextTemplate="{StaticResource TextTemplate}" />

        <Style
            x:Key="OptionListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Customize-mode-only toolbar. The pane's own caption sits on the
             left; the right side carries the two structural gestures plus the
             switch that makes hidden rows reachable again.

             The two create buttons are NOT the same thing:
               * 分栏 is a grouping bar that lives only in this card pane — it
                 never becomes a sidebar node, so a user who merely wants to
                 stack cards up does not grow the tree.
               * 二级菜单 is a real 2nd-level folder: it appears here AND as a
                 child node of the category in the sidebar.
             Creating a new option from an mpv key is deliberately NOT offered:
             the customize surface manages the layout of the rows that exist
             (rename, hide, reorder), not the set of rows. -->
        <Grid
            x:Name="CustomizeBar"
            Grid.Row="0"
            MinHeight="40"
            Margin="8,4,32,4"
            ColumnSpacing="{StaticResource MpvSpaceS}"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="PaneTitleText"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" />

            <ToggleButton
                x:Name="ShowHiddenToggle"
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="ShowHiddenToggle_Click">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource MpvSpaceS}">
                    <FontIcon FontSize="14" Glyph="&#xE7B3;" />
                    <TextBlock x:Name="ShowHiddenToggleText" />
                </StackPanel>
            </ToggleButton>

            <Button
                x:Name="NewColumnButton"
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="CreateColumn_Click">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource MpvSpaceS}">
                    <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                    <TextBlock x:Name="NewColumnButtonText" />
                </StackPanel>
            </Button>

            <Button
                x:Name="NewSectionButton"
                Grid.Column="3"
                VerticalAlignment="Center"
                Click="CreateSection_Click">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource MpvSpaceS}">
                    <FontIcon FontSize="14" Glyph="&#xE8F4;" />
                    <TextBlock x:Name="NewSectionButtonText" />
                </StackPanel>
            </Button>
        </Grid>

        <ListView
            x:Name="OptionListView"
            Grid.Row="1"
            Padding="8,0,32,0"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="True"
            DragItemsCompleted="OptionListView_DragItemsCompleted"
            DragItemsStarting="OptionListView_DragItemsStarting"
            DragOver="OptionListView_DragOver"
            Drop="OptionListView_Drop"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource OptionListViewItemStyle}"
            ItemTemplateSelector="{StaticResource TemplateSelector}"
            SelectionMode="None" />
    </Grid>
</UserControl>
