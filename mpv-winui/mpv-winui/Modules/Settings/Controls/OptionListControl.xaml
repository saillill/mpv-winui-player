                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ctl:OptionMultiListControl
                        Grid.Column="1"
                        Setting="{x:Bind}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ShaderListTemplate" x:DataType="ctl:Option">
            <Border
                MinHeight="72"
                Margin="0,0,0,8"
                Padding="16,16,16,16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Glyph="{x:Bind Icon}"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="16"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ctl:OptionShaderListControl
                        Grid.Column="1"
                        Setting="{x:Bind}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SectionHeaderTemplate" x:DataType="ctl:SectionHeaderItem">
            <TextBlock
                Margin="4,16,4,8"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="{x:Bind Caption}" />
        </DataTemplate>

        <ctl:OptionTemplateSelector
            x:Key="TemplateSelector"
            ActionTemplate="{StaticResource ActionTemplate}"
            BooleanTemplate="{StaticResource BooleanTemplate}"
            CheckListTemplate="{StaticResource CheckListTemplate}"
            ColorTemplate="{StaticResource ColorTemplate}"
            DoubleTemplate="{StaticResource DoubleTemplate}"
            IntegerTemplate="{StaticResource IntegerTemplate}"
            LayoutTemplate="{StaticResource LayoutTemplate}"
            MultiListTemplate="{StaticResource MultiListTemplate}"
            SectionHeaderTemplate="{StaticResource SectionHeaderTemplate}"
            ShaderListTemplate="{StaticResource ShaderListTemplate}"
            TextListTemplate="{StaticResource TextListTemplate}"
            TextTemplate="{StaticResource TextTemplate}" />

        <Style
            x:Key="OptionListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <ListView
            x:Name="OptionListView"
            Grid.Row="1"
            Padding="8,0,32,0"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource OptionListViewItemStyle}"
            ItemTemplateSelector="{StaticResource TemplateSelector}"
            SelectionMode="None" />
    </Grid>
</UserControl>
