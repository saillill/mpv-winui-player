<local:OptionControlBase
    x:Class="mpv_winui.Modules.Settings.Controls.OptionDoubleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Settings.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ws="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Column="0"
            VerticalAlignment="Center"
            Spacing="{StaticResource MpvSpaceXxs}">
            <TextBlock x:Name="LabelText" Style="{StaticResource MpvOptionLabelStyle}" />
            <TextBlock x:Name="DescriptionText" Style="{StaticResource MpvOptionDescriptionStyle}" />
            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemErrorTextColor}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Visibility="Collapsed" />
            <TextBlock x:Name="WarningText" Style="{StaticResource MpvOptionWarningStyle}" />
        </StackPanel>
        <ws:NumberBox
            x:Name="NumberBox"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            KeyDown="OnKeyDown"
            LostFocus="OnLostFocus"
            SpinButtonPlacementMode="Inline" />
    </Grid>
</local:OptionControlBase>
