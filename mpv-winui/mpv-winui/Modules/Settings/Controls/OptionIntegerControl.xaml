<local:OptionControlBase
    x:Class="mpv_winui.Modules.Settings.Controls.OptionIntegerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Settings.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ws="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid
            Grid.Row="0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="LabelText"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextBlockStyle}"
                TextWrapping="Wrap" />
            <Button
                x:Name="HelpButton"
                Grid.Column="1"
                Padding="6"
                VerticalAlignment="Center"
                AutomationProperties.Name="Help"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip=""
                Visibility="Collapsed">
                <FontIcon
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="14"
                    Glyph="&#xE946;" />
            </Button>
            <ws:NumberBox
                x:Name="NumberBox"
                Grid.Column="2"
                MinWidth="160"
                HorizontalAlignment="Right"
                LostFocus="OnLostFocus"
                SpinButtonPlacementMode="Inline"
                ValueChanged="OnValueChanged" />
        </Grid>
        <TextBlock
            x:Name="ErrorText"
            Grid.Row="1"
            Margin="0,2,0,0"
            Foreground="{ThemeResource SystemErrorTextColor}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Visibility="Collapsed" />
    </Grid>
</local:OptionControlBase>
