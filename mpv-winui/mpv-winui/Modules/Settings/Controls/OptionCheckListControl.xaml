<local:OptionControlBase
    x:Class="mpv_winui.Modules.Settings.Controls.OptionCheckListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Settings.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="CheckWrapPanel">
            <ItemsWrapGrid
                ItemHeight="36"
                ItemWidth="170"
                Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="CheckListPanel">
            <StackPanel Spacing="{StaticResource MpvSpaceXs}" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid
        VerticalAlignment="Center"
        Background="Transparent"
        Tapped="OnCardTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" ColumnSpacing="{StaticResource MpvOptionControlGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Spacing="{StaticResource MpvSpaceXxs}">
                <TextBlock x:Name="LabelText" Style="{StaticResource MpvOptionLabelStyle}" />
                <TextBlock x:Name="DescriptionText" Style="{StaticResource MpvOptionDescriptionStyle}" />
                <TextBlock x:Name="WarningText" Style="{StaticResource MpvOptionWarningStyle}" />
            </StackPanel>
            <FontIcon
                x:Name="ExpandIcon"
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Glyph="&#xE70D;" />
        </Grid>
        <Grid
            x:Name="ExpandedPanel"
            Grid.Row="1"
            Margin="0,12,0,0"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel
                x:Name="CheckItemsControl"
                Grid.Row="0"
                Spacing="{StaticResource MpvSpaceXs}" />
            <Button
                x:Name="ApplyButton"
                Grid.Row="1"
                MinWidth="88"
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                Click="OnApplyClick"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" />
            <!-- The apply result. The row had an apply button but nowhere to
                 report what applying did, so a failed registration looked
                 identical to a successful one: the old code wrote the result to
                 a shared status field that only OptionActionControl read, and
                 nothing on this control ever displayed it. -->
            <TextBlock
                x:Name="StatusText"
                Grid.Row="2"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</local:OptionControlBase>
