<UserControl
    x:Class="mpv_winui.Modules.Settings.Controls.CustomColorPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MinWidth="320"
            MaxWidth="420"
            Padding="0,4,8,4"
            Spacing="12">
        <Border
            x:Name="PreviewBox"
            Width="300"
            Height="36"
            HorizontalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4" />

        <Grid
            x:Name="ColorField"
            Width="300"
            Height="180"
            HorizontalAlignment="Center"
            Background="Transparent"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            PointerMoved="ColorField_PointerMoved"
            PointerPressed="ColorField_PointerPressed"
            PointerReleased="ColorField_PointerReleased"
            PointerExited="ColorField_PointerExited">
            <Border
                x:Name="HueBase"
                CornerRadius="3" />
            <Border CornerRadius="3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="White" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="Transparent" />
                        <GradientStop Offset="1" Color="Black" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Ellipse
                x:Name="FieldThumb"
                Width="14"
                Height="14"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="Transparent"
                Stroke="White"
                StrokeThickness="2" />
        </Grid>

        <Grid
            Width="300"
            HorizontalAlignment="Center"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind HueLabel}" />
            <Slider
                x:Name="HueSlider"
                Grid.Column="1"
                Maximum="360"
                Minimum="0"
                ValueChanged="OnSliderChanged" />
            <TextBlock
                x:Name="HueValue"
                Grid.Column="2"
                MinWidth="28"
                VerticalAlignment="Center"
                TextAlignment="Right" />
        </Grid>

        <Grid
            Width="300"
            HorizontalAlignment="Center"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind SaturationLabel}" />
            <Slider
                x:Name="SaturationSlider"
                Grid.Column="1"
                Maximum="100"
                Minimum="0"
                ValueChanged="OnSliderChanged" />
            <TextBlock
                x:Name="SaturationValue"
                Grid.Column="2"
                MinWidth="28"
                VerticalAlignment="Center"
                TextAlignment="Right" />
        </Grid>

        <Grid
            Width="300"
            HorizontalAlignment="Center"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind LightnessLabel}" />
            <Slider
                x:Name="LightnessSlider"
                Grid.Column="1"
                Maximum="100"
                Minimum="0"
                ValueChanged="OnSliderChanged" />
            <TextBlock
                x:Name="LightnessValue"
                Grid.Column="2"
                MinWidth="28"
                VerticalAlignment="Center"
                TextAlignment="Right" />
        </Grid>

        <TextBox
            x:Name="HexInput"
            Header="#RRGGBB"
            TextChanged="OnHexChanged" />

        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="96"
                Click="OnCancelClick"
                Content="{x:Bind CancelLabel}" />
            <Button
                MinWidth="96"
                Click="OnDoneClick"
                Content="{x:Bind DoneLabel}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
