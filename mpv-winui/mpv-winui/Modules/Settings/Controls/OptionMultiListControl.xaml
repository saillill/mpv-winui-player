<local:OptionControlBase
    x:Class="mpv_winui.Modules.Settings.Controls.OptionMultiListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Settings.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnSpacing="{StaticResource MpvOptionControlGap}" VerticalAlignment="Center" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Column="0"
            VerticalAlignment="Center"
            Spacing="{StaticResource MpvSpaceXxs}">
            <TextBlock x:Name="LabelText" Style="{StaticResource MpvOptionLabelStyle}" />
            <TextBlock x:Name="DescriptionText" Style="{StaticResource MpvOptionDescriptionStyle}" />
            <!-- No ErrorText: this control has no validation for any of its four
                 options (they are all free-text lists with AllowEmpty = true), so
                 an error surface here could never be reached. It used to declare
                 one anyway (copied in with the rest of the text stack), which
                 read as "validation exists and is silently failing" to anyone
                 auditing the file. Deleted rather than given a made-up rule.

                 WarningText does belong: the warning is driven by the option's
                 own dependency rules, every other row control renders it, and
                 without it a "this setting may be inactive" notice on a
                 multi-list row was simply dropped. That gap was invisible
                 because a missing element looks like nothing at all.

                 (For editors: no double hyphen goes inside an XML comment.) -->
            <TextBlock x:Name="WarningText" Style="{StaticResource MpvOptionWarningStyle}" />
        </StackPanel>
        <StackPanel
            x:Name="RowsPanel"
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="{StaticResource MpvSpaceCompact}" />
    </Grid>
</local:OptionControlBase>
