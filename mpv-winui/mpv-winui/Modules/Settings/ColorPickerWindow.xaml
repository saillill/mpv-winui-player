<Window
    x:Class="mpv_winui.Modules.Settings.ColorPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:mpv_winui.Modules.Settings.Controls">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Padding="16,8">
            <TextBlock
                x:Name="TitleText"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Custom color" />
        </Border>
        <ScrollViewer
            Grid.Row="1"
            Padding="16,0,16,16"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ctl:CustomColorPickerControl
                x:Name="Picker"
                MinWidth="380"
                HorizontalAlignment="Left" />
        </ScrollViewer>
    </Grid>
</Window>
