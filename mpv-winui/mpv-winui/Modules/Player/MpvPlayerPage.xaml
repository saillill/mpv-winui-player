<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="mpv_winui.Modules.Player.MpvPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bc="using:mpv_winui.Modules.Common.Convertor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hx="using:mpv_winui.Modules.Common.View"
    xmlns:local="using:mpv_winui.Modules.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="TopBarIconButtonStyle"
            TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <MenuFlyout x:Key="PlaylistContextMenu">
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="play"
                Text="Play">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-top"
                Text="Move to Top">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xF090;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-up"
                Text="Move Up">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70E;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-down"
                Text="Move Down">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-bottom"
                Text="Move to Bottom">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xF08E;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="remove"
                Text="Remove">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="copy-title"
                Text="Copy Title">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="copy-path"
                Text="Copy File Path">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE62F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="open-location"
                Text="Open File Location">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions>
            <RowDefinition
                x:Name="MenuRow"
                Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition
                x:Name="PlayControlRow"
                Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition
                x:Name="PlaylistColumn"
                Width="0"
                MaxWidth="420" />
        </Grid.ColumnDefinitions>
        <MenuBar
            x:Name="MainMenuBar"
            Grid.Row="0"
            Grid.ColumnSpan="1"
            HorizontalAlignment="Left" />

        <StackPanel
            x:Name="TopBarButtons"
            Grid.Row="0"
            Grid.Column="0"
            Margin="8,0,10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
            <Button
                x:Name="TopBarOntopButton"
                Click="TopBarOntop_Click"
                Style="{StaticResource TopBarIconButtonStyle}">
                <FontIcon
                    x:Name="TopBarOntopIcon"
                    FontFamily="ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    FontSize="18"
                    Glyph="&#xF602;" />
            </Button>
            <Button
                x:Name="TopBarScreenshotButton"
                Click="TopBarScreenshot_Click"
                Style="{StaticResource TopBarIconButtonStyle}">
                <FontIcon
                    FontFamily="ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    FontSize="18"
                    Glyph="&#xF255;" />
            </Button>
            <Button
                x:Name="TopBarPlaylistButton"
                Click="TopBarPlaylist_Click"
                Style="{StaticResource TopBarIconButtonStyle}">
                <FontIcon
                    FontFamily="ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                    FontSize="18"
                    Glyph="&#xE8C3;" />
            </Button>
        </StackPanel>

        <Grid
            x:Name="PlaylistContainer"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            Canvas.ZIndex="1"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <local:ResizeGrip
                x:Name="PlaylistResizeGrip"
                Grid.RowSpan="2"
                Width="6"
                HorizontalAlignment="Left"
                PointerCanceled="PlaylistResizeGrip_PointerReleased"
                PointerCaptureLost="PlaylistResizeGrip_PointerReleased"
                PointerMoved="PlaylistResizeGrip_PointerMoved"
                PointerPressed="PlaylistResizeGrip_PointerPressed"
                PointerReleased="PlaylistResizeGrip_PointerReleased" />
            <Grid
                Grid.Row="0"
                Height="44"
                Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="PlaylistFilterBox"
                    Height="30"
                    MaxWidth="220"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    TextChanged="PlaylistFilterBox_TextChanged" />
                <StackPanel
                    x:Name="PlaylistToolBar"
                    Grid.Column="1"
                    Height="44"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                <Button
                    x:Name="PlaylistOntopButton"
                    Click="TopBarOntop_Click"
                    Style="{StaticResource TopBarIconButtonStyle}"
                    ToolTipService.ToolTip="Always on top">
                    <FontIcon
                        x:Name="PlaylistOntopIcon"
                        FontFamily="ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                        FontSize="18"
                        Glyph="&#xF602;" />
                </Button>
                <Button
                    x:Name="PlaylistScreenshotButton"
                    Click="TopBarScreenshot_Click"
                    Style="{StaticResource TopBarIconButtonStyle}"
                    ToolTipService.ToolTip="Screenshot">
                    <FontIcon
                        FontFamily="ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                        FontSize="18"
                        Glyph="&#xF255;" />
                </Button>
                <Button
                    x:Name="PlaylistCloseButton"
                    Click="ClosePlaylist_Click"
                    Style="{StaticResource TopBarIconButtonStyle}"
                    ToolTipService.ToolTip="Toggle Playlist">
                    <FontIcon
                        FontFamily="ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                        FontSize="18"
                        Glyph="&#xE8C3;" />
                </Button>
                <Button
                    x:Name="PlaylistRefreshButton"
                    Click="RefreshPlaylist_Click"
                    Style="{StaticResource TopBarIconButtonStyle}"
                    ToolTipService.ToolTip="Refresh">
                    <FontIcon
                        FontFamily="ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                        FontSize="18"
                        Glyph="&#xF13E;" />
                </Button>
            </StackPanel>
            </Grid>

            <ListView
                x:Name="PlaylistView"
                Grid.Row="1"
                Padding="4,0,8,4"
                Background="Transparent"
                BorderThickness="0"
                ContextRequested="PlaylistView_ContextRequested"
                IsItemClickEnabled="True"
                ItemClick="PlaylistView_ItemClick"
                ItemsSource="{x:Bind FilteredPlaylistItems, Mode=OneWay}"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style
                        BasedOn="{StaticResource DefaultListViewItemStyle}"
                        TargetType="ListViewItem">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="16,8,8,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PlaylistItem">
                        <Grid
                            Height="28"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <FontIcon
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                FontSize="14"
                                Glyph="&#xE768;"
                                Visibility="{x:Bind IsCurrent}" />
                            <FontIcon
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Margin="0,0,4,0"
                                FontSize="14"
                                Glyph="&#xE8B2;"
                                Visibility="{x:Bind bc:BindConvertor.InvertVisibility(IsCurrent)}" />
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal">
                                <TextBlock FontSize="12">
                                    <Run Text="{x:Bind Index}" />
                                    <Run Text=". " />
                                </TextBlock>
                                <hx:HighlightTextBlock
                                    FontSize="12"
                                    Query="{x:Bind Query}"
                                    Text="{x:Bind Title}"
                                    ToolTipService.ToolTip="{x:Bind Title}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="10"
                                Opacity="0.8"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Filename}">
                                <Run Text="{x:Bind Filename}" />
                                <Run Text="   " />
                                <Run Text="{x:Bind DurationText}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid
            Grid.Row="1"
            Grid.Column="0"
            AllowDrop="True"
            Background="#22000000"
            DragEnter="OnDragEnter"
            DragOver="OnDragOver"
            Drop="OnDrop"
            PointerMoved="VideoArea_PointerMoved"
            PointerWheelChanged="VideoArea_PointerWheelChanged">
            <SwapChainPanel
                x:Name="PlayerView"
                ContextRequested="PlayerView_ContextRequested"
                DoubleTapped="PlayerView_DoubleTapped"
                Tapped="PlayerView_Tapped">
                <Border Background="Transparent" />
            </SwapChainPanel>
            <Border
                x:Name="PreviewCard"
                AutomationProperties.Name="Video preview"
                AutomationProperties.AutomationId="PreviewCard"
                Padding="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <Image
                    x:Name="PreviewImage"
                    Width="240"
                    Height="135"
                    Stretch="Fill" />
            </Border>
        </Grid>

        <local:PlayerControl
            x:Name="PlayerControl"
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Stretch"
            FullWindowButtonVisibility="Visible"
            NextTrackButtonVisibility="Visible"
            OnFullScreenRequest="PlayerControl_OnFullScreenRequest"
            OnFullWindowRequest="PlayerControl_OnFullWindowRequest"
            PreviousTrackButtonVisibility="Visible" />
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="HidePlaylist">
                    <VisualState.Setters>
                        <Setter Target="TopBarButtons.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ShowPlaylist">
                    <VisualState.Setters>
                        <Setter Target="PlaylistContainer.Visibility" Value="Visible" />
                        <Setter Target="TopBarButtons.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup>
                <VisualState x:Name="NormalWindow">
                    <VisualState.Setters />
                </VisualState>
                <VisualState x:Name="FullWindow">
                    <VisualState.Setters>
                        <Setter Target="PlayControlRow.Height" Value="0" />
                        <Setter Target="MenuRow.Height" Value="0" />
                        <Setter Target="PlayerControl.(Grid.Row)" Value="1" />
                        <Setter Target="PlaylistToolBar.HorizontalAlignment" Value="Left" />
                        <Setter Target="PlaylistToolBar.Margin" Value="4,-6,8,0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
