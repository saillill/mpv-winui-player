<Window
    x:Class="mpv_winui.Modules.Player.PiPWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Black">
        <SwapChainPanel
            x:Name="PiPView"
            Tapped="PiPView_Tapped" />

        <!-- Top-left: return to the main player window. -->
        <Button
            x:Name="PiPBackButton"
            Width="34"
            Height="34"
            Margin="8,8,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#66000000"
            BorderThickness="0"
            Click="PiPBackButton_Click">
            <FontIcon
                FontSize="14"
                Glyph="&#xE72B;" />
        </Button>

        <!-- Top-right: exit picture-in-picture and restore the main window. -->
        <Button
            x:Name="PiPExitButton"
            Width="34"
            Height="34"
            Margin="0,8,8,0"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="#66000000"
            BorderThickness="0"
            Click="PiPExitButton_Click">
            <FontIcon
                FontSize="14"
                Glyph="&#xE711;" />
        </Button>

        <!--
            Bottom control bar in the same style as the fullscreen control
            bar: progress on top, transport and volume below. It auto-hides
            while idle and reappears on pointer movement.
        -->
        <Border
            x:Name="ControlsPanel"
            Padding="8,6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="#B3000000"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="4">
                <ProgressBar
                    x:Name="PiPProgressBar"
                    Height="3"
                    Background="Transparent"
                    Foreground="White"
                    IsHitTestVisible="False"
                    Maximum="1" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="PiPVolumeButton"
                        Width="40"
                        Height="40"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="PiPVolumeButton_Click">
                        <FontIcon
                            x:Name="PiPVolumeSymbol"
                            FontSize="16"
                            Glyph="&#xE995;" />
                    </Button>
                    <Button
                        x:Name="PiPBackwardButton"
                        Width="52"
                        Height="40"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="PiPBackwardButton_Click">
                        <StackPanel Spacing="0">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE627;" />
                            <TextBlock
                                FontSize="9"
                                HorizontalAlignment="Center"
                                Text="10" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PiPPlayPauseButton"
                        Width="40"
                        Height="40"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="PiPPlayPauseButton_Click">
                        <FontIcon
                            x:Name="PiPPlayPauseSymbol"
                            FontSize="18"
                            Glyph="&#xF5B0;" />
                    </Button>
                    <Button
                        x:Name="PiPForwardButton"
                        Width="52"
                        Height="40"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="PiPForwardButton_Click">
                        <StackPanel Spacing="0">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE628;" />
                            <TextBlock
                                FontSize="9"
                                HorizontalAlignment="Center"
                                Text="10" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Drag handle across the top of the window. -->
        <Border
            x:Name="DragArea"
            Height="40"
            VerticalAlignment="Top"
            Background="Transparent"
            IsHitTestVisible="True" />
    </Grid>
</Window>
