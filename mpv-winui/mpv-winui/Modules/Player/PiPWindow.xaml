<Window
    x:Class="mpv_winui.Modules.Player.PiPWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:mpv_winui.Modules.Player">

    <Grid x:Name="RootGrid" Background="Black">
        <Grid.Resources>
            <Style
                x:Key="PiPTopButtonStyle"
                TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#66000000" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </Grid.Resources>

        <local:PiPCursorSurface
            x:Name="PiPView"
            DoubleTapped="PiPView_DoubleTapped"
            PointerCaptureLost="PiPView_PointerCaptureLost"
            PointerMoved="PiPView_PointerMoved"
            PointerPressed="PiPView_PointerPressed"
            PointerReleased="PiPView_PointerReleased"
            PointerWheelChanged="PiPView_PointerWheelChanged" />

        <!-- Top-left: return to the main player window. -->
        <Button
            x:Name="PiPBackButton"
            Margin="8,8,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource PiPTopButtonStyle}"
            Click="PiPBackButton_Click">
            <FontIcon
                FontFamily="ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                FontSize="18"
                Glyph="&#xE981;" />
        </Button>

        <!-- Top-right: exit picture-in-picture and restore the main window. -->
        <Button
            x:Name="PiPExitButton"
            Margin="0,8,8,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Style="{StaticResource PiPTopButtonStyle}"
            Click="PiPExitButton_Click">
            <FontIcon
                FontSize="14"
                Glyph="&#xE711;" />
        </Button>

        <!-- Top-right (left of exit): quick settings — window opacity and subtitles. -->
        <Button
            x:Name="PiPSettingsButton"
            Margin="0,8,50,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Style="{StaticResource PiPTopButtonStyle}">
            <FontIcon
                FontFamily="ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                FontSize="16"
                Glyph="&#xE713;" />
            <Button.Flyout>
                <Flyout
                    x:Name="PiPSettingsFlyout"
                    Placement="Bottom">
                    <StackPanel
                        Width="280"
                        Spacing="10">
                        <TextBlock
                            x:Name="PiPOpacityLabel"
                            FontWeight="SemiBold"
                            Text="Window opacity" />
                        <Slider
                            x:Name="PiPOpacitySlider"
                            Minimum="0.2"
                            Maximum="1"
                            StepFrequency="0.05"
                            Value="1"
                            ValueChanged="PiPOpacitySlider_ValueChanged" />
                        <ToggleButton
                            x:Name="PiPSubtitleToggle"
                            Click="PiPSubtitleToggle_Click"
                            Content="Subtitles" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!--
            The fullscreen control bar, in centered (居中) compact mode:
            volume on the left, skip back / play / skip forward centered,
            progress slider and time labels included. Everything else is
            hidden.
        -->
        <local:PlayerControl
            x:Name="PiPControls"
            VerticalAlignment="Bottom" />
    </Grid>
</Window>
