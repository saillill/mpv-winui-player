<Window
    x:Class="mpv_winui.Modules.Player.PiPWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:mpv_winui.Modules.Player">

    <Grid x:Name="RootGrid" Background="Black">
        <Grid.Resources>
            <Style
                x:Key="PiPTopButtonStyle"
                TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="#66000000" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </Grid.Resources>

        <local:PiPCursorSurface
            x:Name="PiPView"
            DoubleTapped="PiPView_DoubleTapped"
            PointerCaptureLost="PiPView_PointerCaptureLost"
            PointerMoved="PiPView_PointerMoved"
            PointerPressed="PiPView_PointerPressed"
            PointerReleased="PiPView_PointerReleased"
            PointerWheelChanged="PiPView_PointerWheelChanged" />

        <!-- Top-left: return to the main player window. -->
        <Button
            x:Name="PiPBackButton"
            Margin="8,8,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource PiPTopButtonStyle}"
            Click="PiPBackButton_Click">
            <FontIcon
                FontFamily="{StaticResource MpvIconFontFamily}"
                FontSize="18"
                Glyph="&#xF15C;" />
        </Button>

        <!-- Top-right: exit picture-in-picture and restore the main window. -->
        <Button
            x:Name="PiPExitButton"
            Margin="0,8,8,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Style="{StaticResource PiPTopButtonStyle}"
            Click="PiPExitButton_Click">
            <FontIcon
                FontFamily="{StaticResource MpvIconFontFamily}"
                FontSize="14"
                Glyph="&#xF36A;" />
        </Button>

        <!--
            The fullscreen control bar, in centered (居中) compact mode:
            volume on the left, skip back / play / skip forward centered,
            progress slider and time labels included. Everything else is
            hidden.
        -->
        <local:PlayerControl
            x:Name="PiPControls"
            VerticalAlignment="Bottom" />

        <!--
            Subtitle toggle for the status bar's far right. PlayerControl
            builds a fresh status-bar toggle from this source on attach (the
            XAML element itself cannot be reparented); this one stays
            collapsed as the state/icon authority.
        -->
        <ToggleButton
            x:Name="PiPSubtitleToggle"
            Click="PiPSubtitleToggle_Click"
            Visibility="Collapsed">
            <FontIcon
                FontFamily="{StaticResource MpvIconFontFamily}"
                FontSize="16"
                Glyph="&#xF2E3;" />
        </ToggleButton>
    </Grid>
</Window>
