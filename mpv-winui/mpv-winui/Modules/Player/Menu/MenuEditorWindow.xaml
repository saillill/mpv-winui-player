<Window
    x:Class="mpv_winui.Modules.Player.Menu.MenuEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:mpv_winui.Modules.Player.Menu">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16,8">
            <TextBlock
                x:Name="TitleText"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Menu Editor" />
        </Border>

        <!-- Breadcrumb navigation -->
        <StackPanel
            Grid.Row="1"
            Padding="16,0,16,4"
            Orientation="Horizontal"
            Spacing="6">
            <Button
                x:Name="UpButton"
                Click="UpButton_Click"
                Content="↑"
                ToolTipService.ToolTip="Up" />
            <TextBlock
                x:Name="PathText"
                VerticalAlignment="Center"
                Text="/"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="ItemList"
                Grid.Column="0"
                Margin="16,4"
                SelectionChanged="ItemList_SelectionChanged"
                DoubleTapped="ItemList_DoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:MenuEntryRow">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Text="{x:Bind Glyph}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind Label}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                Grid.Column="1"
                Margin="16,4,16,4"
                Spacing="8">
                <TextBlock
                    x:Name="EditTitle"
                    FontWeight="SemiBold"
                    Text="Selected item" />
                <TextBlock Text="Label key" />
                <TextBox x:Name="LabelKeyBox" />
                <TextBlock Text="Icon (Fluent glyph)" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox
                        x:Name="IconBox"
                        MinWidth="120"
                        TextChanged="IconBox_TextChanged" />
                    <Button Click="PickIcon_Click" Content="Pick…" />
                    <FontIcon
                        x:Name="IconPreview"
                        VerticalAlignment="Center"
                        FontFamily="ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                        FontSize="16" />
                </StackPanel>
                <TextBlock Text="Action" />
                <ComboBox x:Name="ActionBox" />
                <TextBlock Text="mpv command" />
                <TextBox x:Name="CommandBox" />
                <CheckBox
                    x:Name="SeparatorBox"
                    Content="Separator"
                    Checked="SeparatorBox_Changed"
                    Unchecked="SeparatorBox_Changed" />
                <TextBlock
                    x:Name="FieldHint"
                    FontSize="11"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    Text="Leaf items need an action or an mpv command." />
            </StackPanel>
        </Grid>

        <StackPanel
            Grid.Row="3"
            Margin="16,8"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="6">
            <Button Click="AddSubmenu_Click" Content="Add submenu" />
            <Button Click="AddItem_Click" Content="Add item" />
            <Button Click="AddSeparator_Click" Content="Add separator" />
            <Button Click="MoveUp_Click" Content="Move up" />
            <Button Click="MoveDown_Click" Content="Move down" />
            <Button Click="DeleteItem_Click" Content="Delete" />
            <Button Click="Reload_Click" Content="Reload" />
            <Button
                Click="Save_Click"
                Content="Save"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
