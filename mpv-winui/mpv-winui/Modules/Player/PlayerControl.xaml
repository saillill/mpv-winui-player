<UserControl
    x:Class="mpv_winui.Modules.Player.PlayerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:ycc="using:mpv_winui.Modules.Common.View.Controls"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <LinearGradientBrush
                x:Key="PiPControlGradientBrush"
                StartPoint="0,0"
                EndPoint="0,1">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="1" Color="#D9000000" />
            </LinearGradientBrush>
            <Style
                x:Key="AppBarButtonStyle"
                BasedOn="{StaticResource DefaultAppBarButtonStyle}"
                TargetType="AppBarButton">
                <Setter Property="Height" Value="40" />
                <Setter Property="Width" Value="40" />
                <Setter Property="AllowFocusOnInteraction" Value="True" />
            </Style>
            <Style
                x:Key="AppBarToggleButtonStyle"
                BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}"
                TargetType="AppBarToggleButton">
                <Setter Property="Height" Value="40" />
                <Setter Property="Width" Value="40" />
                <Setter Property="AllowFocusOnInteraction" Value="True" />
            </Style>
        </Grid.Resources>
        <Border
            x:Name="ControlPanelGradient"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="Transparent">
            <Grid
                x:Name="ControlPanelGrid"
                Padding="4,0"
                VerticalAlignment="Bottom"
                Background="Transparent"
                RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="TranslateVertical" />
                </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                x:Name="ErrorBorder"
                Grid.RowSpan="3"
                Grid.ColumnSpan="3"
                Width="320"
                HorizontalAlignment="Center"
                Canvas.ZIndex="99"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ErrorTextBlock"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="Red"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="⛔"
                    TextWrapping="WrapWholeWords" />
            </Border>
            <Grid
                x:Name="MediaTransportControls_Timeline_Grid"
                Grid.Row="1"
                Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Slider
                    x:Name="ProgressSlider"
                                        AutomationProperties.Name="Playback controls"
MinWidth="80"
                    Margin="7,2,7,1"
                    VerticalAlignment="Center"
                                        IsThumbToolTipEnabled="False" />
                <Canvas
                    x:Name="AbLoopMarksCanvas"
                    Margin="7,2,7,1"
                    IsHitTestVisible="False">
                    <Border
                        x:Name="AbLoopMarkA"
                        Width="3"
                        Height="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#FFFF8C00"
                        CornerRadius="1"
                        Visibility="Collapsed" />
                    <Border
                        x:Name="AbLoopMarkB"
                        Width="3"
                        Height="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#FF00BFFF"
                        CornerRadius="1"
                        Visibility="Collapsed" />
                </Canvas>
                <Canvas
                    x:Name="ChapterMarksCanvas"
                    Margin="7,2,7,1"
                    IsHitTestVisible="False" />
                <ProgressBar
                    x:Name="BufferingProgressBar"
                    Height="4"
                    Margin="0,2,0,0"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource SystemAccentColorLight2}"
                    IsHitTestVisible="False"
                    IsIndeterminate="True"
                    ShowPaused="True"
                    Visibility="Collapsed" />
                <Grid
                    x:Name="TimeTextGrid"
                    Grid.Row="1"
                    Height="16"
                    Margin="7,0,7,2">
                    <TextBlock
                        x:Name="TimeElapsedElement"
                        Margin="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Text="00:00" />
                    <TextBlock
                        x:Name="TimeRemainingElement"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Text="00:00" />
                </Grid>
            </Grid>
            <Grid
                x:Name="MediaControlsCommandBar"
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,3"
                HorizontalAlignment="Stretch">
                <Grid.Resources>
                    <Thickness x:Key="AppBarButtonInnerBorderMargin">5</Thickness>
                    <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,12</Thickness>
                    <x:Double x:Key="AppBarThemeCompactHeight">40</x:Double>
                    <x:Double x:Key="AppBarMoreButtonColumnMinWidth">0</x:Double>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="CompactTimeText"
                    Grid.Column="0"
                    Margin="12,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Visibility="Collapsed" />

                <CommandBar
                    x:Name="LeftCommandBar"
                    Grid.Column="0"
                    Margin="-3,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    DefaultLabelPosition="Collapsed"
                    IsDynamicOverflowEnabled="False"
                    Style="{StaticResource CommandBarWithoutRevealStyle}">
                    <CommandBar.Resources>
                        <Thickness x:Key="AppBarButtonInnerBorderMargin">5</Thickness>
                        <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,12</Thickness>
                        <x:Double x:Key="AppBarThemeCompactHeight">40</x:Double>
                        <x:Double x:Key="AppBarMoreButtonColumnMinWidth">0</x:Double>
                    </CommandBar.Resources>

                    <AppBarButton
                        x:Name="PlayPauseButton"
                                                AutomationProperties.Name="Play"
Grid.Column="1"
                                                Style="{StaticResource AppBarButtonStyle}">
                        <AppBarButton.Icon>
                            <FontIcon
                                x:Name="PlayPauseSymbol"
                                Glyph="&#xF5B0;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="PreviousTrackButton"
                                                AutomationProperties.Name="Previous Track"
Grid.Column="6"
                                                Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xF8AC;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="NextTrackButton"
                                                AutomationProperties.Name="Next Track"
Grid.Column="7"
                                                Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xF8AD;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="SkipBackwardButton"
                                                AutomationProperties.Name="Skip Backward"
Grid.Column="2"
                                                Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE627;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="SkipForwardButton"
                                                AutomationProperties.Name="Skip Forward"
Grid.Column="3"
                                                Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE628;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="ShuffleButton"
                                                                                                AutomationProperties.Name="Shuffle"
Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon
                                x:Name="ShuffleSymbol"
                                FontFamily="ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                                FontSize="20"
                                Glyph="&#xEF37;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="RepeatButton"
                                                AutomationProperties.Name="Repeat"
Grid.Column="10"
                                                Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon
                                x:Name="RepeatSymbol"
                                Glyph="&#xE8EE;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="AbLoopButton"
                                                AutomationProperties.Name="A-B loop"
Grid.Column="11"
                        Click="AbLoopButton_Click"
                                                Style="{StaticResource AppBarButtonStyle}"
                        ToolTipService.ToolTip="A-B loop"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon
                                x:Name="AbLoopSymbol"
                                Glyph="&#xE8B1;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="ControlPanelButton"
                        AutomationProperties.Name="Control panel"
                        Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE713;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <Flyout
                                x:Name="ControlPanelFlyout"
                                Placement="Top"
                                Opened="ControlPanelFlyout_Opened">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style
                                        BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                                        TargetType="FlyoutPresenter">
                                        <Setter Property="IsTabStop" Value="True" />
                                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                        <Setter Property="TabNavigation" Value="Cycle" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MaxWidth" Value="560" />
                                        <Setter Property="MaxHeight" Value="480" />
                                        <Setter Property="IsDefaultShadowEnabled" Value="True" />
                                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel
                                    x:Name="ControlPanelRoot"
                                    Padding="10"
                                    Spacing="10" />
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                </CommandBar>

                <CommandBar
                    x:Name="MiddleCommandBar"
                    Grid.Column="1"
                    Padding="0"
                    HorizontalAlignment="Center"
                    DefaultLabelPosition="Collapsed"
                    IsDynamicOverflowEnabled="False"
                    Style="{StaticResource CommandBarWithoutRevealStyle}">
                    <CommandBar.Resources>
                        <Thickness x:Key="AppBarButtonInnerBorderMargin">5</Thickness>
                        <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,12</Thickness>
                        <x:Double x:Key="AppBarThemeCompactHeight">40</x:Double>
                        <x:Double x:Key="AppBarMoreButtonColumnMinWidth">0</x:Double>
                    </CommandBar.Resources>
                </CommandBar>

                <CommandBar
                    x:Name="RightCommandBar"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    DefaultLabelPosition="Collapsed"
                    IsDynamicOverflowEnabled="False"
                    Style="{StaticResource CommandBarWithoutRevealStyle}">

                    <CommandBar.Resources>
                        <Thickness x:Key="AppBarButtonInnerBorderMargin">5</Thickness>
                        <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,12</Thickness>
                        <x:Double x:Key="AppBarThemeCompactHeight">40</x:Double>
                        <x:Double x:Key="AppBarMoreButtonColumnMinWidth">0</x:Double>
                    </CommandBar.Resources>

                    <AppBarButton
                        x:Name="VolumeMuteButton"
                                                AutomationProperties.Name="Mute"
HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                                                PointerWheelChanged="VolumeMuteButton_PointerWheelChanged"
                        Style="{StaticResource AppBarButtonStyle}">
                        <AppBarButton.Resources>
                            <Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,12</Thickness>
                            <Thickness x:Key="AppBarButtonInnerBorderMargin">5</Thickness>
                        </AppBarButton.Resources>
                        <AppBarButton.Icon>
                            <FontIcon
                                x:Name="AudioMuteSymbol"
                                Glyph="&#xE995;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarElementContainer x:Name="VolumeSliderContainer">
                        <ycc:SliderExt
                            x:Name="VolumeSlider"
                                                        AutomationProperties.Name="Volume"
Width="88"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                                                        IsThumbToolTipEnabled="False"
                            SmallChange="10"
                            Value="50" />
                    </AppBarElementContainer>

                    <AppBarButton
                        x:Name="PlaybackRateButton"
                                                AutomationProperties.Name="Playback Rate"
Grid.Column="9"
                                                Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">

                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xEC57;" />
                        </AppBarButton.Icon>

                        <AppBarButton.Flyout>
                            <MenuFlyout
                                x:Name="PlaybackRateFlyout"
                                LightDismissOverlayMode="Off"
                                Placement="Top">
                                <MenuFlyoutItem
                                    Tag="0.1"
                                    Text="0.1x" />
                                <MenuFlyoutItem
                                    Tag="0.25"
                                    Text="0.25x" />
                                <MenuFlyoutItem
                                    Tag="0.5"
                                    Text="0.5x" />
                                <MenuFlyoutItem
                                    Tag="0.75"
                                    Text="0.75x" />
                                <MenuFlyoutItem
                                    Tag="1.0"
                                    Text="1.0x" />
                                <MenuFlyoutItem
                                    Tag="1.25"
                                    Text="1.25x" />
                                <MenuFlyoutItem
                                    Tag="1.5"
                                    Text="1.5x" />
                                <MenuFlyoutItem
                                    Tag="1.75"
                                    Text="1.75x" />
                                <MenuFlyoutItem
                                    Tag="2.0"
                                    Text="2.0x" />
                                <MenuFlyoutItem
                                    Tag="4.0"
                                    Text="4.0x" />
                                <MenuFlyoutItem
                                    Tag="8.0"
                                    Text="8.0x" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    x:Name="CustomRateItem"
                                    Tag="custom"
                                    Text="Custom…" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="EqualizerButton"
                                                AutomationProperties.Name="Equalizer"
Grid.Column="12"
                                                Style="{StaticResource AppBarButtonStyle}"
                        ToolTipService.ToolTip="Equalizer"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8B1;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <Flyout
                                x:Name="EqualizerFlyout"
                                Opened="EqualizerFlyout_Opened"
                                Placement="Top">
                                <StackPanel
                                    Width="420"
                                    Spacing="6">
                                    <TextBlock
                                        x:Name="EqualizerTitle"
                                        FontWeight="SemiBold"
                                        Text="Equalizer" />
                                    <ScrollViewer
                                        MaxHeight="280"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl
                                            x:Name="EqualizerBandsPanel" />
                                    </ScrollViewer>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            x:Name="EqualizerResetButton"
                                            Click="EqualizerReset_Click"
                                            Content="Reset" />
                                        <Button
                                            x:Name="EqualizerOffButton"
                                            Click="EqualizerOff_Click"
                                            Content="Off" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="DelayButton"
                                                AutomationProperties.Name="Audio/Subtitle delay"
Grid.Column="12"
                                                Style="{StaticResource AppBarButtonStyle}"
                        ToolTipService.ToolTip="Audio / subtitle delay"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE916;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <Flyout
                                x:Name="DelayFlyout"
                                Placement="Top">
                                <StackPanel
                                    Width="360"
                                    Spacing="10">
                                    <TextBlock
                                        x:Name="DelayTitle"
                                        FontWeight="SemiBold"
                                        Text="Audio / subtitle delay" />
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="AudioDelayLabel" Text="Audio delay" />
                                        <Slider
                                            x:Name="AudioDelaySlider"
                                            Minimum="-10"
                                            Maximum="10"
                                            StepFrequency="0.1"
                                            ValueChanged="AudioDelaySlider_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="SubDelayLabel" Text="Subtitle delay" />
                                        <Slider
                                            x:Name="SubDelaySlider"
                                            Minimum="-10"
                                            Maximum="10"
                                            StepFrequency="0.1"
                                            ValueChanged="SubDelaySlider_ValueChanged" />
                                    </StackPanel>
                                    <Button
                                        x:Name="DelayResetButton"
                                        Click="DelayReset_Click"
                                        Content="Reset" />
                                </StackPanel>
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="TrackSelectionButton"
                                                AutomationProperties.Name="Tracks"
Grid.Column="13"
                                                Style="{StaticResource AppBarButtonStyle}">
                        <AppBarButton.Icon>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xED1F;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <Flyout
                                x:Name="TrackSelectionFlyout"
                                Placement="Top">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style
                                        BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
                                        TargetType="FlyoutPresenter">
                                        <Setter Property="IsTabStop" Value="True" />
                                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                        <Setter Property="TabNavigation" Value="Cycle" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MaxWidth" Value="480" />
                                        <Setter Property="MaxHeight" Value="480" />
                                        <Setter Property="IsDefaultShadowEnabled" Value="True" />
                                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                        <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <local:PlayerTrackSelectorControl x:Name="TrackSelectorControl" />
                            </Flyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="ZoomButton"
                                                AutomationProperties.Name="Zoom"
Grid.Column="15"
                                                Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Visible">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE799;" />
                        </AppBarButton.Icon>
                        <AppBarButton.Flyout>
                            <MenuFlyout
                                x:Name="ZoomSelectionFlyout"
                                LightDismissOverlayMode="Off"
                                Placement="Top">
                                <MenuFlyoutItem Text="" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>

                    <AppBarToggleButton
                        x:Name="PiPButton"
                                                AutomationProperties.Name="Picture-in-picture"
Grid.Column="16"
                                                Style="{StaticResource AppBarToggleButtonStyle}"
                        ToolTipService.ToolTip="Picture-in-picture"
                        Visibility="Visible">
                        <AppBarToggleButton.Icon>
                            <FontIcon
                                x:Name="PiPSymbol"
                                FontFamily="ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular"
                                FontSize="20"
                                Glyph="&#xE97E;" />
                        </AppBarToggleButton.Icon>
                    </AppBarToggleButton>

                    <AppBarButton
                        x:Name="FullWindowButton"
                                                AutomationProperties.Name="Full Window"
Grid.Column="18"
                                                Style="{StaticResource AppBarButtonStyle}"
                        Visibility="Collapsed">
                        <AppBarButton.Icon>
                            <FontIcon
                                x:Name="FullWindowSymbol"
                                Glyph="&#xF16B;" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <AppBarButton
                        x:Name="FullScreenButton"
                                                AutomationProperties.Name="Full Screen"
Grid.Column="18"
                                                Style="{StaticResource AppBarButtonStyle}">
                        <AppBarButton.Icon>
                            <SymbolIcon
                                x:Name="FullScreenSymbol"
                                Symbol="FullScreen" />
                        </AppBarButton.Icon>
                    </AppBarButton>


                    <CommandBar.SecondaryCommands />
                </CommandBar>
                </Grid>
            </Grid>
        </Border>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="MediaStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Buffering">
                    <VisualState.Setters>
                        <Setter Target="BufferingProgressBar.Visibility" Value="Visible" />
                        <Setter Target="BufferingProgressBar.ShowPaused" Value="False" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediaLoading">
                    <VisualState.Setters>
                        <Setter Target="BufferingProgressBar.Visibility" Value="Visible" />
                        <Setter Target="BufferingProgressBar.ShowPaused" Value="False" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimation
                            Storyboard.TargetName="ProgressSlider"
                            Storyboard.TargetProperty="Opacity"
                            To="0.8"
                            Duration="0" />
                        <DoubleAnimation
                            Storyboard.TargetName="MediaControlsCommandBar"
                            Storyboard.TargetProperty="Opacity"
                            To="0.8"
                            Duration="0" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Error">
                    <VisualState.Setters>
                        <Setter Target="ErrorBorder.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                    <Storyboard />
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="PlayPauseStates">
                <VisualState x:Name="PlayState" />
                <VisualState x:Name="PauseState">
                    <VisualState.Setters>
                        <Setter Target="PlayPauseSymbol.Glyph" Value="&#xF8AE;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="VolumeMuteStates">
                <VisualState x:Name="VolumeState" />
                <VisualState x:Name="MuteState">
                    <VisualState.Setters>
                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE74F;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VolumeState0">
                    <VisualState.Setters>
                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE992;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VolumeState1">
                    <VisualState.Setters>
                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE993;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VolumeState2">
                    <VisualState.Setters>
                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE994;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="VolumeState3">
                    <VisualState.Setters>
                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE995;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="FullScreenStates">
                <VisualState x:Name="NonFullScreenState" />
                <VisualState x:Name="FullScreenState">
                    <VisualState.Setters>
                        <Setter Target="FullScreenButton.Icon" Value="BackToWindow" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="FullWindowStates">
                <VisualState x:Name="NonFullWindowState" />
                <VisualState x:Name="FullWindowState">
                    <VisualState.Setters>
                        <Setter Target="FullWindowSymbol.Glyph" Value="&#xE745;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="RepeatStates">
                <VisualState x:Name="RepeatAllState" />
                <VisualState x:Name="RepeatNoneState">
                    <VisualState.Setters>
                        <Setter Target="RepeatSymbol.Glyph" Value="&#xF5E7;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="RepeatOneState">
                    <VisualState.Setters>
                        <Setter Target="RepeatSymbol.Glyph" Value="&#xE8ED;" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="ShuffleStates">
                <VisualState x:Name="ShuffleNoneState">
                    <VisualState.Setters>
                        <Setter Target="ShuffleSymbol.Glyph" Value="&#xEF3D;" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ShuffleState">
                    <VisualState.Setters>
