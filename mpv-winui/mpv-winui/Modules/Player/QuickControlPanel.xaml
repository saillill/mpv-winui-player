<UserControl
    x:Class="mpv_winui.Modules.Player.QuickControlPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Modules.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Quick-control equalizer bands (audit C4/A9): the panel fills
             EqualizerBands and the sliders bind TwoWay to EqualizerBand.Value. -->
        <DataTemplate x:Key="EqualizerBandTemplate" x:DataType="local:EqualizerBand">
            <StackPanel
                Width="44"
                HorizontalAlignment="Center"
                Spacing="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Text="{x:Bind ValueText, Mode=OneWay}" />
                <Slider
                    Width="36"
                    Height="180"
                    AutomationProperties.Name="{x:Bind Band}"
                    HorizontalAlignment="Center"
                    Maximum="12"
                    Minimum="-12"
                    Orientation="Vertical"
                    StepFrequency="0.5"
                    Value="{x:Bind Value, Mode=TwoWay}">
                    <Slider.Resources>
                        <x:Double x:Key="SliderTrackThemeHeight">8</x:Double>
                    </Slider.Resources>
                </Slider>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Text="{x:Bind Band}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!--
      Quick-control flyout shell (audit C4, structural step): the flyout now
      hosts a XAML user control; the per-section controls are still built by
      PlayerControl into ContentRoot so existing behavior is preserved.
    -->
    <!-- The widest page (video/subtitle full-width cards) must not resize the
         flyout when switching tabs; pin the content width to the presenter max. -->
    <Grid MinWidth="560">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="ContentRoot"
                Padding="8"
                HorizontalAlignment="Stretch"
                Spacing="8" />
        </ScrollViewer>
    </Grid>
</UserControl>
