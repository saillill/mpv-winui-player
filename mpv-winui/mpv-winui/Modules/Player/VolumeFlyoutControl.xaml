<UserControl
    x:Class="mpv_winui.Modules.Player.VolumeFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="4">
        <AppBarButton
            x:Name="MuteButton"
                        AutomationProperties.Name="Mute"
Width="40"
            HorizontalAlignment="Center"
            Click="MuteButton_Click"
                        LabelPosition="Collapsed">
            <AppBarButton.Icon>
                <FontIcon x:Name="VolumeIcon" />
            </AppBarButton.Icon>
        </AppBarButton>
        <Slider
            x:Name="VolumeSlider"
                        AutomationProperties.Name="Volume"
Height="100"
            HorizontalAlignment="Center"
                        Maximum="100"
            Minimum="0"
            Orientation="Vertical" />
    </StackPanel>
</UserControl>
