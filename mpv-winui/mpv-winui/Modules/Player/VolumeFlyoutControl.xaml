<UserControl
    x:Class="mpv_winui.Modules.Player.VolumeFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="2">
        <AppBarButton
            x:Name="MuteButton"
                        AutomationProperties.Name="Mute"
Width="32"
            Height="32"
            Padding="0"
            HorizontalAlignment="Center"
            Click="MuteButton_Click"
                        LabelPosition="Collapsed">
            <AppBarButton.Icon>
                <FontIcon
                    x:Name="VolumeIcon"
                    FontSize="14"
                    FontFamily="{StaticResource MpvIconFontFamily}" />
            </AppBarButton.Icon>
        </AppBarButton>
        <Slider
            x:Name="VolumeSlider"
                        AutomationProperties.Name="Volume"
Height="72"
            Width="28"
            HorizontalAlignment="Center"
                        Maximum="100"
            Minimum="0"
            Orientation="Vertical" />
    </StackPanel>
</UserControl>
