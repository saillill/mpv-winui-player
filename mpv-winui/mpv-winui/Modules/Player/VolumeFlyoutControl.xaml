<UserControl
    x:Class="mpv_winui.Modules.Player.VolumeFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="4">
        <AppBarButton
            x:Name="MuteButton"
            Width="36"
            Height="36"
            Padding="0"
            HorizontalAlignment="Center"
            AutomationProperties.Name="Mute"
            Click="MuteButton_Click"
            LabelPosition="Collapsed">
            <AppBarButton.Icon>
                <FontIcon
                    x:Name="VolumeIcon"
                    FontSize="14"
                    FontFamily="{StaticResource MpvIconFontFamily}" />
            </AppBarButton.Icon>
        </AppBarButton>
        <Slider
            x:Name="VolumeSlider"
            Width="32"
            Height="100"
            HorizontalAlignment="Center"
            AutomationProperties.Name="Volume"
            Maximum="100"
            Minimum="0"
            Orientation="Vertical" />
    </StackPanel>
</UserControl>
