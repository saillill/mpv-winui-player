<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush
                x:Key="MpvPlayControlBackground"
                Color="#60FFFFFF" />
            <SolidColorBrush
                x:Key="MpvControlBackground"
                Color="#D0FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush
                x:Key="MpvPlayControlBackground"
                Color="#80000000" />
            <SolidColorBrush
                x:Key="MpvControlBackground"
                Color="#B0000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Built-in Fluent icon font shared by the control bar, PiP window and
         track selector so every status-bar glyph renders from one font. -->
    <FontFamily x:Key="MpvIconFontFamily">ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>

    <!-- Shared card used by the quick-control panel and other code-built
         surfaces, so card look stays consistent instead of being re-declared
         with inline brushes/radii in each builder. -->
    <Style x:Key="MpvCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="MpvSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>

    <Style x:Key="MpvCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Shared acrylic shell for the player popups (control panel, track
         selector). Per-use Padding/MaxWidth/MaxHeight stay on the
         consuming flyout via BasedOn. -->
    <Style
        x:Key="AcrylicFlyoutPresenterStyle"
        BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
        TargetType="FlyoutPresenter">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="TabNavigation" Value="Cycle" />
        <Setter Property="IsDefaultShadowEnabled" Value="True" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
    </Style>

</ResourceDictionary>
