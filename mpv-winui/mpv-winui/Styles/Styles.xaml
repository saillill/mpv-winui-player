                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="SquareAppBarButtonStyle"
        BasedOn="{StaticResource DefaultAppBarButtonStyle}"
        TargetType="AppBarButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
    </Style>

    <Style
        x:Key="SquareIconButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="AllowFocusOnInteraction" Value="True" />
    </Style>

    <!-- Built-in Fluent icon font shared by the control bar, PiP window and
         track selector so every status-bar glyph renders from one font. -->
    <!-- The custom icon font, kept deliberately.

         The house style says icons should come from Segoe Fluent Icons. That was checked against
         the actual font file rather than against a codepoint chart: of the 25 distinct glyphs this
         app draws, **19 do not exist in the installed SegoeIcons.ttf**.

         The six that do are the ordinary transport glyphs. The nineteen that do not are the ones
         this font was added for - the playback-mode icons, the equaliser, the compact-bar set.
         Switching would render them as empty boxes, so this is a functional constraint and not a
         taste question.

         Note also that this machine has SegoeIcons.ttf (the Windows 11 filename), not
         "Segoe Fluent Icons.ttf"; a reference to the documented family name would resolve to
         nothing here.

         If a future Windows ships these codepoints, re-run the comparison before removing this
         font. The 25 sites are listed by `MpvIconFontFamily` in the player markup. -->
    <FontFamily x:Key="MpvIconFontFamily">ms-appx:///Assets/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>

    <!-- Shared card used by the quick-control panel and other code-built
         surfaces, so card look stays consistent instead of being re-declared
         with inline brushes/radii in each builder. -->
    <Style x:Key="MpvCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Section caption above a group of option cards. The Windows design
         guidance names Body Strong for section headers, so this derives from
         that ramp step (14/20 semibold) instead of restating a size: the
         previous definition here was 12px regular, which sits at the floor
         for legible UI text rather than at the style the guidance asks for,
         and nothing consumed it anyway. -->
    <Style
        x:Key="MpvSectionHeaderStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="4,16,4,8" />
    </Style>

    <!-- The three text roles of an option card: the option's name, the one-line
         description under it, and the caution line under that. Every option
         control used to restate the ramp step, the foreground, the wrapping and
         the initial visibility of each role inline: eleven copies of the label
         and description, nine of the warning, all byte-identical, which is the
         state that drifts. Both Collapsed defaults are overridden at runtime
         (local values win over style setters), so a control that has something
         to say still shows it. -->
    <Style
        x:Key="MpvOptionLabelStyle"
        BasedOn="{StaticResource BodyTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <!-- One line, matching the description below: a wrapping label makes
             the row taller and the control beside it off-centre, and the
             longer names in the generated set (a schema option name can run
             past 30 characters) would otherwise wrap at any realistic width. -->
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style
        x:Key="MpvOptionDescriptionStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <!-- NoWrap, not Wrap: with MaxLines=1 a wrapping TextBlock still
             breaks the text at the last word that fits, so the ellipsis lands
             wherever that break fell and the line ends ragged at an arbitrary
             column. NoWrap keeps the line whole and puts the ellipsis exactly
             at the column edge, which is what makes a list of one-line
             descriptions line up. -->
        <Setter Property="TextWrapping" Value="NoWrap" />
        <!-- One line, then an ellipsis.
             The row height is the thing being protected. The description sits
             in a two-column grid beside the control, so every extra line it
             wraps to pushes the row taller and drags the control off the
             vertical centre, and at two lines the list stops being scannable
             when the window is snapped, which is exactly when it matters.
             One line makes every row the same height at any width. MaxLines
             plus TextTrimming is the only combination that both stops the
             growth and shows there is more text; either alone leaves a
             silently clipped or endlessly growing line. The help text in
             Languages/*.json is the place for the rest, and it is already
             trimmed to be short enough to fit. -->
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style
        x:Key="MpvOptionWarningStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- The fourth of the text roles, and for a long time the only one without a
         token: the three controls that validate input (Double, Integer, String)
         each restated the same foreground, ramp step and initial visibility
         inline. ErrorText is the one role here that is genuinely conditional in
         BOTH directions - a control may have no error node at all (the six that
         cannot fail validation) or have one that is only filled on a failed
         commit - so the initial Collapsed is part of the role, not an accident.
         Wrap matches the warning: a validation message is a sentence, and
         clipping it would hide the part that says what to do. -->
    <Style
        x:Key="MpvOptionErrorStyle"
        BasedOn="{StaticResource CaptionTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SystemErrorTextColor}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- Spacing scale.
         Two scales, because there are genuinely two jobs. The Windows guidance
         gives 8 / 12 / 16 for spacing between surfaces, content areas and edge
         text; gaps *inside* a control (a glyph and the label beside it) are
         tighter than that and are a separate scale. Naming both is the point:
         the settings pages had accumulated hand-typed 2s, 3s, 6s, 10s and
         one-off Thickness literals, so a value that happened to look right
         became the convention for the next control. Now a spacing value is
         picked from here or it is deliberate and commented.

         A literal 0 stays a literal 0: "no spacing" is not a step on a
         scale. -->
    <x:Double x:Key="MpvSpaceXxs">2</x:Double>
    <x:Double x:Key="MpvSpaceXs">4</x:Double>
    <x:Double x:Key="MpvSpaceCompact">6</x:Double>
    <x:Double x:Key="MpvSpaceS">8</x:Double>
    <x:Double x:Key="MpvSpaceM">12</x:Double>
    <x:Double x:Key="MpvSpaceL">16</x:Double>

    <!-- The gap between an option's text block and the control that sets it.
         Deliberately its own token rather than a step on the scale above: it
         is the one gap in the list that has to read as a separation, not as
         internal spacing, and it sits between two columns that both grow.
         Most rows previously declared no ColumnSpacing at all, so the
         description ran flush into the control and the two read as one
         wrapped paragraph. 24 keeps a full M-step of air on either side of
         the boundary. -->
    <x:Double x:Key="MpvOptionControlGap">24</x:Double>

    <!-- The two repeated Thickness shapes in the settings list: the gap under
         an option row, and the padding inside a section card. -->
    <Thickness x:Key="MpvOptionRowMargin">0,0,0,8</Thickness>
    <Thickness x:Key="MpvCardPadding">16,16,16,16</Thickness>
    <!-- The remaining repeated Thickness shapes in the settings surfaces, named
         so a shape that reads the same is written the same. Every value here
         is exactly what the consuming site had inline: this batch moved
         spacing onto the scale, it did not re-tune it. The two off-scale pairs
         (a 6/2 button inset, a 16/10 footer bar) keep their numbers because
         their heights are hand-matched to controls sitting beside them, and a
         comment at each site says so. -->
    <Thickness x:Key="MpvCompactButtonPadding">8,4</Thickness>

    <!-- Action buttons: an icon plus a label, the shape used by the selection bar, the album
         header and the library toolbars.

         The vertical 6 is not arbitrary - WinUI's own ButtonPadding is 11,5,11,6, so 6 keeps these
         the same height as a stock Button with a taller-than-default label. The horizontal 16 is
         what gives an icon+label pair room to breathe; AccentButtonStyle already supplies the
         background, radius and states.

         Named rather than left as literals at the call sites so a future density change has one
         place to move. Three variants because the three contexts genuinely differ, not because the
         numbers drifted. -->
    <Thickness x:Key="MpvActionButtonPadding">16,6</Thickness>
    <Thickness x:Key="MpvActionButtonPaddingTight">12,6</Thickness>
    <Thickness x:Key="MpvSearchButtonPadding">8,6</Thickness>
    <Thickness x:Key="MpvTinyButtonPadding">6,2</Thickness>
    <!-- The footer row's insets. The horizontal half is the MARGIN, only the
         vertical half is padding, and both horizontal halves of the padding are
         zero.

         The margin/padding split is the fix for a measured defect. The
         horizontal 12 used to be padding, which puts it INSIDE the element's own
         box, while the breadcrumb and the browse row carry their 12 as a margin,
         which puts it OUTSIDE. The two shapes clamp to different boxes below the
         cap: measured at a 966-DIP content region, the breadcrumb and the cards
         arranged at x=12 with width 942 and the footer at x=0 with width 966, so
         it overhung on both sides, which is what "the cards run past the
         window" looked like.

         The trailing 12 of padding is gone. It existed to end the last button on
         the x the cards end on, which was right while the buttons belonged to
         the column; they are pinned to the window's edge now, so a trailing
         inset would only hold them 12 short of the edge the browse row's
         scrollbar sits on. Zero on both sides is what lets the row's content
         reach the row's own right edge. -->
    <Thickness x:Key="MpvFooterMargin">12,0,12,0</Thickness>
    <Thickness x:Key="MpvFooterPadding">0,10,0,10</Thickness>
    <Thickness x:Key="MpvTitleBarPadding">16,5</Thickness>
    <Thickness x:Key="MpvOptionRowMarginXl">0,12,0,8</Thickness>
    <Thickness x:Key="MpvSplitterMargin">0,16,0,4</Thickness>

    <!-- The collapsed-section card's own geometry and the icon sizes the
         settings list uses. These were registered as deliberate literals in
         OptionListControl.xaml during the stage-5 pass; they are tokens now, so
         the two card templates cannot drift apart and the numbers stop reading
         as one-off values. The values themselves are unchanged. -->
    <x:Double x:Key="MpvSectionCardMinHeight">72</x:Double>
    <!-- Only two of the values in this block cross more than one template:
         this MinHeight (the collapsed card in both SectionCardTemplate and
         CustomizeTemplate) and MpvInlineIconSize (which also reaches the
         customize bar). The rest belong to one template each -
         MpvSectionCardColumnSpacing, MpvSectionCardMargin,
         MpvSectionCardIconSize (20) and MpvSectionCardChevronSize (12) are the
         section card's own, and MpvSectionHeaderIconSize (16) is the section
         caption's icon in CustomizeSectionTemplate. So read "SectionCard" as
         the name of the family, not as a promise that every value in it is
         shared. -->
    <x:Double x:Key="MpvSectionCardColumnSpacing">18</x:Double>
    <x:Double x:Key="MpvSectionCardIconSize">20</x:Double>
    <x:Double x:Key="MpvSectionCardChevronSize">12</x:Double>
    <x:Double x:Key="MpvSectionHeaderIconSize">16</x:Double>
    <x:Double x:Key="MpvInlineIconSize">14</x:Double>
    <Thickness x:Key="MpvSectionCardMargin">0,8,0,8</Thickness>
    <!-- The content column's one horizontal inset, and the reason the detail
         area's text, cards, icons and empty state line up.

         Every surface inside the page - the heading block, the video library's
         tab strip, the card grid, the queue's toolbar and its empty state - is
         given THIS inset and nothing else of its own. Before this token the
         surfaces each carried a different one (12 for the heading, 12+12 for
         the grid through two wrappers, 8 for the queue toolbar, 0 for the empty
         state), so their left edges disagreed by up to 24 DIP and the page read
         as a stack of unrelated panels rather than as one column.

         32 rather than 12: the official player's heading sits 56 DIP inside its
         content column (measured at 175%: ink starts 98px right of the pane's
         edge), and its own empty-state block lines up with that heading rather
         than with the column's edge. 32 is that inset once the shell's own 24
         DIP of host padding is taken off - the two together are the official's
         56. -->
    <Thickness x:Key="MpvBreadcrumbBarMargin">32,8,32,16</Thickness>

    <!-- The page heading's size. 40 is measured, not chosen: the official
         player's own heading has 38.9 DIP of cap height at 175% scaling, and a
         40 DIP semibold run reproduces that exactly. It is a token rather than a
         literal in the page so the heading, the empty state's title and any
         future page-level heading cannot drift apart the way they did when each
         carried its own number. -->
    <x:Double x:Key="MpvPageHeadingFontSize">40</x:Double>
    <!-- The magnifier's own horizontal placement inside the search pill. 12 puts
         the glyph's optical left edge on the pill's 14-DIP corner curve, so the
         icon reads as inset from the pill rather than riding its rounded end.

         It used to be 14, which is also what the TextBox's left padding was
         sized against: the pair left the placeholder about 8 DIP clear of the
         glyph. The padding below now owns that gap on its own, and this token
         owns only the glyph's inset, so the two no longer have to be changed
         together. -->
    <Thickness x:Key="MpvSearchGlyphMargin">12,0,0,0</Thickness>

    <!-- The search pill's height, and half of it as the corner radius.

         The radius has to stay married to the height: the pill is only a pill
         while the radius is exactly half the box, and writing 14 beside a 28
         in two different files is how that stops being true. Half of 28 is 14,
         so the two tokens below are one number and the radius is derived from
         it rather than repeated. -->
    <x:Double x:Key="MpvSearchPillHeight">36</x:Double>
    <CornerRadius x:Key="MpvSearchPillCornerRadius">18</CornerRadius>

    <!-- The search pill's width, in DIPs.

         340 was too narrow next to the Windows 11 settings search, which gets a
         noticeably longer field. This is a token rather than a literal on the
         container because the number is coupled to MpvNarrowLayoutThreshold
         below: widening the pill moves the width at which the top bar runs out
         of room, and the two have to be changed together or the layout collapses
         at a width where it no longer needs to. -->
    <x:Double x:Key="MpvSearchPillWidth">620</x:Double>

    <!-- Width, in DIPs, below which the settings window drops to its narrow
         shape: the navigation pane animates to icon-only and the search pill
         becomes a bare magnifier button.

         One token because the two changes belong to one breakpoint but live in
         two files: the pane threshold is set on the NavigationView in
         SettingsPage.xaml, the search shape is swapped from the window's
         SizeChanged handler in SettingsWindow.xaml.cs. Duplicating the number
         is how the two ends up disagreeing about where "narrow" starts.

         It is derived from the top bar, which is what actually runs out of room:
         the title wants about 120 DIP, the pill is MpvSearchPillWidth (620), and
         the NavigationView's expanded pane is 240. Below roughly 1000 the top
         bar's centre column can no longer hold the pill without crowding the
         title.

         Raise it whenever MpvSearchPillWidth grows, and keep it above the
         window's own PreferredMinimumWidth in SettingsWindow.xaml.cs. If the two
         are equal the narrow shape is unreachable: the window cannot be dragged
         past a breakpoint it is already standing on. -->
    <x:Double x:Key="MpvNarrowLayoutThreshold">1000</x:Double>

    <!-- The reading width of the settings window's content column, and the
         media-info panel's. One token because the two surfaces sit in
         different windows and must still line up when both are open.

         Both a MaxWidth and an alignment, always together: a MaxWidth box
         with no alignment stretches to the parent and then clamps at the
         leading edge, so a wide window leaves all the slack on the right and
         the cards hug the pane gutter. Centre is what makes the clamp
         symmetric.

         Every row that shares this column must also share its horizontal
         inset, or the boxes are the same width but start at different x. The
         settings page's three rows had drifted to 12/12/16 before that was
         noticed; the footer now carries the same 12 as the other two. -->
    <x:Double x:Key="MpvContentMaxWidth">1060</x:Double>

    <!-- Transport bar metrics.

         MpvTransportIconSize is the glyph size every icon in the bar is drawn
         at, in all three layouts - the classic one in PlayerControl and the two
         alternates in CenterPlayerControlStyle and CompactPlayerControlStyle.
         One shared token is what makes "the same bar in a different
         arrangement" true: before it existed the three had each picked their
         own (24, 22, 20) and switching ControlBarLayout silently resized every
         button.

         20 is the official player's transport glyph size, measured off its own
         status bar at 175% scaling: 14.3 to 16.6 DIP of ink inside a 44 DIP
         pitch means an icon box of about 20. The previous 28 was chosen to fill
         a 62 button and only ever rendered at 16, because the AppBarButton
         template clamps Icon content to AppBarButtonContentHeight (16 by
         default) inside its own Viewbox - so the glyph was 16 wide no matter
         what this said. The clamping keys are now set per CommandBar to 20, so
         this number is what actually reaches the screen.

         MpvTransportBarHeight is the BUTTON ROW's height, not the whole bar's.

         64 is measured off the official player's own bar: the row that carries
         its transport buttons measures 110px at 175% scaling = 62.9 DIP, and it
         is the tallest band in the bar because the media thumbnail sits in it
         too. Our buttons are 44 (the official's own pitch) and centre in this
         row, which is what makes the row and the bar read as the same size as
         the official's without inventing a thumbnail we do not have.

         The bar is two rows now - the timeline row (slider and both times
         inline) and this button row - instead of the three it used to be, and
         that is the whole of the height difference that was reported: measured,
         the old bar was 125.0 DIP against the official's 116.5, and 25 DIP of
         that was the times sitting in a row of their own. -->
    <!-- The transport bar and the playing page's tool keys share these three.
         They were independent before: the bar's buttons were 44x44 with a 20px
         glyph, and the tool keys were 36x36 with an 18px glyph and no radius at
         all, so the same class of control had two sizes on one screen. -->
    <x:Double x:Key="MpvTransportButtonSize">44</x:Double>
    <x:Double x:Key="MpvTransportIconSize">20</x:Double>
    <x:Double x:Key="MpvTransportBarHeight">72</x:Double>
    <x:Double x:Key="MpvTransportTimeFontSize">12</x:Double>

    <!-- The play button's ring and the library's empty-state illustration:
         one brand gradient with two names, because each name says where it
         is spent.

         The stops are sampled from the official Media Player's own artwork -
         its transport ring and its empty-state illustrations run the same
         orange-rose-violet ramp, and following that ramp is what makes the
         two read as one product, the way the official's do. (The ring was
         built from the accent family first; the official's ring is brand
         colour, not accent colour, and the comparison came from the user's
         own screenshots.)

         The ring is a shape rather than part of the glyph so the button
         keeps its silhouette when the state changes: only the glyph inside
         the ring swaps, never the ring itself. -->
    <LinearGradientBrush
        x:Key="MpvTransportPlayRingBrush"
        StartPoint="0,0"
        EndPoint="1,1">
        <GradientStop Offset="0" Color="#D97525" />
        <GradientStop Offset="0.55" Color="#CC4C70" />
        <GradientStop Offset="1" Color="#882D8A" />
    </LinearGradientBrush>

    <StaticResource x:Key="MpvEmptyStateIconBrush" ResourceKey="MpvTransportPlayRingBrush" />

    <!-- A library card's caption, under a flush media tile. Top-aligned rather
         than padded all round: the tile above it is flush with the card, so a
         16px inset here (the card padding this replaced) would put the title on
         a different left edge from the picture. -->
    <Thickness x:Key="MpvMediaTileCaptionMargin">0,8,0,0</Thickness>

    <!-- Shell chrome geometry.

         MpvNavPaneWidth is the navigation pane's open width, and it is also
         what the window's minimum width has to budget for: a pane that opens
         into a window too narrow to hold it leaves the content area with
         nothing. It is a named token for the same reason the settings page
         drives its own pane from one - the two places that care must agree.

         320 rather than 240, measured rather than picked: the official
         player's own pane is 562px at 175% scaling = 321 DIP, and at 240 the
         pane's item labels and its search box were both visibly cramped against
         an official screenshot (the search placeholder alone wants 263 DIP of
         its own). 320 is 560px at the same scale, i.e. within one DIP.

         MpvNavPaneRailWidth is the collapsed rail's width (CompactPaneLength),
         and it doubles as the width of the title bar's back button: the
         framework centres the pane toggle and every navigation item's icon in
         the rail, so a back button exactly one rail wide centres its own arrow
         on the same axis. Two places, one number.

         48 is the official player's own rail width, measured rather than
         picked: its rail is 84-86px wide at 175% scaling (its icon centres sit
         on x=41.5px = 23.7 DIP, i.e. a 47.4 DIP rail), and 48 is also WinUI's
         own CompactPaneLength default. 64 was a third wider and left the rail
         reading as a wide gutter rather than an icon column.

         Changing this moves the axis everything in the pane is centred on
         (rail/2: 32 -> 24), so these numbers follow it and are kept here as
         tokens rather than as three separate literals:
           * MpvShellAppIconMargin is the app icon's left inset inside the title
             bar's LeftHeader. **The claim that it puts the icon's centre 20 DIP
             right of the rail's edge (48 + 20 = 68) does not hold for the current
             markup, and the value below is 10, not 20.** Measured from
             MainWindow.xaml rather than assumed: LeftHeader holds a horizontal
             StackPanel of back button (48) + pane toggle (48), then the icon, so
             the icon's left edge starts at 96; with a 10 inset and a 20-wide box
             its centre lands at 96 + 10 + 10 = 116 DIP, not 68. The
             "118px = 67.4 DIP at 175%" line describes a one-rail layout, which is
             not the shape the markup has had since the pane toggle joined the
             cluster. Corrected 2026-10-26 by reading the markup; the token value
             is unchanged, so this is a note about the number rather than a change
             to it.
           * MpvNavPaneFooterIconMargin is the pane footer's inner left inset;
             with the button's own 4 margin + 4 padding it puts the footer
             glyph's centre on rail/2 (4 + 4 + 8 + 8 = 24). Verified: this token
             supplies the 8, and the 4 + 4 come from the footer button itself
             (MainWindow.xaml:318 says so in the same terms).
         MpvShellTitleFontSize / MpvShellTitleMargin size and place the title
         that is drawn beside the app icon (see MainWindow.xaml: the icon and
         the title are one cluster in the title bar's LeftHeader, so the
         framework's own TitleBar.Title is not used).

         MpvShellAppIconSize is the app icon's box, not the artwork inside it:
         App.ico carries transparent padding, so a 20 box shows a ~17 DIP mark -
         the official's own mark measures 18.3 DIP there.

         MpvShellTabStripHeight is fixed rather than Auto on purpose. The tab
         strip is chrome, not a content host: the actual content is ShellFrame
         underneath it, so the strip must not grow with its tabs, and TabView's
         own content area collapses to nothing at a fixed height with an empty
         item template. -->
    <x:Double x:Key="MpvNavPaneWidth">320</x:Double>
    <x:Double x:Key="MpvNavPaneRailWidth">48</x:Double>
    <!-- The title row's height. The two keys in it (back, pane toggle) are
         each one rail wide and the full height of this row, so the pair reads as
         one square-ended cluster; 48 also keeps the app icon's centre on the
         official's y. -->
    <x:Double x:Key="MpvShellTitleRowHeight">48</x:Double>

    <!-- The same height in the type a RowDefinition takes; see
         MpvShellBarRowLength for why both exist. -->
    <GridLength x:Key="MpvShellTitleRowLength">48</GridLength>

    <!-- The status bar's row height, as a NUMBER rather than Auto.

         Auto made the shell's own height depend on the bar's content, so the
         window laid out once with the bar's natural height, then laid out again
         a moment later when the bar's own template had finished measuring - and
         because the window's height is what the layout is anchored to, that
         second pass moved the window's edge. That is the reported "the window
         gets a little taller the first time it opens, and it flickers".

         Fixed, the row is the same height in every frame, from the first layout
         pass on. 64 is the bar's button row (MpvTransportBarHeight) and the
         template's clip height; the bar's timeline row is 32 and its padding is
         0, so 96 is the full bar and this row reserves exactly that.

         A GridLength, not an x:Double, and that distinction cost a crash:
         RowDefinition.Height is typed GridLength, so a StaticResource pointing at
         a Double through it throws inside the XAML loader - which surfaces as
         0xc000027b / Microsoft.UI.Xaml.dll with no managed stack, the exact
         signature this repo's own notes call a stowed exception. The title row
         gets the same treatment so the two cannot be typed differently. -->
    <GridLength x:Key="MpvShellBarRowLength">104</GridLength>

    <!-- The playlist side panel: the width the official player's own panel has
         (a shade narrower than the navigation pane, since it shows a list of rows
         rather than a list of places), and the height of its header row. -->
    <x:Double x:Key="MpvPlaylistPanelWidth">320</x:Double>
    <x:Double x:Key="MpvPlaylistPanelHeaderHeight">48</x:Double>

    <!-- The pop-out panel's cap. The popup is unconstrained so it can leave the
         window, which also means nothing stops it growing past the display: a long
         playlist would produce a panel taller than the screen with no scroll
         affordance at the edges. 640 keeps it inside a 720-tall window. -->
    <x:Double x:Key="MpvPlaylistPanelMaxHeight">640</x:Double>

    <!-- Panel titles are a step down from a page heading: a panel header is
         chrome, not content. 20 is the Subtitle ramp. -->
    <x:Double x:Key="MpvPanelTitleFontSize">20</x:Double>
    <x:Double x:Key="MpvShellAppIconSize">20</x:Double>
    <Thickness x:Key="MpvShellAppIconMargin">10,0,0,0</Thickness>
    <x:Double x:Key="MpvShellTitleFontSize">16</x:Double>
    <Thickness x:Key="MpvShellTitleMargin">11,0,0,0</Thickness>
    <Thickness x:Key="MpvNavPaneFooterIconMargin">8,0,0,0</Thickness>

    <!-- The browse row's geometry, split in two.

         The MARGIN carries only the vertical gap and zero on both sides, so the
         ScrollViewer spans the whole content area and the scrollbar it draws at
         its own right edge lands ON the window's right edge. A horizontal
         margin here left the bar short of the edge, which reads as a bar
         floating in the gap rather than as the window's own scrollbar.

         The PADDING carries the reading column's inset instead, and that is
         what makes the split work: Padding insets the ScrollViewer's content
         presenter, not the bar, so the cards keep the same left edge as the
         heading above them while the bar sits outside the text column.

         It is the SAME number as MpvBreadcrumbBarMargin's horizontal inset,
         and that equality is the point: the cards' left edge and the heading's
         left edge were 12 DIP apart before (12 here against 12+12 through two
         wrappers), which is the "text, image and icon start positions are not
         unified" report. One gutter, two consumers. -->
    <Thickness x:Key="MpvBrowseHostMargin">0,4,0,0</Thickness>
    <Thickness x:Key="MpvBrowseHostPadding">32,0,32,0</Thickness>

    <!-- Shared acrylic shell for the player popups (control panel, track
         selector). Per-use Padding/MaxWidth/MaxHeight stay on the
         consuming flyout via BasedOn. -->
    <Style
        x:Key="AcrylicFlyoutPresenterStyle"
        BasedOn="{StaticResource DefaultFlyoutPresenterStyle}"
        TargetType="FlyoutPresenter">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="TabNavigation" Value="Cycle" />
        <Setter Property="IsDefaultShadowEnabled" Value="True" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
    </Style>

    <!-- One chrome for every popup the player opens off its control bar: the
         volume strip, the track selector, the quick-control panel and the More
         menu. They used to be four independent decisions (two FlyoutPresenter
         styles built per open, plus a hand-written Border on the panel), which
         is how they drifted apart in background, radius and shadow.

         The Flyout-based ones consume the style below. The quick-control panel
         cannot: it is a Popup, because a Flyout is clipped to the window and the
         panel has to be able to leave it. So it takes the same brushes, the same
         radius constant and a matching ThemeShadow on its own Border, and this
         comment is the record that the two have to be changed together. -->
    <Style
        x:Key="MpvPlayerPopupPresenterStyle"
        BasedOn="{StaticResource AcrylicFlyoutPresenterStyle}"
        TargetType="FlyoutPresenter">
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <!-- Corner radius shared by the flyout presenters (through their default
         template) and the quick-control panel's Border. -->
    <CornerRadius x:Key="MpvPlayerPopupCornerRadius">8</CornerRadius>

    <!-- The typography and row metrics those same four popups share.

         Spacing already had a scale (MpvSpace*, above) and the popups simply
         were not using it; these are the sizes that had no token at all. Every
         one of them was spelled out per component, which is exactly how the
         track selector came to run 16/12/10 while the quick-control panel ran
         16/14/11 for the same three roles, and how only the panel ended up on
         MpvCardStyle. Change the numbers here, not in the components. -->
    <x:Double x:Key="MpvPopupTitleFontSize">12</x:Double>
    <x:Double x:Key="MpvPopupLabelFontSize">14</x:Double>
    <x:Double x:Key="MpvPopupCaptionFontSize">11</x:Double>
    <x:Double x:Key="MpvPopupIconSize">16</x:Double>
    <x:Double x:Key="MpvPopupRowMinHeight">36</x:Double>

    <!-- Horizontal inset of a popup's content, matching the card inset the
         quick-control panel already used (12,4,12,4). -->
    <Thickness x:Key="MpvPopupContentPadding">12,4,12,4</Thickness>

    <!-- Gap between a popup's tab strip / header and its list. -->
    <Thickness x:Key="MpvPopupListMargin">0,8,0,0</Thickness>

    <!-- Block line height for the settings breadcrumb trail, in DIPs. The trail
         mixes a category caption (inside a Button), a chevron and a section
         name, at two font sizes. Centring alone lines up their boxes, not their
         baselines, which is why the two captions read as one high and one low.
         An explicit block line height gives all of them the same line box, so
         the baselines coincide whatever the font size is. -->
    <x:Double x:Key="MpvBreadcrumbLineHeight">32</x:Double>

    <!-- Optical drop applied to the trailing section caption of the breadcrumb
         trail, in DIPs.

         Defaults to zero, and it should stay there. The category caption used to
         live inside a Button, whose ContentPresenter laid its text out by its
         own rules and left a baseline offset that was not visible in the markup;
         this token existed to cancel it out. The wrapping Button is gone, so all
         three trail elements are TextBlocks with identical metrics. The knob is
         kept because only the owner can see the result: raise the Y to drop the
         section caption, and if it is ever needed again, that is a signal the
         framework has crept back in. -->
    <Thickness x:Key="MpvBreadcrumbSectionNudge">0,0,0,0</Thickness>

</ResourceDictionary>
