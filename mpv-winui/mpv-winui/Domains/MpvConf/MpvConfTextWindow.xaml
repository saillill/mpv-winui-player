<basewin:BaseWindow
    x:Class="mpv_winui.Domains.MpvConf.MpvConfTextWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:basewin="using:mpv_winui.Modules.Common.View">

    <!-- The chrome follows the shape every code editor uses: a thin bar with the
         file's name, the text, and a thin bar with its state. Three surfaces and
         nothing else, because the file is the point.

         Three surfaces: #252526 for the two bars, #151515 for the text area, and
         #2A2A2A for the seam between the numbers and the text. They are literals
         rather than ThemeResources on purpose: this window is dark whatever the
         app theme is, so that the token colours below read the same way every
         time, and a light background would need a second palette.

         The text area is the darker of the two greys rather than a true black:
         black is harsh behind text this small, and the gaps between tokens would
         read as holes. -->
    <Grid Background="#151515">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Bar one: which file, and where it lives. 150px on the right is left
             empty because BaseWindow extends content into the title bar and that
             is where the caption buttons sit. -->
        <Grid
            Grid.Row="0"
            Padding="12,0,150,0"
            Background="#252526"
            ColumnSpacing="{StaticResource MpvSpaceS}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="{StaticResource MpvTransportTimeFontSize}"
                FontWeight="SemiBold"
                Foreground="#CCCCCC"
                Text="mpv.conf" />
            <TextBlock
                x:Name="PathText"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontFamily="Consolas"
                FontSize="{StaticResource MpvPopupCaptionFontSize}"
                Foreground="#7A7A7A"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Grid>

        <Grid Grid.Row="1" Background="#151515">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The gutter. Clipped, because the numbers are positioned in the
                 text's own coordinates: a line above or below the viewport would
                 otherwise be drawn over the bars. -->
            <Border
                x:Name="GutterHost"
                Grid.Column="0"
                Width="46"
                Background="#151515"
                BorderBrush="#2A2A2A"
                BorderThickness="0,0,1,0"
                SizeChanged="GutterHost_SizeChanged">
                <Canvas x:Name="Gutter" />
            </Border>

            <RichEditBox
                x:Name="Editor"
                Grid.Column="1"
                Padding="10,6,10,6"
                AcceptsReturn="True"
                Background="#151515"
                BorderThickness="0"
                FontFamily="Cascadia Mono, Consolas, Courier New"
                FontSize="12"
                IsSpellCheckEnabled="False"
                TextWrapping="NoWrap"
                TextChanged="Editor_TextChanged">
                <!-- One surface, in every state. A text control paints itself
                     from the TextControlBackground theme resources, so its
                     resting colour and its focused colour are two different
                     brushes and the editor changed shade the moment it was
                     clicked into. Pinning them here is what makes it hold still.

                     Only the background and the border are pinned. The
                     TextControlForeground resources are deliberately left alone:
                     a control foreground overrides the per-character colours the
                     highlighting writes, which renders the whole file in one
                     flat grey however carefully each token was coloured. -->
                <RichEditBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="#151515" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#151515" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#151515" />
                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#151515" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

                    <!-- Labels for the context menu below. They come from the
                         command kinds rather than from the language files, so they
                         are already translated and stay translated. -->
                    <StandardUICommand x:Key="CutCommand" Kind="Cut" />
                    <StandardUICommand x:Key="CopyCommand" Kind="Copy" />
                    <StandardUICommand x:Key="PasteCommand" Kind="Paste" />
                    <StandardUICommand x:Key="SelectAllCommand" Kind="SelectAll" />
                </RichEditBox.Resources>

                <!-- Selecting text shows nothing at all. The default flyout here
                     is a horizontal command bar carrying Bold, Italic and
                     Underline, which is a rich-text editor's toolbar and has no
                     meaning over a config file: nothing in this file is bold, and
                     adding an asterisk pair to make it so would only break the
                     option it sits in. -->
                <RichEditBox.SelectionFlyout>
                    <!-- An empty Flyout is not enough on its own: the presenter
                         still draws its own chrome, so selecting text left a
                         small empty box sitting under the line. Collapsing the
                         presenter too is what actually removes it. -->
                    <Flyout Placement="Top">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="MaxWidth" Value="0" />
                                <Setter Property="MaxHeight" Value="0" />
                                <Setter Property="Shadow" Value="{x:Null}" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <Border Width="0" Height="0" />
                    </Flyout>
                </RichEditBox.SelectionFlyout>

                <!-- Right-click gets an ordinary vertical menu, and only the
                     edits. Two things are deliberate: it is a MenuFlyout rather
                     than the control's default command bar, so the items stack the
                     way every other menu on the system does, and it carries no
                     formatting entry at all. -->
                <RichEditBox.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Command="{StaticResource CutCommand}" />
                        <MenuFlyoutItem Command="{StaticResource CopyCommand}" />
                        <MenuFlyoutItem Command="{StaticResource PasteCommand}" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Command="{StaticResource SelectAllCommand}" />
                    </MenuFlyout>
                </RichEditBox.ContextFlyout>
            </RichEditBox>
        </Grid>

        <!-- Bar three: a line for failures, and the key to the colours. Saving
             is silent on purpose. The file writes itself whenever typing pauses,
             so "saved" is the resting state and a green line announcing it is
             decoration; the only thing that belongs here is the case where the
             write did not happen, in a colour that reads as a warning. -->
        <Grid
            Grid.Row="2"
            Padding="12,0,12,0"
            Background="#252526">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StatusText"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="{StaticResource MpvPopupCaptionFontSize}"
                Foreground="#E0A96D"
                TextTrimming="CharacterEllipsis" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="{StaticResource MpvSpaceS}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource MpvSpaceXs}">
                    <Rectangle
                        Width="8"
                        Height="8"
                        Fill="#9CDCFE"
                        RadiusX="2"
                        RadiusY="2" />
                    <TextBlock
                        x:Name="LegendKeyText"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource MpvPopupCaptionFontSize}"
                        Foreground="#7A7A7A" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource MpvSpaceXs}">
                    <Rectangle
                        Width="8"
                        Height="8"
                        Fill="#CE9178"
                        RadiusX="2"
                        RadiusY="2" />
                    <TextBlock
                        x:Name="LegendValueText"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource MpvPopupCaptionFontSize}"
                        Foreground="#7A7A7A" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource MpvSpaceXs}">
                    <Rectangle
                        Width="8"
                        Height="8"
                        Fill="#6A9955"
                        RadiusX="2"
                        RadiusY="2" />
                    <TextBlock
                        x:Name="LegendCommentText"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource MpvPopupCaptionFontSize}"
                        Foreground="#7A7A7A" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource MpvSpaceXs}">
                    <Rectangle
                        Width="8"
                        Height="8"
                        Fill="#DCDCAA"
                        RadiusX="2"
                        RadiusY="2" />
                    <TextBlock
                        x:Name="LegendSectionText"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource MpvPopupCaptionFontSize}"
                        Foreground="#7A7A7A" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</basewin:BaseWindow>
