<UserControl
    x:Class="mpv_winui.Domains.Playback.VolumeFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Explicit geometry, because a vertical Slider has no intrinsic width.
         Left to itself the strip sized to whatever would render and the thumb
         and the foot of the track were clipped; the flyout presenter is told
         this same height so it cannot shrink-wrap below it. -->
    <StackPanel
        Width="44"
        Padding="4,2,4,6"
        Spacing="{StaticResource MpvSpaceCompact}">
        <AppBarButton
            x:Name="MuteButton"
            Width="32"
            Height="32"
            Padding="0"
            HorizontalAlignment="Center"
            Click="MuteButton_Click"
            IsTabStop="False"
            LabelPosition="Collapsed">
            <AppBarButton.Icon>
                <FontIcon x:Name="VolumeIcon" />
            </AppBarButton.Icon>
        </AppBarButton>
        <Slider
            x:Name="VolumeSlider"
            Width="40"
            Height="120"
            HorizontalAlignment="Center"
            IsTabStop="False"
            Maximum="100"
            Minimum="0"
            Orientation="Vertical"
            ValueChanged="VolumeSlider_ValueChanged" />
    </StackPanel>
</UserControl>
