<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:player="using:mpv_winui.Domains.Playback"
    xmlns:ycc="using:mpv_winui.Modules.Common.View.Controls"
    mc:Ignorable="d">
    <Style
        x:Key="CompactPlayerControlStyle"
        TargetType="player:PlayerControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="player:PlayerControl">
                    <Grid
                        x:Name="ControlPanelGrid"
                        Padding="4"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource MpvPlayControlBackground}"
                        RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="TranslateVertical" />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Two rows so this bar's total height matches the
                             other two layouts: Padding="4" is 4 on every side, so
                             8 vertical, plus 28 (progress/time) + 60 (transport)
                             = 96. Those are the same numbers Center uses, and the
                             same 96 the default bar measures (its own progress
                             row 32 + CommandBar 64). The progress and the time
                             used to sit inline in the single row, between the
                             two button clusters; they now span row 0, and the
                             clusters moved to row 1. Element names are
                             unchanged, so the VisualStates that collapse them
                             still bind - and none of those setters targets a
                             container, only the named leaves. -->
                        <!-- Same two rows as the default bar: the slider, then the
                             button row at its shared height. See the note in
                             CenterPlayerControlStyle.xaml for why these are tokens
                             and not numbers. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="{StaticResource MpvTransportBarHeight}" />
                        </Grid.RowDefinitions>
                        <ProgressBar
                            x:Name="BufferingProgressBar"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Grid.RowSpan="2"
                            Height="4"
                            Margin="8,0,8,0"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            IsIndeterminate="True"
                            ShowPaused="True"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="ErrorBorder"
                            Grid.Column="1"
                            Grid.RowSpan="2"
                            MinWidth="220"
                            MaxWidth="320"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource MpvControlBackground}"
                            Canvas.ZIndex="99"
                            CornerRadius="4"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="ErrorTextBlock"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="Red"
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="&#x26D4;"
                                TextWrapping="WrapWholeWords" />
                        </Border>

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="{StaticResource MpvSpaceXs}">
                            <Button
                                x:Name="PlayPauseButton"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <!-- Ringed like the other two bar layouts:
                                         the compact bar is a different
                                         arrangement of the same controls, not a
                                         different set of them. Smaller because
                                         this bar's buttons are 42 rather than
                                         50, but the ring and the glyph keep the
                                         classic bar's proportions at that size
                                         (stroke 7% of the outside diameter, ink
                                         60%), not free-hand numbers. -->
                                    <Grid
                                        Width="{StaticResource MpvTransportButtonSize}"
                                        Height="{StaticResource MpvTransportButtonSize}">
                                        <Ellipse StrokeThickness="3" Stroke="{StaticResource MpvTransportPlayRingBrush}" />
                                        <Viewbox
                                            Width="{StaticResource MpvTransportButtonSize}"
                                            Height="{StaticResource MpvTransportButtonSize}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <PathIcon
                                                x:Name="PlayGlyph"
                                                Width="{StaticResource MpvTransportIconSize}"
                                                Height="{StaticResource MpvTransportIconSize}"
                                                Data="F1 M5 5.27368C5 3.56682 6.82609 2.48151 8.32538 3.2973L20.687 10.0235C22.2531 10.8756 22.2531 13.124 20.687 13.9762L8.32538 20.7024C6.82609 21.5181 5 20.4328 5 18.726V5.27368Z" />
                                        </Viewbox>
                                        <Viewbox
                                            Width="{StaticResource MpvTransportButtonSize}"
                                            Height="{StaticResource MpvTransportButtonSize}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <PathIcon
                                                x:Name="PauseGlyph"
                                                Width="{StaticResource MpvTransportIconSize}"
                                                Height="{StaticResource MpvTransportIconSize}"
                                                Data="F1 M5.74609 3C4.7796 3 3.99609 3.7835 3.99609 4.75V19.25C3.99609 20.2165 4.7796 21 5.74609 21H9.24609C10.2126 21 10.9961 20.2165 10.9961 19.25V4.75C10.9961 3.7835 10.2126 3 9.24609 3H5.74609ZM14.7461 3C13.7796 3 12.9961 3.7835 12.9961 4.75V19.25C12.9961 20.2165 13.7796 21 14.7461 21H18.2461C19.2126 21 19.9961 20.2165 19.9961 19.25V4.75C19.9961 3.7835 19.2126 3 18.2461 3H14.7461Z"
                                                Visibility="Collapsed" />
                                        </Viewbox>
                                    </Grid>
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="PreviousTrackButton"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <FontIcon
                                        FontSize="{StaticResource MpvTransportIconSize}"
                                        Glyph="&#xF8AC;" />
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="NextTrackButton"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <FontIcon
                                        FontSize="{StaticResource MpvTransportIconSize}"
                                        Glyph="&#xF8AD;" />
                                </Button.Content>
                            </Button>
                        </StackPanel>

                        <Grid
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="8,0"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <ycc:TickBar
                                    x:Name="ProgressTickBar"
                                    Height="8"
                                    Margin="7,0,7,0"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    TickBrush="{ThemeResource SystemAccentColor2Brush}" />
                                <Slider
                                    x:Name="ProgressSlider"
                                    MinWidth="80"
                                    Margin="8,0,8,0"
                                    VerticalAlignment="Center"
                                    IsTabStop="False"
                                    IsThumbToolTipEnabled="False" />
                            </Grid>
                            <StackPanel
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="{StaticResource MpvSpaceXxs}">
                                <TextBlock
                                    x:Name="TimeElapsedElement"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="00:00"
                                    Typography.NumeralAlignment="Tabular" />
                                <TextBlock
                                    x:Name="TimeSeparatorElement"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="/" />
                                <TextBlock
                                    x:Name="TimeDurationElement"
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="00:00"
                                    Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </Grid>

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="{StaticResource MpvSpaceXs}">
                            <Button
                                x:Name="VolumeMuteButton"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <FontIcon
                                        x:Name="AudioMuteSymbol"
                                        FontSize="{StaticResource MpvTransportIconSize}"
                                        Glyph="&#xE995;" />
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="FullWindowButton"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <FontIcon
                                        x:Name="FullWindowSymbol"
                                        FontSize="{StaticResource MpvTransportIconSize}"
                                        Glyph="&#xF16B;" />
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="FullScreenButton"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <FontIcon
                                        x:Name="FullScreenSymbol"
                                        FontSize="{StaticResource MpvTransportIconSize}"
                                        Glyph="&#xE740;" />
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="MoreButton"
                                IsTabStop="False"
                                Style="{StaticResource SquareIconButtonStyle}">
                                <Button.Content>
                                    <!-- E712 is the horizontal three-dot "More"; E10C is
                                         GlobalNavButton, the hamburger. Same correction as
                                         CenterPlayerControlStyle.xaml and PlayerControl.xaml. -->
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="{StaticResource MpvTransportIconSize}"
                                        Glyph="&#xE712;" />
                                </Button.Content>
                                <Button.Flyout>
                                    <MenuFlyout
                                        x:Name="MoreFlyout"
                                        Placement="Top">
                                        <MenuFlyoutItem
                                            x:Name="MoreSkipBackward"
                                            Text="Skip Backward">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xED3C;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Name="MoreSkipForward"
                                            Text="Skip Forward">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xED3D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Name="MoreShuffle"
                                            Text="Shuffle">
                                            <MenuFlyoutItem.Icon>
                                                <PathIcon
                                                    x:Name="MoreShuffleIcon"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="F1 M19.2803 4.71967C18.9874 4.42678 18.5126 4.42678 18.2197 4.71967C17.9268 5.01256 17.9268 5.48744 18.2197 5.78033L19.4393 6.99999H19.25C15.332 6.99999 12.8269 9.30232 10.5579 11.3877L10.4925 11.4477C8.15388 13.5968 6.04432 15.5 2.75 15.5C2.33579 15.5 2 15.8358 2 16.25C2 16.6642 2.33579 17 2.75 17C6.66803 17 9.1731 14.6977 11.4421 12.6123L11.4421 12.6123L11.5075 12.5522C13.8461 10.4032 15.9557 8.49999 19.25 8.49999H19.4393L18.2197 9.71966C17.9268 10.0126 17.9268 10.4874 18.2197 10.7803C18.5126 11.0732 18.9874 11.0732 19.2803 10.7803L21.7803 8.28032C21.921 8.13967 22 7.9489 22 7.74999C22 7.55108 21.921 7.36031 21.7803 7.21966L19.2803 4.71967ZM2.75 6.99983C5.99799 6.99983 8.27497 8.58203 10.2514 10.3112C10.1492 10.4048 10.0482 10.4978 9.94821 10.5897L9.81591 10.7113C9.58463 10.9239 9.35843 11.1309 9.13588 11.3316C7.28326 9.73131 5.39993 8.49983 2.75 8.49983C2.33579 8.49983 2 8.16405 2 7.74983C2 7.33562 2.33579 6.99983 2.75 6.99983ZM19.25 16.9998C16.0021 16.9998 13.7251 15.4177 11.7487 13.6885C11.8507 13.5951 11.9515 13.5023 12.0513 13.4105L12.0518 13.4101L12.1841 13.2885C12.4154 13.0759 12.6416 12.8688 12.8642 12.6681C14.7168 14.2684 16.6001 15.4998 19.25 15.4998H19.4393L18.2197 14.2802C17.9268 13.9873 17.9268 13.5124 18.2197 13.2195C18.5126 12.9266 18.9874 12.9266 19.2803 13.2195L21.7803 15.7195C21.921 15.8602 22 16.0509 22 16.2498C22 16.4487 21.921 16.6395 21.7803 16.7802L19.2803 19.2802C18.9874 19.5731 18.5126 19.5731 18.2197 19.2802C17.9268 18.9873 17.9268 18.5124 18.2197 18.2195L19.4393 16.9998H19.25Z" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Name="MoreRepeat"
                                            Text="Repeat">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon
                                                    x:Name="MoreRepeatIcon"
                                                    Glyph="&#xE8EE;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator x:Name="MoreTransportSep" />
                                        <MenuFlyoutSubItem
                                            x:Name="MorePlaybackRate"
                                            Text="Playback Rate">
                                            <MenuFlyoutSubItem.Icon>
                                                <FontIcon Glyph="&#xEC57;" />
                                            </MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem
                                                Tag="0.1"
                                                Text="0.1x" />
                                            <MenuFlyoutItem
                                                Tag="0.25"
                                                Text="0.25x" />
                                            <MenuFlyoutItem
                                                Tag="0.5"
                                                Text="0.5x" />
                                            <MenuFlyoutItem
                                                Tag="0.75"
                                                Text="0.75x" />
                                            <MenuFlyoutItem
                                                Tag="1.0"
                                                Text="1.0x" />
                                            <MenuFlyoutItem
                                                Tag="1.25"
                                                Text="1.25x" />
                                            <MenuFlyoutItem
                                                Tag="1.5"
                                                Text="1.5x" />
                                            <MenuFlyoutItem
                                                Tag="1.75"
                                                Text="1.75x" />
                                            <MenuFlyoutItem
                                                Tag="2.0"
                                                Text="2.0x" />
                                            <MenuFlyoutItem
                                                Tag="4.0"
                                                Text="4.0x" />
                                            <MenuFlyoutItem
                                                Tag="8.0"
                                                Text="8.0x" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutSubItem
                                            x:Name="MoreZoom"
                                            Text="Zoom">
                                            <MenuFlyoutSubItem.Icon>
                                                <FontIcon Glyph="&#xE799;" />
                                            </MenuFlyoutSubItem.Icon>
                                            <MenuFlyoutItem
                                                Tag="no"
                                                Text="Auto" />
                                            <MenuFlyoutItem
                                                Tag="4:3"
                                                Text="4:3" />
                                            <MenuFlyoutItem
                                                Tag="16:9"
                                                Text="16:9" />
                                            <MenuFlyoutItem
                                                Tag="16:10"
                                                Text="16:10" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutItem
                                            x:Name="MorePreviousTrack"
                                            Text="Previous Track"
                                            Visibility="Collapsed">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF8AC;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Name="MoreNextTrack"
                                            Text="Next Track"
                                            Visibility="Collapsed">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xF8AD;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator
                                            x:Name="MoreWindowSep"
                                            Visibility="Collapsed" />
                                        <MenuFlyoutItem
                                            x:Name="MoreFullWindow"
                                            Text="Full Window"
                                            Visibility="Collapsed">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon
                                                    x:Name="MoreFullWindowIcon"
                                                    Glyph="&#xF16B;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            x:Name="MoreFullScreen"
                                            Text="Full Screen"
                                            Visibility="Collapsed">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon
                                                    x:Name="MoreFullScreenIcon"
                                                    Glyph="&#xE740;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="MediaStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Buffering">
                                    <VisualState.Setters>
                                        <Setter Target="BufferingProgressBar.Visibility" Value="Visible" />
                                        <Setter Target="BufferingProgressBar.ShowPaused" Value="False" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Error">
                                    <VisualState.Setters>
                                        <Setter Target="ErrorBorder.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="PlayPauseStates">
                                <VisualState x:Name="PlayState" />
                                <VisualState x:Name="PauseState">
                                    <VisualState.Setters>
                                        <Setter Target="PlayGlyph.Visibility" Value="Collapsed" />
                                        <Setter Target="PauseGlyph.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="VolumeMuteStates">
                                <VisualState x:Name="VolumeState" />
                                <VisualState x:Name="MuteState">
                                    <VisualState.Setters>
                                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE74F;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="VolumeState0">
                                    <VisualState.Setters>
                                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE992;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="VolumeState1">
                                    <VisualState.Setters>
                                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE993;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="VolumeState2">
                                    <VisualState.Setters>
                                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE994;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="VolumeState3">
                                    <VisualState.Setters>
                                        <Setter Target="AudioMuteSymbol.Glyph" Value="&#xE995;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="FullScreenStates">
                                <VisualState x:Name="NonFullScreenState" />
                                <VisualState x:Name="FullScreenState">
                                    <VisualState.Setters>
                                        <Setter Target="FullScreenSymbol.Glyph" Value="&#xE73F;" />
                                        <Setter Target="MoreFullScreenIcon.Glyph" Value="&#xE72B;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="FullWindowStates">
                                <VisualState x:Name="NonFullWindowState" />
                                <VisualState x:Name="FullWindowState">
                                    <VisualState.Setters>
                                        <Setter Target="FullWindowSymbol.Glyph" Value="&#xE745;" />
                                        <Setter Target="MoreFullWindowIcon.Glyph" Value="&#xE745;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="RepeatStates">
                                <VisualState x:Name="RepeatAllState" />
                                <VisualState x:Name="RepeatNoneState">
                                    <VisualState.Setters>
                                        <Setter Target="MoreRepeatIcon.Glyph" Value="&#xF5E7;" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="RepeatOneState">
                                    <VisualState.Setters>
                                        <Setter Target="MoreRepeatIcon.Glyph" Value="&#xE8ED;" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
<!-- The shuffle glyph is the generated Fluent System Icons ArrowShuffle.
                                 It was copied from FluentIcons.Gen.cs because a Style's
                                 template cannot x:Bind a C# constant, and a shared
                                 PathGeometry resource is impossible (a Geometry belongs to
                                 one PathIcon for its lifetime, and this template is
                                 instantiated per control). Re-run tools/gen-fluent-icons.py
                                 before editing this path by hand. -->

                            <VisualStateGroup x:Name="ShuffleStates">
                                <VisualState x:Name="ShuffleNoneState" />
                                <VisualState x:Name="ShuffleState">
                                    <VisualState.Setters>
                                        <Setter Target="MoreShuffleIcon.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="ControlPanelVisibilityStates">
                                <VisualState x:Name="ControlPanelFadeIn">
                                    <VisualState.Setters>
                                        <Setter Target="ControlPanelGrid.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <FadeInThemeAnimation TargetName="ControlPanelGrid" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ControlPanelFadeOut">
                                    <Storyboard>
                                        <FadeOutThemeAnimation TargetName="ControlPanelGrid" />
                                    </Storyboard>
                                    <VisualState.Setters>
                                        <Setter Target="ControlPanelGrid.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="WidthAdaptiveStates">
                                <VisualState x:Name="Wide" />
                                <VisualState x:Name="Medium" />
                                <VisualState x:Name="Compact">
                                    <VisualState.Setters>
                                        <Setter Target="FullWindowButton.Visibility" Value="Collapsed" />
                                        <Setter Target="FullScreenButton.Visibility" Value="Collapsed" />
                                        <Setter Target="MoreFullWindow.Visibility" Value="Visible" />
                                        <Setter Target="MoreFullScreen.Visibility" Value="Visible" />
                                        <Setter Target="MoreWindowSep.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Narrow">
                                    <VisualState.Setters>
                                        <Setter Target="PreviousTrackButton.Visibility" Value="Collapsed" />
                                        <Setter Target="NextTrackButton.Visibility" Value="Collapsed" />
                                        <Setter Target="TimeDurationElement.Visibility" Value="Collapsed" />
                                        <Setter Target="TimeSeparatorElement.Visibility" Value="Collapsed" />
                                        <Setter Target="ProgressTickBar.Visibility" Value="Collapsed" />
                                        <Setter Target="ProgressSlider.Visibility" Value="Collapsed" />
                                        <Setter Target="FullWindowButton.Visibility" Value="Collapsed" />
                                        <Setter Target="FullScreenButton.Visibility" Value="Collapsed" />
                                        <Setter Target="MorePreviousTrack.Visibility" Value="Visible" />
                                        <Setter Target="MoreNextTrack.Visibility" Value="Visible" />
                                        <Setter Target="MoreFullWindow.Visibility" Value="Visible" />
                                        <Setter Target="MoreFullScreen.Visibility" Value="Visible" />
                                        <Setter Target="MoreWindowSep.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
