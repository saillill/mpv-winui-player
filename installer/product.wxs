<?xml version="1.0" encoding="UTF-8"?>
<!--
  mpv-winui-player MSI (WiX v5).

  The app is unpackaged: all runtime data goes to %LOCALAPPDATA%\mpv-winui and
  the registry, and the install directory is read-only. A per-user install
  into %LocalAppData%\Programs (no elevation) is the natural fit; uninstall
  leaves the user's data and settings untouched.

  Preprocessor variables (set on the command line):
    Version     - MSI product version, e.g. 1.0.0
    UpgradeCode - fixed upgrade GUID for MajorUpgrade
    SourceDir   - the publish output directory (harvested via <Files>)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="mpv-winui-player"
      Manufacturer="mpv-winui"
      Version="$(var.Version)"
      UpgradeCode="$(var.UpgradeCode)"
      Scope="perUser"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of mpv-winui-player is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!--
      Install into %LocalAppData%\Programs\mpv-winui-player (per-user, no
      elevation). NOTE: the install directory must NOT be %LocalAppData%\mpv-winui
      - that is the app's user-data root (logs, mpv config, languages).
    -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="mpv-winui-player" />
      </Directory>
    </StandardDirectory>

    <!--
      Harvest every published file (WiX v5: no separate heat step needed).

      Debug symbols are excluded on purpose. The publish output carries
      mpvw.pdb (~95 MB) and mpv_winrt.pdb (~44 MB) next to the binaries, and a
      bare <Files> harvested them too: the Release MSI shipped ~136 MB of
      symbols, leaked private symbol information in a shipped product, and grew
      the install tree from 158 to 160 files. package.ps1 already drops *.pdb
      from the portable zip (robocopy /XF *.pdb), so excluding them here keeps
      the two distribution channels in agreement.

      The Exclude pattern MUST repeat the $(var.SourceDir) prefix used by
      Include: WiX compares full paths for Files/Exclude wildcard matching, so a
      bare "**\*.pdb" would match nothing and the symbols would silently stay
      in. ** also matches zero directories, so this covers a pdb at the harvest
      root as well as any nested one.

      NOTE: Exclude is a child element of <Files> in WiX v5, not an attribute.
    -->
    <ComponentGroup Id="FilesComponentGroup" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**\*">
        <Exclude Files="$(var.SourceDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>

    <!-- Start-menu shortcut with the app icon. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut
            Id="StartMenuMpvWinui"
            Name="mpv-winui-player"
            Description="mpv-winui-player - mpv 图形播放器"
            Target="[INSTALLFOLDER]mpvw.exe"
            WorkingDirectory="INSTALLFOLDER"
            Icon="MpvWinuiIcon" />
        <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\mpv-winui-player" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!--
      mpvw:// protocol registration (per-user, HKCU).

      The scheme is mpvw, which is what the executable is named and what
      Package.appxmanifest already declares. This used to register mpv-winui
      while the app only parsed mpvw, so the association the installer created
      was one the app could not start from: the shell handed over a URI and the
      app silently ignored it.

      RemoveRegistryKey clears the same key under the retired scheme. Without it
      an upgrade leaves that association behind and Windows keeps offering
      mpv-winui:// for a program that no longer accepts it. It is a no-op on a
      machine that never had the old scheme registered.
    -->
    <Component Id="ProtocolRegistration" Guid="*" Directory="INSTALLFOLDER">
      <RemoveRegistryKey Root="HKCU" Key="Software\Classes\mpv-winui" Action="removeOnInstall" />
      <RegistryKey Root="HKCU" Key="Software\Classes\mpvw">
        <RegistryValue
            Type="string"
            Name="URL Protocol"
            Value=""
            KeyPath="yes" />
        <RegistryKey Key="DefaultIcon">
          <RegistryValue Type="string" Value="[INSTALLFOLDER]mpvw.exe,0" />
        </RegistryKey>
        <RegistryKey Key="shell\open\command">
          <RegistryValue
              Type="string"
              Value="&quot;[INSTALLFOLDER]mpvw.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
    </Component>

    <Feature Id="MainFeature" Title="mpv-winui-player" Level="1">
      <ComponentGroupRef Id="FilesComponentGroup" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="ProtocolRegistration" />
    </Feature>

    <Icon Id="MpvWinuiIcon" SourceFile="$(var.AppIcon)" />
    <Property Id="ARPPRODUCTICON" Value="MpvWinuiIcon" />
  </Package>
</Wix>
