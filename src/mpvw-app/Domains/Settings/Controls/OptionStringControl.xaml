<local:OptionControlBase
    x:Class="mpv_winui.Domains.Settings.Controls.OptionStringControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Domains.Settings.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        ColumnSpacing="{StaticResource MpvOptionControlGap}"
        VerticalAlignment="Center"
        Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="InputColumn" Width="260" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <Grid VerticalAlignment="Center">
                <TextBox
                    x:Name="InputBox"
                    Width="260"
                    MaxWidth="260"
                    MinHeight="32"
                    HorizontalAlignment="Left"
                    LostFocus="OnLostFocus"
                    KeyDown="OnKeyDown"
                    TextChanged="InputBox_TextChanged" />
                <Button
                    x:Name="DisplayButton"
                    Width="260"
                    MaxWidth="260"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Click="OnDisplayClick" />
            </Grid>
            <!-- ErrorText stays: it is this row's validation surface, written by
                 TryCommit() and cleared as the user types. The title, description
                 and warning are drawn by the SettingsCard that hosts this control. -->
            <TextBlock
                x:Name="ErrorText"
                Style="{StaticResource MpvOptionErrorStyle}" />
        </StackPanel>
        <StackPanel
            Grid.Column="1"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="{StaticResource MpvSpaceS}">
            <Button
                x:Name="ResetButton"
                MinWidth="64"
                VerticalAlignment="Center"
                Click="OnResetBindingClick"
                Content="Reset"
                Visibility="Collapsed" />
            <Button
                x:Name="OpenButton"
                MinWidth="96"
                VerticalAlignment="Center"
                Click="OnOpenFolderClick"
                Content="Open"
                Visibility="Collapsed" />
            <Button
                x:Name="BrowseButton"
                MinWidth="96"
                VerticalAlignment="Center"
                Click="OnBrowseClick"
                Content="Browse..."
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</local:OptionControlBase>