<local:OptionControlBase
    x:Class="mpv_winui.Domains.Settings.Controls.OptionStringListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Domains.Settings.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center" ColumnSpacing="{StaticResource MpvSpaceS}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="InputColumn" Width="260" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox
            x:Name="CustomInput"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            KeyDown="OnCustomKeyDown"
            LostFocus="OnCustomLostFocus" />
        <ComboBox
            x:Name="Combo"
            Grid.Column="1"
            MinWidth="140"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            SelectionChanged="OnSelectionChanged" />
    </Grid>
</local:OptionControlBase>