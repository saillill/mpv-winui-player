<local:OptionControlBase
    x:Class="mpv_winui.Domains.Settings.Controls.OptionIntegerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Domains.Settings.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ws="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <Grid ColumnSpacing="{StaticResource MpvOptionControlGap}" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="180" />
        </Grid.ColumnDefinitions>
        <!-- ErrorText stays: it is this row's validation surface, written by
             TryCommit(). The title, description and warning above it are drawn
             by the SettingsCard that hosts this control. -->
        <TextBlock
            x:Name="ErrorText"
            Grid.Column="0"
            VerticalAlignment="Center"
            Style="{StaticResource MpvOptionErrorStyle}" />
        <ws:NumberBox
            x:Name="NumberBox"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            KeyDown="OnKeyDown"
            LostFocus="OnLostFocus"
            SpinButtonPlacementMode="Inline" />
    </Grid>
</local:OptionControlBase>
