<local:OptionControlBase
    x:Class="mpv_winui.Domains.Settings.Controls.OptionLayoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Domains.Settings.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- The title and description are drawn by the SettingsCard that wraps this
         control; only the style cards are left. -->
    <Grid
        VerticalAlignment="Center"
        Background="Transparent">
        <ItemsControl
            x:Name="StyleCards">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="{StaticResource MpvSpaceM}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</local:OptionControlBase>
