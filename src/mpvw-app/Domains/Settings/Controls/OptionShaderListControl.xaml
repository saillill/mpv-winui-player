<local:OptionControlBase
    x:Class="mpv_winui.Domains.Settings.Controls.OptionShaderListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:mpv_winui.Domains.Settings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="{StaticResource MpvSpaceS}">
        <ItemsControl x:Name="ShaderItems">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ShaderEntry">
                    <Grid
                        Margin="0,2"
                        ColumnSpacing="{StaticResource MpvSpaceCompact}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Checked="Entry_Changed"
                            IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                            Unchecked="Entry_Changed" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource MpvTransportTimeFontSize}"
                            Text="{x:Bind Path, Mode=OneTime}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Path, Mode=OneTime}" />
                        <Button
                            Grid.Column="2"
                            Loaded="MoveUpButton_Loaded"
                            Content="&#xE70E;"
                            Tag="{x:Bind}"
                            Click="MoveUp_Click" />
                        <Button
                            Grid.Column="3"
                            Loaded="MoveDownButton_Loaded"
                            Content="&#xE70D;"
                            Tag="{x:Bind}"
                            Click="MoveDown_Click" />
                        <Button
                            Grid.Column="4"
                            Loaded="RemoveButton_Loaded"
                            Content="&#xE711;"
                            Tag="{x:Bind}"
                            Click="Remove_Click" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button
            x:Name="AddButton"
            HorizontalAlignment="Left"
            Click="Add_Click" />
    </StackPanel>
</local:OptionControlBase>
