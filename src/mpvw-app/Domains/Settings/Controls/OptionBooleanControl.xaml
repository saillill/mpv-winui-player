<local:OptionControlBase
    x:Class="mpv_winui.Domains.Settings.Controls.OptionBooleanControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Domains.Settings.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- The row title and description are drawn by the SettingsCard that hosts
         this control; what belongs here is the toggle alone. -->
    <!-- Stock WinUI toggle: the official template's track is already a
         40x20 rounded pill pinned to the right of the control; the wide
         default MinWidth (with room for a beside-track caption) is what
         made it drift off the card edge. MinWidth=0 collapses that room
         so the track alone hugs the card's right edge. No custom
         template: copying the WinUI2 template styles broke at runtime,
         since those theme keys do not exist in Windows App SDK. -->
    <ToggleSwitch
        x:Name="ToggleSwitch"
        MinWidth="0"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Toggled="OnToggled" />
</local:OptionControlBase>
