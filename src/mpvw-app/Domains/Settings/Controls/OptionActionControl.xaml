<local:OptionControlBase
    x:Class="mpv_winui.Domains.Settings.Controls.OptionActionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Domains.Settings.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnSpacing="{StaticResource MpvOptionControlGap}" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Column="0"
            VerticalAlignment="Center"
            Spacing="{StaticResource MpvSpaceXxs}">
            <TextBlock x:Name="LabelText" Style="{StaticResource MpvOptionLabelStyle}" />
            <TextBlock x:Name="DescriptionText" Style="{StaticResource MpvOptionDescriptionStyle}" />
            <TextBlock x:Name="WarningText" Style="{StaticResource MpvOptionWarningStyle}" />
        </StackPanel>
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="{StaticResource MpvSpaceCompact}">
            <!-- A row that offers two ways in shows both buttons side by side;
                 the pair is its own row so the status line below still lines up
                 with the buttons' right edge instead of a single button's. -->
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="{StaticResource MpvSpaceS}">
                <Button
                    x:Name="ActionButton"
                    MinWidth="120"
                    Click="OnActionClick" />
                <Button
                    x:Name="SecondaryActionButton"
                    MinWidth="120"
                    Click="OnSecondaryActionClick"
                    Visibility="Collapsed" />
            </StackPanel>
            <TextBlock
                x:Name="StatusText"
                HorizontalAlignment="Right"
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</local:OptionControlBase>
