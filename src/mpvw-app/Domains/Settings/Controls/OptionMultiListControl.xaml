<local:OptionControlBase
    x:Class="mpv_winui.Domains.Settings.Controls.OptionMultiListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Domains.Settings.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <!-- No ErrorText and no text column: this control has no validation for
             any of its four options (they are all free-text lists with
             AllowEmpty = true), so an error surface here could never be
             reached. The title, description and warning are drawn by the
             SettingsCard that hosts this control. -->
        <StackPanel
            x:Name="RowsPanel"
            Grid.Column="0"
            VerticalAlignment="Center"
            Spacing="{StaticResource MpvSpaceCompact}" />
    </Grid>
</local:OptionControlBase>
