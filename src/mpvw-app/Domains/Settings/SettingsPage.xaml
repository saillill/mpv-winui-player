<Page
    x:Class="mpv_winui.Domains.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:mpv_winui.Domains.Settings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Domains.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Mirrors OptionListViewItemStyle: section cards must sit in the
             same padded content area as the option cards, not inside the
             ListView's default 12px item chrome. -->
        <Style
            x:Key="SectionCardListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </Page.Resources>

    <!--
        WinUI 3 settings shell: NavigationView (icon pane) on the left,
        search + options + reset footer in the content area. The category
        items are built in code so their labels follow AppLang on language
        switches without rebuilding the page.

        The pane is hidden while customizing: the folder tree already lists
        the same categories, and showing both reads as a duplicated sidebar.

        The pane's display mode is set from SettingsPage_SizeChanged, not by
        PaneDisplayMode="Auto" plus a pair of thresholds. Both thresholds were
        pinned to the same value, which leaves the compact band between them with
        zero width, and coming back from the minimal shape the pane could settle
        in that degenerate band and return as an icon rail with no captions
        instead of the expanded list. Driving the mode explicitly removes the band
        from the question. There are deliberately no threshold attributes left
        here: with the mode set in code they would be inert, and inert config that
        looks live is how this pane failed to collapse twice already.
    -->
    <NavigationView
        x:Name="CategoryNav"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False"
        OpenPaneLength="240"
        PaneDisplayMode="Left"
        SizeChanged="SettingsPage_SizeChanged"
        SelectionChanged="CategoryNav_SelectionChanged">
        <NavigationView.Resources>
            <!-- One surface for pane and content: no inner grey layers, the
                 window background shows through on both sides. -->
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        </NavigationView.Resources>

        <!-- Immediate switch between the icon rail and the icon plus captions,
             at the foot of the pane so it is only reachable while the pane is on
             screen. Not persisted: it is a way of looking at the list, not a
             setting, and the window's width still decides the mode whenever the
             window is narrower than the two-column layout can hold. -->
        <NavigationView.PaneFooter>
            <Button
                x:Name="PaneModeButton"
                Margin="4,4,4,8"
                Padding="{StaticResource MpvSearchButtonPadding}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Background="Transparent"
                BorderThickness="0"
                Click="PaneModeButton_Click">
                <FontIcon
                    x:Name="PaneModeGlyph"
                    FontSize="16"
                    Glyph="&#xE76C;" />
            </Button>
        </NavigationView.PaneFooter>
        <NavigationView.Content>
            <Grid x:Name="SettingsContentRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The rows below are the rows of the page. Two of them are
                     rows of one content column and share its capped, centred
                     width: the breadcrumb, and the browse host.

                     The breadcrumb carries the cap on itself, in the pair the
                     rest of the file uses: MaxWidth plus
                     HorizontalAlignment="Stretch", so it fills the content area
                     up to the cap and the layout centres the capped box.

                     The browse host carries the cap on its CONTENT instead, and
                     spans the whole content area. It has to: a ScrollViewer
                     draws its vertical bar at its own right edge, so capping the
                     ScrollViewer caps the bar with it, which is what left the
                     bar 12 DIP from the cards and the free space of a wide
                     window unused. The reading measure belongs to the content;
                     the scrolling surface belongs to the window. What lands the
                     cards on the breadcrumb's x is therefore the ScrollViewer's
                     own HorizontalContentAlignment="Center": the content
                     presenter's default is Left, and with that default the
                     capped panel is placed at the LEFT of the free space, 169
                     DIP to the right of the title it hangs under (measured,
                     maximised).

                     Stretch rather than Center on the rows, deliberately. A
                     centred row is arranged at its *desired* width, and a row
                     whose width comes from its content (the breadcrumb's trail,
                     or a ScrollViewer wrapping a column of cards) desires only
                     as much as it happens to hold. The column then shrank and
                     the page floated in the middle of the window: the title sat
                     near the window centre while the cards began somewhere else
                     again. Stretch gives the rows the same finite width, so they
                     cannot disagree about where the column starts.

                     Keep the rows as direct children. A wrapper Grid would have
                     to reproduce that same finite width, and an earlier attempt
                     to fix this by centring a wrapper is what produced the
                     shrinking it was meant to cure.

                     The cap still applies: past MpvContentMaxWidth the column
                     stops growing and the layout centres the capped column, which
                     is what Windows Settings does on a wide display.

                     The column's rows add no horizontal padding of their own on
                     the leading side, so the breadcrumb and the cards share one
                     left edge instead of two stacked insets.

                     The footer is the third row but NOT a row of the column.
                     Its actions are page-level controls and sit on the window's
                     right edge, which is the edge the browse row's scrollbar
                     now sits on too. Only the footer's status line stays on the
                     reading column, so a confirmation appears under the card it
                     belongs to. -->
                <Grid
                    x:Name="BreadcrumbBar"
                    Grid.Row="0"
                    MaxWidth="{StaticResource MpvContentMaxWidth}"
                    HorizontalAlignment="Stretch"
                    Margin="{StaticResource MpvBreadcrumbBarMargin}"
                    ColumnSpacing="{StaticResource MpvSpaceM}"
                    Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource MpvSpaceM}">
                            <!-- A plain TextBlock with a Tapped handler, not a
                                 Button. Every earlier attempt kept the category
                                 inside a Button and tried to make its
                                 ContentPresenter agree with the sibling
                                 TextBlocks about where the baseline goes; the
                                 leftover offset lived in that presenter and was
                                 invisible in the markup. The wrapping frame was
                                 the problem, so it is gone: all three trail
                                 elements are now the same element type with the
                                 same metrics, and the baselines match because
                                 there is no second layout authority between them.

                                 The trail is text only: the leading back
                                 chevron is gone. It was a second way to do what
                                 the category caption already does (clear the
                                 drilled-in section and return to the category
                                 overview), and the caption is the better
                                 affordance because it names where the click
                                 lands. Its hover state is therefore expressed
                                 with the caption's own properties rather than a
                                 wrapping control, for the reason above: an
                                 Opacity bump and a Foreground lift, toggled from
                                 the pointer handlers, cost no layout and add no
                                 element between the captions. -->
                            <TextBlock
                                x:Name="BreadcrumbCategoryText"
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="24"
                                FontWeight="SemiBold"
                                LineHeight="{StaticResource MpvBreadcrumbLineHeight}"
                                LineStackingStrategy="BlockLineHeight"
                                Tapped="BreadcrumbCategory_Tapped"
                                PointerEntered="BreadcrumbCategory_PointerEntered"
                                PointerExited="BreadcrumbCategory_PointerExited"
                                TextTrimming="CharacterEllipsis"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="BreadcrumbSeparator"
                                VerticalAlignment="Center"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                LineHeight="{StaticResource MpvBreadcrumbLineHeight}"
                                LineStackingStrategy="BlockLineHeight"
                                Text="&#x203A;"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="BreadcrumbSection"
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="SemiBold"
                                LineHeight="{StaticResource MpvBreadcrumbLineHeight}"
                                LineStackingStrategy="BlockLineHeight"
                                Margin="{StaticResource MpvBreadcrumbSectionNudge}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                </Grid>

                <!-- Sub-category overview: section cards shown instead of the
                     option list when a category holds more than one section. -->
                <!-- One scrolling surface per category page: common options
                     directly on the overview, then the advanced entry cards. -->
                <Grid Grid.Row="1">
                    <!-- Browsing layout: one column of cards under the trail.

                         The column has exactly one gutter, defined here: a
                         ScrollViewer that is inset 12 from the content area
                         (so the column does not touch the NavigationView pane
                         or the window edge) and otherwise exactly the column
                         width. The controls inside it add no horizontal padding
                         of their own, so every card starts on the column's own
                         x. This used to be described in two places at once (here
                         and inside OptionListControl), which stacked 20px on the
                         left of the cards while the breadcrumb above and the
                         footer below kept 12, leaving the cards looking both
                         misaligned and off-centre.

                         Horizontal scrolling stays disabled: left at its
                         default (Enabled/Auto) the ScrollViewer would measure
                         its content against infinite width, giving the column
                         no finite width to be centred within.

                         This ScrollViewer is the ONE scrolling surface for the
                         category page. The ListViews inside it are
                         height-constrained and have their own scrolling turned
                         off (see OptionListControl), because two nested
                         scrollers in one page is what makes a scroll gesture
                         ambiguous and what let a click re-enter layout while a
                         scroll was still settling. One owner, one scrollbar.

                         It follows that the content here is measured at finite
                         height, so an inner ListView cannot virtualise.
                         That cost is bounded by the fold rule: the largest
                         generated section (205 rows) is a folded section, so it
                         reaches this list as one card, not 205 rows. -->
                    <ScrollViewer
                        x:Name="BrowseHost"
                        HorizontalAlignment="Stretch"
                        Margin="{StaticResource MpvBrowseHostMargin}"
                        Padding="{StaticResource MpvBrowseHostPadding}"
                        HorizontalContentAlignment="Stretch"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled">
                        <!-- The fill. The reading measure belongs to the content,
                             not to the scrolling surface, because a ScrollViewer
                             draws its vertical bar at its own right edge: a
                             capped ScrollViewer is a capped bar, pinned 12 DIP
                             from the cards however wide the window gets.

                             The row above therefore spans the whole content area
                             and carries its horizontal inset as PADDING instead
                             of as a margin. Padding insets this presenter and
                             leaves the bar on the ScrollViewer's own edge, so the
                             bar lands on the window's right edge while the column
                             below keeps the breadcrumb's x and its width. A
                             margin would have carried the bar inward with the
                             content, 12 DIP short of the edge, which is what the
                             bar floating in the gap looked like.

                             This Grid exists to hand the column its finite width
                             inside that padded presenter. It carries no cap of
                             its own and Stretches, so the presenter gives it the
                             whole viewport, and the capped panel inside is then
                             centred by ordinary Grid rules.

                             The indirection is not optional. Asking the
                             presenter to centre directly, with
                             HorizontalContentAlignment="Center" on the
                             ScrollViewer, arranges the content at its DESIRED
                             width instead of at its cap: the column came out 722
                             wide and the cards landed at x=856.6 against the
                             breadcrumb's 687.4, which is the original 169 DIP
                             defect back again (both measured maximised). A
                             Stretch child that carries no cap is handed the
                             viewport; nothing else here is.

                             So the cap stays on the panel below and the
                             centring stays on this Grid, in that order. -->
                        <Grid HorizontalAlignment="Stretch">
                            <!-- The reading-width cap, on the content. It used
                                 to be on the ScrollViewer above, which is what
                                 pinned the scrollbar to the cards.

                                 Stretch, not Center. MaxWidth only caps a box:
                                 arranged at Center the panel takes its DESIRED
                                 width, which for this column is the 721.7 its
                                 contents happen to want, and the cards then came
                                 out 169 DIP right of the breadcrumb for a second
                                 time (measured maximised, both ways). Stretch
                                 gives it min(viewport, cap) and the Grid centres
                                 that clamped box, which is the same pair the
                                 breadcrumb row above relies on.

                                 The trailing 12 is this column's own right
                                 inset, kept so the cards hold the width they
                                 were last signed off at now that the scrollbar
                                 no longer needs the room. -->
                            <StackPanel
                                MaxWidth="{StaticResource MpvContentMaxWidth}"
                                Padding="0,0,12,0"
                                HorizontalAlignment="Stretch">
                                <ctl:OptionListControl x:Name="OptionsControl" ShowHeaders="False" />
                                <!-- Scrolling off, like OptionListView inside
                                     the control above. This list is measured at
                                     infinite height by the StackPanel, so
                                     leaving its own ScrollViewer enabled made it
                                     report its viewport height instead of its
                                     content height - the section cards past the
                                     first screenful were then neither drawn nor
                                     included in BrowseHost's scroll extent.
                                     BrowseHost owns the page's only scroll;
                                     every list inside it must decline its
                                     own. -->
                                <ListView
                                    x:Name="SectionsHost"
                                    Margin="0,4,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    SelectionMode="None"
                                    IsItemClickEnabled="False"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.HorizontalScrollMode="Disabled"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ItemContainerStyle="{StaticResource SectionCardListViewItemStyle}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Customize layout: bookmark-manager shape — the folder
                         tree on the left, the cards of the selected folder on
                         the right. Cards are dragged from right to left to file
                         them, and folders are reordered within the tree. -->
                    <Grid
                        x:Name="CustomizeRoot"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Scope notice: this whole mode is presentation-only,
                             and a rename is per-language unless told otherwise.
                             Both facts are easy to get wrong, so they are stated
                             up front rather than buried in a dialog. -->
                        <InfoBar
                            x:Name="CustomizeScopeBar"
                            Grid.Row="0"
                            Margin="12,0,12,8"
                            IsClosable="True"
                            IsOpen="True"
                            Severity="Informational" />

                        <!-- The tree + card pair is capped and centred as one
                             unit, the way the browsing column is. Without this
                             the right column had no cap, so collapsing the
                             sidebar fed all 228px of the freed width into the
                             cards: they grew wider instead of following the
                             sidebar left, which read as the cards "not moving".

                             Capping the pair rather than the card column alone
                             keeps the tree and the cards sharing one centred
                             block, so the pair does not drift apart from the
                             scrollbar at the window edge. -->
                        <Grid
                            x:Name="CustomizeColumn"
                            Grid.Row="1"
                            MaxWidth="{StaticResource MpvContentMaxWidth}"
                            HorizontalAlignment="Stretch"
                            ColumnSpacing="{StaticResource MpvSpaceM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SidebarColumn" Width="272" />
                                <!-- The card column is capped rather than a pure
                                     star. As a bare star it absorbed every pixel
                                     the sidebar gave up, so collapsing the tree
                                     made the cards wider instead of letting the
                                     block recentre; the cards appeared not to
                                     move. Capping it keeps their reading width
                                     constant and lets the pair follow the tree. -->
                                <ColumnDefinition Width="*" MaxWidth="{StaticResource MpvContentMaxWidth}" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: categories (1st level) each holding their
                                 folders (2nd level). Collapsible to the arrow
                                 rail on the far left. -->
                            <Border
                                x:Name="SidebarPanel"
                                Grid.Column="0"
                                Margin="12,4,0,12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Header: caption + "add" button. The
                                         button opens a menu of what can be
                                         added, rather than claiming a single
                                         action it cannot honour. -->
                                    <Grid
                                        Grid.Row="0"
                                        Margin="12,8,8,4"
                                        ColumnSpacing="{StaticResource MpvSpaceCompact}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="TreeTitleText"
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource MpvPopupLabelFontSize}"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            x:Name="AddCategoryButton"
                                            Grid.Column="1"
                                            MinWidth="0"
                                            Padding="{StaticResource MpvCompactButtonPadding}"
                                            Click="AddCategoryButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource MpvSpaceCompact}">
                                                <FontIcon FontSize="14" Glyph="&#xE710;" />
                                                <TextBlock x:Name="AddCategoryButtonText" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="CollapseSidebarButton"
                                            Grid.Column="2"
                                            MinWidth="0"
                                            Padding="{StaticResource MpvCompactButtonPadding}"
                                            Click="CollapseSidebar_Click">
                                            <FontIcon FontSize="14" Glyph="&#xE76B;" />
                                        </Button>
                                    </Grid>

                                    <!-- Hint under the header, so "add" does not
                                         have to explain itself in the caption. -->
                                    <TextBlock
                                        x:Name="TreeHintText"
                                        Grid.Row="1"
                                        Margin="12,0,12,8"
                                        FontSize="{StaticResource MpvTransportTimeFontSize}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        TextWrapping="Wrap" />

                                    <ScrollViewer Grid.Row="2" Padding="4,0,4,8">
                                        <!-- The template is declared against
                                             TreeViewNode, which is what a TreeView
                                             over RootNodes actually hands its
                                             template. Declaring it against the
                                             payload type instead is what crashed the
                                             page: the generated binding component
                                             then hard-casts the TreeViewNode, and
                                             NavigationView's MenuItems.Clear()
                                             re-enters that component with the wrong
                                             object, throwing InvalidCastException.
                                             Content stays typed as object here, so
                                             ToString() is a plain virtual call and
                                             cannot fail. -->
                                        <TreeView
                                            x:Name="FolderTree"
                                            AllowDrop="True"
                                            CanDragItems="True"
                                            CanReorderItems="True"
                                            DragItemsCompleted="FolderTree_DragItemsCompleted"
                                            ItemInvoked="FolderTree_ItemInvoked"
                                            SelectionMode="Single"
                                            SelectionChanged="FolderTree_SelectionChanged">
                                            <TreeView.ItemTemplate>
                                                <DataTemplate x:DataType="TreeViewNode">
                                                    <Grid
                                                        MinHeight="32"
                                                        ColumnSpacing="{StaticResource MpvSpaceS}"
                                                        ContextFlyout="{x:Bind local:TreeHelpers.MenuFor(Content), Mode=OneWay}"
                                                        Opacity="{x:Bind local:TreeHelpers.OpacityFor(Content), Mode=OneWay}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Double-bar drag handle:
                                                             the affordance itself
                                                             signals the row can be
                                                             reordered. -->
                                                        <FontIcon
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Glyph="&#xE76F;"
                                                            ToolTipService.ToolTip="{x:Bind local:TreeHelpers.DragTip(Content), Mode=OneWay}" />
                                                        <FontIcon
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Glyph="{x:Bind local:TreeHelpers.GlyphFor(Content), Mode=OneWay}" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Text="{x:Bind local:TreeHelpers.TextFor(Content), Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <!-- Custom folders only:
                                                             an inline pencil, so the
                                                             rename entry is visible
                                                             instead of hidden in the
                                                             context menu. The button
                                                             carries no text of its
                                                             own, so the rename
                                                             caption is both its
                                                             tooltip and its
                                                             accessible name.
                                                             The padding is not a
                                                             scale step: it is
                                                             sized so this button
                                                             keeps the row height
                                                             of the tree row it
                                                             sits in. -->
                                                        <Button
                                                            Grid.Column="3"
                                                            MinWidth="0"
                                                            Padding="{StaticResource MpvTinyButtonPadding}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            AutomationProperties.Name="{x:Bind local:TreeHelpers.EditTip(Content), Mode=OneWay}"
                                                            Click="EditTreeNode_Click"
                                                            Tag="{x:Bind}"
                                                            ToolTipService.ToolTip="{x:Bind local:TreeHelpers.EditTip(Content), Mode=OneWay}"
                                                            Visibility="{x:Bind local:TreeHelpers.EditVisibility(Content), Mode=OneWay}">
                                                            <FontIcon FontSize="12" Glyph="&#xE70F;" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Collapsed rail: a single arrow that brings the
                                 tree back. Kept in the same column slot so the
                                 right pane does not jump. -->
                            <Button
                                x:Name="ExpandSidebarButton"
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                Margin="12,4,0,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Click="ExpandSidebar_Click"
                                Visibility="Collapsed">
                                <FontIcon FontSize="14" Glyph="&#xE76C;" />
                            </Button>

                            <!-- Right: the cards of whatever is selected on the
                                 left. The pane's caption and its two create
                                 actions live inside the control's own toolbar,
                                 so they share one row instead of the caption
                                 sitting on a row of its own above it.

                                 Wrapped in a ScrollViewer because this pane,
                                 unlike the browsing one, is given a finite
                                 height (a star row of CustomizeHost) and the
                                 list inside declines its own scrolling. Without
                                 a host scroll the rows past the first screenful
                                 were simply unreachable - visible in no state,
                                 scrollable by no gesture. Same shape as
                                 BrowseHost: one scrolling surface, 12px gutter,
                                 no MaxWidth (the pane is already narrower than
                                 the reading column). -->
                            <ScrollViewer
                                Grid.Column="1"
                                Margin="0,4,0,12"
                                Padding="0"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled">
                                <ctl:OptionListControl
                                    x:Name="CustomizeOptionsControl"
                                    ShowHeaders="False" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- The footer row. Two things share it, and they no longer
                     share one column.

                     The status line stays on the reading column: it sits in a
                     box with the same cap and the same centring the cards use,
                     so a confirmation appears under the card it is about. It is
                     the only part of the footer that is page CONTENT.

                     The actions are page-level controls, so they go on the
                     page's own right edge rather than on the column's. The
                     column is a reading measure, not a frame: past the cap it
                     stops growing while the window keeps going, so a control
                     pinned to it drifts away from the edge the user is pointing
                     at. The browse row's scrollbar sits on that same edge, so
                     the buttons and the bar line up on one x.

                     Pinning them is also why they are not a second column of the
                     status line's grid: a star column would stop at the same
                     capped width. They are siblings of the status box inside one
                     full-width row, right-aligned, so the two can only meet if
                     the line grows long enough to reach them, which
                     SettingsPage.UpdateFooterStatusWidth bounds.

                     The footer's 10 of vertical padding is not a scale step: it
                     is the optical match to the breadcrumb row above,
                     vertically centred against the same 32px controls. Its
                     horizontal insets are zero, so the row's content reaches the
                     row's own right edge and the actions land on the window's
                     edge rather than 12 inside it.

                     The Windows settings relationship between a page and its
                     footer is: a status line where there is one, and the
                     actions collected at the end of the row, most consequential
                     last. The browsing footer already ends with the widest
                     scope (重置所有设置 after 重置当前分类) and that order is kept;
                     what was missing is that 自定义 is a different kind of act
                     from either reset. It switches modes, it does not undo
                     anything, so it no longer reads as the first of three
                     identical buttons: its own group, then the divider, then
                     the two resets. The divider is what makes the footer read
                     as groups instead of a row of buttons, and it is the same
                     kind of separator the player's own toolbars use. -->
                <Border
                    x:Name="FooterBorder"
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    Margin="{StaticResource MpvFooterMargin}"
                    Padding="{StaticResource MpvFooterPadding}"
                    BorderThickness="0">
                    <Grid>
                        <!-- Status line: reset confirmations, apply/discard
                             feedback and the unsaved-changes warning share it.
                             Capped and centred like the cards, so it hangs under
                             the card it is about. Stretch plus the cap is what
                             gives it the column's width; Center would give it
                             the width of whatever the message happens to be. -->
                        <Grid
                            MaxWidth="{StaticResource MpvContentMaxWidth}"
                            HorizontalAlignment="Stretch">
                            <TextBlock
                                x:Name="SaveStatusText"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Grid>

                        <StackPanel
                            x:Name="BrowseActions"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="{StaticResource MpvSpaceM}"
                            VerticalAlignment="Center">
                            <!-- Mode switch: one button, on its own. -->
                            <ToggleButton
                                x:Name="CustomizeToggle"
                                MinWidth="96"
                                Click="OnCustomizeToggleClick">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource MpvSpaceS}">
                                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                    <TextBlock x:Name="CustomizeToggleText" />
                                </StackPanel>
                            </ToggleButton>

                            <Border
                                Width="1"
                                Height="20"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- Resets: narrowing scope on the left, widest
                                 last, which is the order Windows settings puts a
                                 page's destructive actions in. -->
                            <Button
                                x:Name="ResetButton"
                                MinWidth="96"
                                Click="OnResetClick" />
                            <Button
                                x:Name="ResetAllButton"
                                MinWidth="96"
                                Click="OnResetAllClick" />
                        </StackPanel>

                        <!-- Customize footer: a different job, so a different
                             set of buttons. Undo/redo step through the session
                             as bare icons; apply keeps what is on screen and
                             exits. There is deliberately no "don't save" button
                             — closing asks the question, and offers discarding
                             as one of its answers. -->
                        <StackPanel
                            x:Name="CustomizeActions"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="{StaticResource MpvSpaceS}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <Button
                                x:Name="CustomizeUndoButton"
                                MinWidth="0"
                                Padding="{StaticResource MpvCompactButtonPadding}"
                                Click="CustomizeUndo_Click">
                                <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                            </Button>
                            <Button
                                x:Name="CustomizeRedoButton"
                                MinWidth="0"
                                Padding="{StaticResource MpvCompactButtonPadding}"
                                Click="CustomizeRedo_Click">
                                <FontIcon FontSize="14" Glyph="&#xE7A6;" />
                            </Button>
                            <Button
                                x:Name="CustomizeApplyButton"
                                MinWidth="116"
                                Click="CustomizeApply_Click">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource MpvSpaceS}">
                                    <FontIcon FontSize="14" Glyph="&#xE73E;" />
                                    <TextBlock x:Name="CustomizeApplyButtonText" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="CustomizeExitButton"
                                MinWidth="96"
                                Click="CustomizeExit_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView.Content>
    </NavigationView>
</Page>
