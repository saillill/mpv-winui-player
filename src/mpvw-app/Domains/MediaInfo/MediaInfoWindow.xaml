<basewin:BaseWindow
    x:Class="mpv_winui.Domains.MediaInfo.MediaInfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:basewin="using:mpv_winui.Infrastructure.Common.View">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            x:Name="WindowTitleText"
            Grid.Row="0"
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            FontSize="{StaticResource MpvShellTitleFontSize}"
            FontWeight="SemiBold" />
        <Grid
            x:Name="ContentHost"
            Grid.Row="1"
            Margin="12,0,0,8" />
    </Grid>
</basewin:BaseWindow>
