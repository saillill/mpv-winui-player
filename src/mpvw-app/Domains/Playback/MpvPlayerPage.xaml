<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="mpv_winui.Domains.Playback.MpvPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bc="using:mpv_winui.Infrastructure.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Domains.Playback"
    xmlns:cards="using:mpv_winui.Domains.Playback.Controls"
    xmlns:lib="using:mpv_winui.Domains.Library"
    xmlns:view="using:mpv_winui.Infrastructure.Common.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pc="using:mpv_winui.Domains.Playback"
    xmlns:preview="using:mpv_winui.Domains.Playback.BuiltInPreview"
    mc:Ignorable="d">

    <Page.Resources>
        <MenuFlyout x:Key="PlaylistContextMenu">
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="play"
                Text="Play">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-top"
                Text="Move to Top">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xF090;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-up"
                Text="Move Up">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70E;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-down"
                Text="Move Down">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="move-bottom"
                Text="Move to Bottom">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xF08E;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="remove"
                Text="Remove">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="copy-title"
                Text="Copy Title">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="copy-path"
                Text="Copy File Path">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE62F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="PlaylistMenu_Click"
                Tag="open-location"
                Text="Open File Location">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!-- A library card, in Fluent's media-tile form: the thumbnail is the
             tile. No card background and no border, because a bordered box
             around a poster is a doubled edge - the picture already has one.
             The hover highlight comes from the Button itself.
             Local to this page on purpose, the way the settings row shell is
             local to OptionListControl: a card shell is not an application-wide
             token, and promoting it into Styles.xaml would invite the next
             screen to restate it slightly differently.
             A Button rather than a Border. The card opens the file it stands
             for, and a Border with a Tapped handler would give that up on the
             keyboard and to a screen reader - the automation name below is what
             a card announces, and without a control to hang it on there would
             be nothing to announce. -->
        <Style x:Key="LibraryCardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- The media area a thumbnail decodes into: 16:9.

             Landscape because that is what the official video grid uses, and because
             the files are landscape - a 16:9 frame cropped into the old 112px square
             lost about half its width, which is what made the thumbnails read as
             zoomed next to the reference.

             Measured from the reference at DPI 1.5: a 379x213 px card is 253x142 DIP,
             with 14 DIP between cards, four columns.

             The height is computed from the card's own width rather than fixed. The
             width belongs to the grid (UniformGridLayout derives the column count from
             MinItemWidth), so a number would be right at one window size and wrong at
             every other - either cropping the picture or opening a gap under it. -->
        <Style x:Key="LibraryCardMediaStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        </Style>

        <view:AspectHeightConverter x:Key="SixteenByNine" Aspect="1.7777777777777777" />

        <view:IndexLetterOpacityConverter x:Key="IndexLetterOpacity" />


        <!-- One letter in the A-Z rail.

             A Button, not a TextBlock with a Tapped handler: it brings keyboard focus,
             a pointer-over state and an automation name, none of which a TextBlock has.
             IsEnabled follows HasContent so an empty letter cannot be clicked at all, and
             the opacity makes that visible - a full-weight letter that does nothing reads
             as broken rather than as empty.

             Tag carries the letter so one handler on the page serves every item. -->
        <DataTemplate x:Key="LibraryIndexLetterTemplate" x:DataType="local:LibraryIndexBucket">
            <Button
                MinHeight="18"
                Padding="0"
                HorizontalAlignment="Stretch"
                AutomationProperties.LabeledBy="{Binding ElementName=IndexLetterText}"
                Background="Transparent"
                BorderThickness="0"
                Click="IndexRailButton_Click"
                IsEnabled="{x:Bind HasContent, Mode=OneTime}"
                PointerEntered="IndexRailLetter_PointerEntered">
                <TextBlock
                    x:Name="IndexLetterText"
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource MpvTransportTimeFontSize}"
                    Opacity="{x:Bind HasContent, Converter={StaticResource IndexLetterOpacity}, Mode=OneTime}"
                    Text="{x:Bind Letter, Mode=OneTime}" />
            </Button>
        </DataTemplate>

        <!-- The album card: a square cover, the album name, then its artist.

             The two captions use {Binding}, NOT {x:Bind}, and that is deliberate. A single
             {x:Bind AlbumTitle} anywhere in this file makes the WindowsAppSDK 2.3.9 XAML
             compiler fail with WMC9999 - an internal error that names no file, no line, and
             does not appear in a 9.6 MB diagnostic log at all. Bisection placed it exactly:
             a byte-copy of the video card compiles, the same copy with one {x:Bind} to this
             property does not, and the property is declared identically to Title.

             {Binding} is resolved at runtime against the DataContext, so no compiled binding
             code is generated for it - the half that crashes. The trade is speed and
             compile-time checking on two text lines, which is worth paying to get the card.

             Because a Binding path is a bare string, a rename would fail silently at
             runtime. These two are the only such paths in the file.

             Every other binding here stays {x:Bind}: those compile, and there is no reason
             to move a working mechanism onto the slower one.

             Square: Height={Binding ActualWidth} with no converter, because a square IS the
             width. The video card needs a converter only for 16:9.

             Element names are prefixed Album* because the overlay code finds its controls by
             name inside whichever template it was handed, and the video card already owns
             CardHoverOverlay / CardPlayButton / CardMoreButton. -->
        <!--  The card control, as an ItemsRepeater template root.

              A template whose root is a typed control is ordinary WinUI, and it
              is what lets ElementPrepared hand the card its entry as an argument
              instead of searching the visual tree for named parts. -->
        <DataTemplate x:Key="LibraryCardControlTemplate">
            <cards:LibraryCard />
        </DataTemplate>


        <!-- The card's overflow menu, one definition shared by every card.
             A MenuFlyout is shown with ShowAt and does not have to live inside
             the item it points at, so keeping it here leaves the item template
             free of command wiring and gives the menu texts a single place to be
             localized (ApplyCardStrings). Items are enabled per target in
             CardMore_Click, the way the playlist pane's own menu is. -->
        <MenuFlyout x:Key="LibraryCardContextMenu">
            <MenuFlyoutItem
                Click="CardMenu_Click"
                Tag="play">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="CardMenu_Click"
                Tag="add-queue">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Add" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="CardMenu_Click"
                Tag="open-location">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="OpenFile" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                Click="CardMenu_Click"
                Tag="copy-path">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Copy" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem
                Click="CardMenu_Click"
                Tag="copy-title">
                <MenuFlyoutItem.Icon>
                    <SymbolIcon Symbol="Copy" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <!-- Enters selection mode. The reference puts it last in the card menu,
                 which is also where this one ends. -->
            <MenuFlyoutItem
                Click="CardMenu_Click"
                Tag="select">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE73A;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!-- The video library's underline tabs.
             A RadioButton rather than a Pivot or a SelectorBar: the project
             depends on neither, and this needs nothing from them, while the
             built-in CheckStates machine already drives the one thing a tab has
             to show - which one is picked. The template drops Fluent's radio
             circle for a text label over a 2px indicator, which is the official
             player's tab shape.
             Only Foreground and Opacity are driven from a state, so
             check-visual-state-layout stays quiet: no negative margins and no
             alignment overrides in any setter. -->
        <Style x:Key="MpvUnderlineTabStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- The template replaces Fluent's, so it does not inherit the
                 default style's focus behaviour: without this the tab has no
                 keyboard-focus indicator at all. The margin tucks the rect up
                 under the label row and off the underline. -->
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="0,0,0,-4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="2" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="TabHover"
                                Grid.RowSpan="2"
                                Background="Transparent"
                                CornerRadius="4" />
                            <ContentPresenter
                                x:Name="TabContent"
                                Grid.Row="0"
                                Margin="0,0,0,7"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border
                                x:Name="TabIndicator"
                                Grid.Row="1"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="1"
                                Opacity="0" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <Setter Target="TabIndicator.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <VisualState.Setters>
                                            <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Setter Target="TabIndicator.Opacity" Value="0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                                <!-- Hover tints the backdrop, never the indicator
                                     or the text colour: those two belong to
                                     CheckStates, and a second group writing the
                                     same property would let a hovered tab drop
                                     its underline. -->
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Target="TabHover.Background" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="TabHover.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="TabHover.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One folder in the "Video folders" tab: the folder name and how many
             played videos it holds. Binds to VideoFolderGroup (see the library
             partial), which is a record the page builds from the history. -->
        <!-- One folder's heading, in the reference player's form: a folder glyph,
             then the name, then the full path dimmed on the same line.

             The path is what tells two folders with the same leaf name apart - the
             grouping already keys on the full directory for exactly that reason, and
             showing only "Downloads" twice was the visible half of that problem.

             The glyph is drawn through a Viewbox at 20: PathIcon renders its geometry
             at the native 24 units, so setting Width alone would clip it.

             PathVisibility is Collapsed for the music library's groups: those are
             built from an album tag, have no path, and must not reserve the grey line
             or every album heading would indent away from the video ones. -->
        <!--  A music group's header: the album's cover, its name, then how many
              tracks it holds.

              Its own template rather than the folder one. The folder header was
              built for a DIRECTORY: a 64x36 landscape cover, the folder name, and
              the folder's full path on a second line. Music groups have no path,
              so they rendered that line as nothing - a tall empty band under every
              album name, and the one line that would have said something useful
              (how many tracks) left blank. That is what "the three tabs read as
              busy and with no clear hierarchy" was pointing at: the header was not
              wrong, it was answering a question nobody asked.

              The cover is square and larger, because an album sleeve is the thing
              you recognise, where a folder thumbnail is a reminder. -->
        <DataTemplate x:Key="MusicGroupHeaderTemplate" x:DataType="lib:VideoFolderGroup">
            <Grid
                Margin="0,16,0,8"
                ColumnSpacing="{StaticResource MpvSpaceM}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    Grid.Column="0"
                    Width="56"
                    Height="56">
                    <Border
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        CornerRadius="4">
                        <PathIcon
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="{x:Bind MediaIcon, Mode=OneTime}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <!--  Both the visibility and the source follow the thumbnail, which
                          arrives after the group is built: a group is created from the
                          entries the scan produced, and those have no picture yet. OneTime
                          would freeze it at the moment of construction, which is the same
                          "cover shows once then goes grey" shape the cards had. -->
                    <Border CornerRadius="4" Visibility="{x:Bind CoverVisibility, Mode=OneWay}">
                        <Image
                            Stretch="UniformToFill"
                            Source="{x:Bind Cover, Mode=OneWay}" />
                    </Border>
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource MpvSpaceXxs}">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name, Mode=OneTime}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--  The count sits at the trailing edge rather than under the name:
                      it is a magnitude, not a subtitle, and a right-aligned column
                      is where the eye finds one. -->
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind CountText, Mode=OneTime}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VideoFolderHeaderTemplate" x:DataType="lib:VideoFolderGroup">
            <Grid
                Margin="0,16,0,8"
                ColumnSpacing="{StaticResource MpvSpaceS}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Two rows: the folder name, then its path on a line of its own. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The folder's cover, with the kind glyph as its fallback.

                     Reported as 视频库应显示大路径 + 分栏文件夹图片样式. Measured before: the folder
                     view's automation tree held ZERO ImageControl elements (a 20 px glyph and
                     text, nothing else), so a folder in which you had watched something looked
                     exactly like one you had not.

                     16:9 at 64x36, because this heads a row of 16:9 video cards and a square
                     tile would read as a different kind of thing. Smaller than a card on
                     purpose: it identifies the group, it is not the thing you click. -->
                <Grid
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    Width="64"
                    Height="36"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                    <Image
                        x:Name="FolderCoverImage"
                        Source="{x:Bind Cover, Mode=OneTime}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind CoverVisibility, Mode=OneTime}" />
                    <Viewbox
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <PathIcon
                            Width="24"
                            Height="24"
                            Data="{x:Bind MediaIcon, Mode=OneTime}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Viewbox>
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Name, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis" />

                <!-- The path on its own line, and larger than it used to be.
                     Reported as 视频文件夹内应显示大路径. Measured before: the name was
                     BodyStrong (~14 px) and the path Caption (~12 px) on the SAME row, so the
                     two read as one run-on label and the path (the only thing that tells two
                     folders called "Downloads" apart) was the quietest element in the header.
                     It now spans the remaining columns on a second row at Subtitle size, which
                     is deliberately larger than the name above it: for a video folder the
                     location is the useful part. -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Margin="0,2,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind Path, Mode=OneTime}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind PathVisibility, Mode=OneTime}" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind CountText, Mode=OneTime}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- The drop target is the PAGE, not VideoContainer.
         It used to be VideoContainer, and the library covers that - so on Home,
         the one page whose empty state is inviting you to open something, a drop
         had nowhere to land. Dragging onto the window is the gesture people
         actually make, so the page takes it and the library is dropped on as
         readily as the video is. -->
    <Grid
        x:Name="PageRoot"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        DragLeave="OnDragLeave"
        DragOver="OnDragOver"
        Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition
                x:Name="MenuRow"
                Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- The menu row, with the playing page's three tool keys at its right
             end.

             They belong HERE and not on the picture: the report was explicit -
             "the position should be at the far right of the settings bar, not
             floating" - and it is also the row that is always on screen while a
             file is up, so nothing has to hover over the video to reach them.
             The floating version that briefly lived over the top-right of the
             picture was both asked against and useless: it sat on the frame and
             had to be hidden over the library, which made three permanent
             actions flicker in and out. -->
        <Grid
            Grid.Row="0"
            ColumnSpacing="{StaticResource MpvSpaceS}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

        <MenuBar
            x:Name="MainMenuBar"
            Grid.Column="0">
            <MenuBarItem
                Title="File"
                IsTabStop="False">
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open"
                    Text="Open File" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-folder"
                    Text="Open Folder" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-url"
                    Text="Open URL" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-clipboard"
                    Text="Open from Clipboard" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-dvd"
                    Text="Open DVD" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-bd"
                    Text="Open Blu-ray" />
                <MenuFlyoutSubItem Text="Open Disc">
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-cdda"
                        Text="Open CD" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-dvda"
                        Text="Open DVDA" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-cd-img"
                        Text="Open CD Img" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-dvd-img"
                        Text="Open DVD Img" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-dvda-img"
                        Text="Open DVDA Img" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-bd-img"
                        Text="Open BD Img" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-watch-history"
                    Text="Open Watch History" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="open-watch-later"
                    Text="Open Watch Later" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="load-subtitle"
                    Text="Add Subtitle" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="screenshot"
                    Text="Screenshot" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="screenshot-no-sub"
                    Text="Screenshot (No Subtitles)" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="restart"
                    Text="Restart" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="quit"
                    Text="Quit" />
            </MenuBarItem>

            <MenuBarItem
                Title="View"
                IsTabStop="False">
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="playlist"
                    Text="Playlist" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="fullwindow"
                    Text="Full Window" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="fullscreen"
                    Text="Full Screen" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="ontop"
                    Text="Always On Top" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="options"
                    Text="Options" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="conf-edit"
                    Text="Mpv Conf Editor" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="edit-menu-mpv"
                    Text="Mpv Menu Editor" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="edit-menu-menubar"
                    Text="Menu Bar Editor" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="conf-folder"
                    Text="Open App Data Folder" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="mpv-folder"
                    Text="Open Mpv Config Folder" />
                <MenuFlyoutSubItem Text="Open">
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-mpv-conf"
                        Text="mpv.conf" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-mpvw-conf"
                        Text="mpvw.conf" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-input-conf"
                        Text="input.conf" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-menu-conf"
                        Text="menu.conf" />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-mpv-log"
                        Text="mpv.log" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Click="MenuFlyoutItem_Click"
                        Tag="open-mpwv-menu-conf"
                        Text="mpvw-menu.conf" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="media-info"
                    Text="Media Info" />
            </MenuBarItem>

            <MenuBarItem
                Title="Help"
                IsTabStop="False">
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="about"
                    Text="About" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="link-mpv-wiki"
                    Text="Mpv Wiki" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="link-mpv-manual"
                    Text="Mpv Manual" />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="link-mpv-manual-stable"
                    Text="Mpv Manual(Stable)" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    Click="MenuFlyoutItem_Click"
                    Tag="link-mpvw-wiki"
                    Text="Mpvw Wiki" />
            </MenuBarItem>
        </MenuBar>

            <!-- The three tool keys, at the far right of the menu row. Same
                 44x44 pitch as the transport buttons, transparent fill so the row
                 keeps one surface, and no scrim: a menu row is already opaque.

                 Each glyph goes through a Viewbox pinned to MpvTransportIconSize.
                 Setting Width/Height on a PathIcon does NOT scale it: PathIcon
                 draws its geometry at the source's native 24 units and the
                 element box only clips. At the 20 this token carries, the three
                 glyphs therefore lost their outer ring - the camera's body, the
                 info circle's circumference and the list's right-hand rules all
                 touched the clip edge - and because their ink fills the 24 grid by
                 different amounts they also looked like three different sizes.
                 The Viewbox is what makes 20 mean 20 and makes all three agree.
                 Every other PathIcon in this app already does this; these three
                 and the OSD capsule were the ones that did not. -->
            <StackPanel
                x:Name="PlaybackTools"
                Grid.Column="1"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <Button
                    x:Name="ScreenshotButton"
                    Width="{StaticResource MpvTransportButtonSize}"
                    Height="{StaticResource MpvTransportButtonSize}"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Click="ScreenshotButton_Click">
                    <Viewbox
                        Width="{StaticResource MpvTransportIconSize}"
                        Height="{StaticResource MpvTransportIconSize}">
                        <PathIcon
                            x:Name="ScreenshotIcon"
                            Width="24"
                            Height="24" />
                    </Viewbox>
                </Button>
                <Button
                    x:Name="MediaInfoButton"
                    Width="{StaticResource MpvTransportButtonSize}"
                    Height="{StaticResource MpvTransportButtonSize}"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Click="MediaInfoButton_Click">
                    <Viewbox
                        Width="{StaticResource MpvTransportIconSize}"
                        Height="{StaticResource MpvTransportIconSize}">
                        <PathIcon
                            x:Name="MediaInfoIcon"
                            Width="24"
                            Height="24" />
                    </Viewbox>
                </Button>
                <Button
                    x:Name="PlaylistPanelButton"
                    Width="{StaticResource MpvTransportButtonSize}"
                    Height="{StaticResource MpvTransportButtonSize}"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Click="PlaylistPanelButton_Click">
                    <Viewbox
                        Width="{StaticResource MpvTransportIconSize}"
                        Height="{StaticResource MpvTransportIconSize}">
                        <PathIcon
                            x:Name="PlaylistPanelIcon"
                            Width="24"
                            Height="24" />
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <!-- The content area is a two-layer stack.
             Layer 0 is the video. It is always Visible and always in the tree,
             because libmpv binds this SwapChainPanel once: detaching it,
             reparenting it or collapsing it all risk breaking playback, and
             nothing about the switch below touches it.
             Layer 1 is the library skeleton, which covers the video with an
             opaque surface while nothing is playing. Covering rather than
             swapping is the whole trick - it means the switch has no opinion
             about layer 0 at all. -->
        <Grid
            x:Name="ContentHost"
            Grid.Row="1"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The stage: everything that fills the window, laid out in the
                 first column so the playlist pane below can take width away
                 from it rather than float over it. -->
            <Grid
                x:Name="StageHost"
                Grid.Column="0">

            <!-- Playback-level messages: a refused drop, a mixed drop that
                 skipped files, and anything else that needs saying without a
                 dialog. An InfoBar rather than a ContentDialog because none of
                 these is a question - the official player reports the same class
                 of problem the same way, and a modal box would block the window
                 the user is about to drop something else onto. -->
            <InfoBar
                x:Name="PlaybackInfoBar"
                Grid.Row="0"
                MaxWidth="560"
                Margin="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Canvas.ZIndex="30"
                IsClosable="True"
                IsOpen="False" />

            <!-- No drop handlers here any more: the page owns them now (see
                 PageRoot). VideoContainer keeps its dark tint so a letterboxed
                 picture still has a defined edge inside the swap chain. -->
            <Grid
                x:Name="VideoContainer"
                Background="{ThemeResource SmokeFillColorDefaultBrush}">
                <SwapChainPanel
                    x:Name="PlayerView"
                    ContextRequested="PlayerView_ContextRequested">
                    <Border Background="Transparent" />
                </SwapChainPanel>
                <preview:MpvSoftwarePreviewControl
                    x:Name="MpvPreview"
                    Width="192"
                    Height="108"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    x:Load="{x:Bind _enableBuiltInPreview, Mode=OneTime}"
                    Canvas.ZIndex="2"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <preview:MpvSoftwarePreviewControl.RenderTransform>
                        <TranslateTransform x:Name="PreviewControlTranslation" />
                    </preview:MpvSoftwarePreviewControl.RenderTransform>
                </preview:MpvSoftwarePreviewControl>

                <!--  The transient message capsule.

                      This is where mpv's own OSD text used to appear. Turning
                      that off and drawing nothing would have lost the only
                      feedback for a volume key, a speed change, a track switch or
                      a seek - all of which are silent otherwise, because the
                      picture is the only thing on screen.

                      A pill rather than a text line for two reasons: the app has
                      no ambient typography over the video (so a bare string would
                      have no contrast against an arbitrary frame), and the
                      reference players all present this as one centred badge
                      rather than as corner text.

                      Top-centre, not the OSD's own top-left: the app's own
                      PlaybackInfoBar lives at the bottom-right, and the two must
                      not be able to overlap when a drop is refused mid-playback.

                      IsHitTestVisible is false throughout. It sits over the swap
                      chain, and a badge that ate clicks would make the middle of
                      the picture dead for as long as a message was up. -->
                <Border
                    x:Name="OsdCapsule"
                    Margin="0,24,0,0"
                    Padding="18,9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{StaticResource MpvOsdCapsuleBrush}"
                    Canvas.ZIndex="20"
                    CornerRadius="18"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Visibility="Collapsed">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{StaticResource MpvSpaceS}">
                        <!--  A PathIcon, not a FontIcon: the capsule's glyphs come
                              from FluentIcons, which hands out path data. Drawing
                              them with the icon font would mean keeping a parallel
                              codepoint table for a handful of symbols.

                              Through a Viewbox for the same reason as the menu
                              row's three: PathIcon draws at its source's native 24
                              units, so the 16 this used to set only clipped the
                              glyph. The capsule showed whatever fitted inside the
                              clip, which is why the play triangle looked like a
                              fragment rather than a play mark. -->
                        <Viewbox
                            Width="{StaticResource MpvOsdCapsuleIconSize}"
                            Height="{StaticResource MpvOsdCapsuleIconSize}"
                            VerticalAlignment="Center">
                            <PathIcon
                                x:Name="OsdCapsuleIcon"
                                Width="24"
                                Height="24"
                                Foreground="{StaticResource MpvCardRingBrush}"
                                Visibility="Collapsed" />
                        </Viewbox>
                        <TextBlock
                            x:Name="OsdCapsuleText"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource MpvOsdCapsuleFontSize}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource MpvCardRingBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid
                x:Name="LibraryHost"
                Canvas.ZIndex="1"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="{StaticResource MpvBreadcrumbBarMargin}">
                    <!-- The heading keeps its explicit 40 / SemiBold.
                         Measured against the official player's own window, the
                         two headings' ink is IDENTICAL - 38.9 DIP of cap height
                         on both, at 175% scaling. (An earlier reading of 68.6
                         for ours was the heading and the subtitle measured as
                         one band; they are two lines 13.1 DIP apart, and
                         separating them is what showed the sizes already
                         agreed.) So this is not the number to change: what
                         disagreed was the left inset and the vertical offset,
                         and those are the gutter and the margin around it. -->
                    <!-- The heading row: the title, then the section's own tabs
                         on the same baseline, then the section's top-right
                         command.

                         The official player puts them together like this - the
                         tabs belong to the heading, not to a toolbar under it -
                         and splitting them over two rows is what made the video
                         library read as a page with two unrelated headers. -->
                    <Grid ColumnSpacing="{StaticResource MpvSpaceL}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="LibrarySectionTitle"
                            Grid.Column="0"
                            Margin="6,0,0,0"
                            VerticalAlignment="Bottom"
                            FontSize="{StaticResource MpvPageHeadingFontSize}"
                            FontWeight="SemiBold"
                            Style="{StaticResource TitleTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />

                        <!-- The tabs, on the heading's own baseline. -->
                        <StackPanel
                            x:Name="LibraryHeadingTabs"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,6"
                            Orientation="Horizontal"
                            Spacing="24"
                            Visibility="Collapsed">
                            <RadioButton
                                x:Name="VideoTabAll"
                                Checked="VideoTabAll_Checked"
                                GroupName="VideoLibraryTabs"
                                IsChecked="True"
                                Style="{StaticResource MpvUnderlineTabStyle}" />
                            <RadioButton
                                x:Name="VideoTabFolders"
                                Checked="VideoTabFolders_Checked"
                                GroupName="VideoLibraryTabs"
                                Style="{StaticResource MpvUnderlineTabStyle}" />
                        </StackPanel>

                        <!-- The music library's tabs: Songs / Albums / Artists,
                             the three the official player offers. Hidden unless the
                             music section is up, in ApplySectionHeader. -->
                        <StackPanel
                            x:Name="MusicHeadingTabs"
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,6"
                            Orientation="Horizontal"
                            Spacing="24"
                            Visibility="Collapsed">
                            <RadioButton
                                x:Name="MusicTabSongs"
                                Checked="MusicTabSongs_Checked"
                                GroupName="MusicLibraryTabs"
                                IsChecked="True"
                                Style="{StaticResource MpvUnderlineTabStyle}" />
                            <RadioButton
                                x:Name="MusicTabAlbums"
                                Checked="MusicTabAlbums_Checked"
                                GroupName="MusicLibraryTabs"
                                Style="{StaticResource MpvUnderlineTabStyle}" />
                            <RadioButton
                                x:Name="MusicTabArtists"
                                Checked="MusicTabArtists_Checked"
                                GroupName="MusicLibraryTabs"
                                Style="{StaticResource MpvUnderlineTabStyle}" />
                        </StackPanel>

                        <!-- The section's top-right command: Add folder, which the
                             official player keeps on the heading row. -->
                        <Button
                            x:Name="VideoAddFolderButton"
                            Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Click="VideoAddFolder_Click">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="{StaticResource MpvSpaceS}">
                                <Viewbox
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center">
                                    <PathIcon
                                        x:Name="VideoAddFolderIcon"
                                        Width="24"
                                        Height="24" />
                                </Viewbox>
                                <TextBlock
                                    x:Name="VideoAddFolderText"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock
                        x:Name="LibrarySectionSubtitle"
                        Margin="0,8,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />

                    <!-- The video library's chrome: the All videos / Video
                         folders tabs, then the toolbar (Play all on the left,
                         the sort on the right, Add folder in the top-right
                         corner of the strip). Collapsed for every other
                         section, from ApplySectionHeader. Labels and icons are
                         set in code, from AppLang and FluentIcons. -->
                    <StackPanel
                        x:Name="VideoChrome"
                        Margin="0,16,0,0"
                        Spacing="{StaticResource MpvSpaceM}"
                        Visibility="Collapsed">
                        <!-- The tabs and the Add folder command moved up to the heading row, where
                             the official player keeps them. What stays here is the
                             row's own content: Play all on the left, the sort on
                             the right. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="VideoPlayAllButton"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Click="VideoPlayAll_Click"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource MpvSpaceS}">
                                    <Viewbox
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center">
                                        <PathIcon
                                            x:Name="VideoPlayAllIcon"
                                            Width="24"
                                            Height="24" />
                                    </Viewbox>
                                    <TextBlock
                                        x:Name="VideoPlayAllText"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!--  The music section's own left-hand command, in the same
                                  row and the same place as Play all: 「音乐库也要有和视频库
                                  一样的上方按钮」. Shuffle rather than Play all, because a
                                  whole music library is played in a random order - there
                                  is no meaningful "first track" for a flat list.

                                  Hidden by ApplyVideoChromeVisibility for every section
                                  but music, so the two commands never appear together. -->
                            <Button
                                x:Name="MusicShuffleAllButton"
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                Click="MusicShuffleAll_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="Collapsed">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource MpvSpaceS}">
                                    <Viewbox
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center">
                                        <PathIcon
                                            x:Name="MusicShuffleAllIcon"
                                            Width="24"
                                            Height="24" />
                                    </Viewbox>
                                    <TextBlock
                                        x:Name="MusicShuffleAllText"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>


                            <DropDownButton
                                x:Name="VideoSortButton"
                                Grid.Column="1"
                                Padding="8,4"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0">
                                <DropDownButton.Flyout>
                                    <!-- Placement=Bottom: 「应该向下弹出」. Without it
                                         the flyout picks its own side, which for a
                                         button near the top of a list can be Up. -->
                                    <MenuFlyout Placement="Bottom">
                                        <RadioMenuFlyoutItem
                                            x:Name="SortByNameAsc"
                                            Click="VideoSort_Click"
                                            GroupName="VideoSort"
                                            Tag="name-asc" />
                                        <RadioMenuFlyoutItem
                                            x:Name="SortByNameDesc"
                                            Click="VideoSort_Click"
                                            GroupName="VideoSort"
                                            Tag="name-desc" />
                                        <RadioMenuFlyoutItem
                                            x:Name="SortByNewest"
                                            Click="VideoSort_Click"
                                            GroupName="VideoSort"
                                            Tag="newest" />
                                        <RadioMenuFlyoutItem
                                            x:Name="SortByOldest"
                                            Click="VideoSort_Click"
                                            GroupName="VideoSort"
                                            Tag="oldest" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>
                    </StackPanel>

                    <!-- The selection bar.

                         It is a child of THIS header StackPanel, not of LibraryHost's
                         content row, and that is the fix for "the bar covers the
                         heading". The header is Grid.Row="0" with Height="Auto", so a
                         bar in it takes its own space and the row below moves down. As a
                         direct child of the content row with VerticalAlignment="Top" it
                         drew OVER the topmost group heading: in the task 6 screenshot the
                         words for the group's title sat half behind the count and the
                         clear button. A child of an Auto row cannot reach into the next
                         row, so the overlap is gone by construction rather than by a
                         number.

                         It has no horizontal margin of its own, so it takes the 32 DIP
                         gutter this StackPanel already carries and lines up with the
                         heading, the subtitle and the cards. It used to carry
                         Margin="48,0,48,8", which put its left edge 16 DIP inside every
                         other left edge on the page.

                         While it is up it REPLACES VideoChrome (Play all and the sort):
                         the reference's toolbar stands where that row was, and Play all
                         over a subset of the list is an action about a different set of
                         files. That rule lives in ApplyVideoChromeVisibility. -->
                    <Border
                        x:Name="LibrarySelectionBar"
                        Margin="0,16,0,0"
                        Padding="16,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Translation="0,0,32"
                        Visibility="Collapsed">
                        <!--  The bar floats above the grid, so it gets a shadow -
                              「勾选后出现的横向选项框的阴影」. ThemeShadow needs the
                              Translation above to have anything to project onto: a Z
                              of 0 keeps it in the cards' own plane and draws nothing.
                              32 is the depth the player's artwork border already uses
                              (MusicArtwork), so the app has one shadow depth rather
                              than a new number per surface. -->
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Grid ColumnSpacing="{StaticResource MpvSpaceM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="{StaticResource MpvSpaceS}">
                                <FontIcon
                                    FontSize="{StaticResource MpvInlineIconSize}"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE73E;" />
                                <TextBlock
                                    x:Name="LibrarySelectionCount"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                                <Button
                                    Padding="4,0"
                                    AutomationProperties.LabeledBy="{Binding ElementName=LibrarySelectionClearText}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="SelectionClear_Click">
                                    <TextBlock
                                        x:Name="LibrarySelectionClearText"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </Button>
                            </StackPanel>

                            <!-- The actions, in the reference's order: play (accent), add
                                 to the play queue, the queue itself, then the two
                                 drop-downs. 队列 reuses the glyph the navigation pane
                                 already gives the queue, so the two affordances for one
                                 place wear one mark. -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="{StaticResource MpvSpaceS}">
                                <Button
                                    x:Name="SelectionPlayButton"
                                    Padding="{StaticResource MpvActionButtonPadding}"
                                    Click="SelectionPlay_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource MpvSpaceS}">
                                        <FontIcon
                                            FontSize="{StaticResource MpvInlineIconSize}"
                                            Glyph="&#xE768;" />
                                        <TextBlock
                                            x:Name="SelectionPlayText"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="SelectionQueueButton"
                                    Padding="{StaticResource MpvActionButtonPadding}"
                                    Click="SelectionQueue_Click">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource MpvSpaceS}">
                                        <FontIcon
                                            FontSize="{StaticResource MpvInlineIconSize}"
                                            Glyph="&#xE710;" />
                                        <TextBlock
                                            x:Name="SelectionQueueText"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="SelectionShowQueueButton"
                                    Padding="{StaticResource MpvActionButtonPadding}"
                                    Click="SelectionShowQueue_Click">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource MpvSpaceS}">
                                        <FontIcon
                                            FontSize="{StaticResource MpvInlineIconSize}"
                                            Glyph="&#xEA37;" />
                                        <TextBlock
                                            x:Name="SelectionShowQueueText"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <!-- The flyout is EMPTY here on purpose: its items are
                                     built in SelectionAddTo_Opening, because what it
                                     lists (the named playlists) changes while the page
                                     is up and a list frozen at parse time would be a
                                     copy that drifts. -->
                                <DropDownButton
                                    x:Name="SelectionAddToButton"
                                    Padding="{StaticResource MpvActionButtonPaddingTight}">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Opening="SelectionAddTo_Opening" />
                                    </DropDownButton.Flyout>
                                    <TextBlock
                                        x:Name="SelectionAddToText"
                                        VerticalAlignment="Center" />
                                </DropDownButton>
                                <DropDownButton
                                    x:Name="SelectionMoreButton"
                                    Padding="{StaticResource MpvActionButtonPaddingTight}">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <!-- What used to be a button of its own in
                                                 this bar. Same action, same key; the
                                                 reference keeps it under 更多. -->
                                            <MenuFlyoutItem
                                                x:Name="SelectionPropertiesItem"
                                                Click="SelectionProperties_Click" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                    <TextBlock
                                        x:Name="SelectionMoreText"
                                        VerticalAlignment="Center" />
                                </DropDownButton>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <ScrollViewer
                    x:Name="LibraryScroll"
                    Grid.Row="1"
                    Padding="{StaticResource MpvBrowseHostPadding}"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto"
                    >
                    <Grid>
                        <ItemsRepeater
                            x:Name="LibraryGrid"
                            ItemTemplate="{StaticResource LibraryCardControlTemplate}">
                            <ItemsRepeater.Layout>
                                <!-- Landscape cards. MinItemWidth 214 is CellWidthFor(202):
                                     the report's 0.8 x the reference's 253, plus the 6 DIP
                                     frame gutter on both sides - the grid clips anything
                                     drawn outside the cell. MinItemHeight 184 is
                                     CellHeightFor(202, 16:9) rounded up: 113.6 of tile, 12 of
                                     gutter, 58 of caption band (6 gap + 22 title + 19
                                     subtitle + 11 trailing). The two numbers are one
                                     arithmetic in two places; CardMetrics' unit test pins the
                                     tokens and CardMetricsTests pins these two literals, so do
                                     not change one without the other. The spacings are
                                     literals for the same reason (CardMetrics is internal
                                     static): 4, because 「卡片与卡片之间间距太宽，应该紧密挨着」.

                                     The music library's Songs tab swaps this for the square
                                     layout in code (see ApplyLibraryFilter): a square sleeve
                                     in a 16:9 cell left the tile filling the height and the
                                     captions falling outside the cell, so the rows showed a
                                     picture and no title at all.

                                     Kept here rather than assigned in code because this is
                                     the default every other section uses, and a Grid with no
                                     Layout at all renders nothing. -->
                                <UniformGridLayout
                                    MinColumnSpacing="1"
                                    MinItemHeight="195"
                                    MinItemWidth="234"
                                    MinRowSpacing="4" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>

                        <!-- The "Video folders" tab: one header and one card
                             grid per folder, built in code because the groups
                             change shape as the list does. Exactly one of the
                             two is visible at a time (ApplyLibraryFilter). -->
                        <StackPanel
                            x:Name="VideoFolderGroups"
                            Visibility="Collapsed" />

                        <!-- The named playlists, as rows rather than cards.

                             A .m3u is neither audio nor a video clip: MediaKinds
                             has no branch for it and CardMetrics has no aspect
                             for it, so a card grid would draw a blank fallback
                             tile per list. A list is a name, a count and two
                             verbs, which is a row.

                             Built in code (BuildPlaylistRows) because the rows
                             are files on disk and change without this page
                             reloading. -->
                        <StackPanel
                            x:Name="PlaylistsHost"
                            Spacing="{StaticResource MpvSpaceXs}"
                            Visibility="Collapsed" />
                    </Grid>
                </ScrollViewer>

                <!-- The A-Z rail, in its own column so it does not scroll away.

                     A sibling of the ScrollViewer rather than a child: a jump list you
                     have to scroll to find is not a jump list.

                     Built in code from LibraryIndexLetter.BuildRail - the same table the
                     grouping sorts by - so the letters cannot disagree with the groups
                     they point at. Shown only for the music library's grouped tabs; the
                     video library groups by directory, which has no initial.

                     Items are LibraryIndexBucket, whose HasContent drives both IsEnabled
                     and the dim, so an empty letter cannot be clicked and does not look
                     clickable. -->
                <ItemsRepeater
                    x:Name="LibraryIndexRail"
                    Grid.Row="1"
                    Width="40"
                    Margin="0,0,6,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />

                <!-- The empty state is one centred block, which is what the
                     official player does: measured, its illustration-plus-text
                     pair centres within 2.1 DIP of the content column's own
                     centre. So it does NOT take the page gutter - a gutter is
                     for left-aligned text and this is not left-aligned. What it
                     does share with the heading is the type: the title is the
                     same ramp step and the description the same Body, so the
                     two blocks read as one page rather than two designs. -->
                <Grid
                    x:Name="LibraryEmptyState"
                    Grid.Row="1"
                    MaxWidth="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <!-- A two-column GRID, not a horizontal StackPanel.
                         The StackPanel sized its two columns from their content,
                         so every section's empty state had a different
                         icon-to-text column split - the illustration is 264 in
                         all of them, but the text column was as wide as the
                         longest wrapped line of THAT section's description. With
                         the pair centred, that moved the illustration left and
                         right and the text's first character with it, a few DIP
                         on every section change. That is the reported "the big
                         icon and the description are not aligned the same way on
                         every page, and they jump around when you switch".
                         A fixed 264 + gap + fixed text column means every
                         section renders in exactly the same box: the icon's left
                         edge, the text's left edge and both baselines are
                         section-independent by construction. -->
                    <!-- Literals, not the MpvSpace* tokens: ColumnDefinition
                         Width is a GridLength and those tokens are x:Double, so
                         a StaticResource through it throws inside the XAML
                         loader. Here that was not even visible as a crash - the
                         page failed to load, MainWindow.Open's catch swallowed
                         it, and the Frame stayed blank. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="264" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <!-- The official player's empty state is a large gradient
                         illustration beside the text, not a grey glyph above
                         it, and this is the same idea built from the same
                         official icon set: the section's own media icon, at
                         illustration size, in the sampled brand gradient (see
                         MpvEmptyStateIconBrush). Which icon it is depends on
                         the section, so Data is set in code - see
                         ApplyEmptyStateContent. The text column keeps the
                         official left alignment; only the pair as a whole is
                         centred in the room. -->
                    <!-- PathIcon draws its geometry at native size; the
                         Viewbox is what gives the glyph its size at all
                         (without it a 24-unit glyph renders ~24px in the
                         corner of the box). 216 = the 24 grid at 9x - the
                         user asked for at least 1.5x over the previous 144,
                         and the jump is meant to be unmistakable. -->
                    <Viewbox
                        Grid.Column="0"
                        Width="264"
                        Height="264"
                        VerticalAlignment="Center">
                        <PathIcon
                            x:Name="LibraryEmptyIcon"
                            Width="24"
                            Height="24"
                            Foreground="{StaticResource MpvEmptyStateIconBrush}" />
                    </Viewbox>
                    <StackPanel
                        Grid.Column="2"
                        Spacing="{StaticResource MpvSpaceM}"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="LibraryEmptyTitle"
                            Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="LibraryEmptyDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="LibraryOpenFileButton"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.LabeledBy="{Binding ElementName=LibraryOpenFileButtonText}"
                            Click="LibraryOpenFileButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <!-- The official puts the affordance's own icon in
                                 the button; the label alone made it read as a
                                 generic dialog action. -->
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="{StaticResource MpvSpaceS}">
                                <Viewbox
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center">
                                    <PathIcon
                                        x:Name="LibraryOpenFileIcon"
                                        Width="24"
                                        Height="24" />
                                </Viewbox>
                                <TextBlock
                                    x:Name="LibraryOpenFileButtonText"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- The play queue. A third surface in the slot the grid and
                     the empty state share, and it draws the very same mpv
                     playlist the right-hand pane and the tab strip draw
                     (PlaylistItems), so all three are one collection reported
                     three ways. Only the queue section renders it; the rest of
                     the library never does. -->
                <Grid
                    x:Name="QueueHost"
                    Grid.Row="1"
                    Margin="{StaticResource MpvBrowseHostPadding}"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Clear and Add to, the two actions the official queue
                         offers. The words are set from AppLang in code so a
                         language change reaches them like every other string;
                         the icons are stock Symbol glyphs, which is why each
                         AppBarButton carries no FontIcon of its own.

                         The two buttons are wrapped in ONE bordered card rather
                         than sitting bare on the surface, which is both what the
                         official queue does and what was reported missing: two
                         text-plus-icon pairs floating on the page read as
                         leftovers from a toolbar, not as a control.

                         Margin is the page gutter on BOTH sides, so this row
                         lines up with the heading above it exactly - "the queue
                         buttons are not aligned with the queue heading, and they
                         sit too close to the navigation pane" was the left
                         margin being 0 while everything else on the page starts
                         at MpvContentGutter.

                         The dashed outline the report put around them is not
                         reproduced: that was an annotation on the screenshot,
                         not a design element. -->


                    <!-- Clear and Add to, as the official queue draws them: two
                         separate outlined pill buttons, each with a glyph and a
                         label, sitting side by side.

                         They were a CommandBar inside one shared card. That is not
                         the official control at all - a CommandBar collapses to
                         an overflow menu as it narrows, treats its items as
                         toolbar entries rather than as buttons, and the card
                         around the pair made one wide box where the official has
                         two pills with a gap. Reported as "these two are not the
                         official style, they are drawn by hand and the styling is
                         a mess", which was right.

                         Buttons, then, with the standard control chrome doing the
                         work: no custom template, no card, no CommandBar. -->
                    <!-- A three-column Grid, not one StackPanel: the queue needs a
                         right-aligned 添加文件 the way every library section has one in the
                         top right corner. Measured before this: the queue exposed only
                         QueueClearButton at x=936 and QueueAddToButton at x=1087, both
                         hard against the left gutter, and nothing on the right at all.
                         Reported as 播放队列也应有右上角"添加文件"按钮. -->
                    <Grid
                        Grid.Row="0"
                        Margin="0,0,0,12"
                        ColumnSpacing="{StaticResource MpvSpaceS}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="QueueClearButton"
                            Padding="{StaticResource MpvActionButtonPaddingTight}"
                            Click="QueueClear_Click">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="{StaticResource MpvSpaceS}">
                                <Viewbox
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center">
                                    <PathIcon
                                        x:Name="QueueClearIcon"
                                        Width="24"
                                        Height="24" />
                                </Viewbox>
                                <TextBlock
                                    x:Name="QueueClearText"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="QueueAddToButton"
                            Grid.Column="1"
                            Padding="{StaticResource MpvActionButtonPaddingTight}"
                            Click="QueueAddTo_Click">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="{StaticResource MpvSpaceS}">
                                <Viewbox
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center">
                                    <PathIcon
                                        x:Name="QueueAddToIcon"
                                        Width="24"
                                        Height="24" />
                                </Viewbox>
                                <TextBlock
                                    x:Name="QueueAddToText"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- The queue's own 添加文件, right aligned like the library's
                             添加文件夹. Same shape as its neighbours: glyph plus label, text
                             set from AppLang in code so it localizes. -->
                        <Button
                            x:Name="QueueOpenFileButton"
                            Grid.Column="3"
                            Padding="{StaticResource MpvActionButtonPaddingTight}"
                            Click="QueueOpenFile_Click">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="{StaticResource MpvSpaceS}">
                                <Viewbox
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center">
                                    <PathIcon
                                        x:Name="QueueOpenFileIcon"
                                        Width="24"
                                        Height="24" />
                                </Viewbox>
                                <TextBlock
                                    x:Name="QueueOpenFileText"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView
                        x:Name="QueueView"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        ContextRequested="QueueView_ContextRequested"
                        IsItemClickEnabled="True"
                        ItemClick="QueueView_ItemClick"
                        ItemsSource="{x:Bind PlaylistItems, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style
                                BasedOn="{StaticResource DefaultListViewItemStyle}"
                                TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PlaylistItem">
                                <Grid Height="44">
                                    <!-- The current row's highlight sits behind
                                         the content, and the accent play glyph
                                         in the icon column is the now-playing
                                         marker the official queue puts on the
                                         row that is on air. -->
                                    <Border
                                        Margin="8,1"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind IsCurrent, Mode=OneTime}" />
                                    <Grid
                                        Margin="12,0"
                                        ColumnSpacing="{StaticResource MpvSpaceM}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            FontSize="16"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE768;"
                                            Visibility="{x:Bind IsCurrent, Mode=OneTime}" />
                                        <FontIcon
                                            Grid.Column="0"
                                            FontSize="16"
                                            Glyph="&#xE8B2;"
                                            Visibility="{x:Bind bc:BindConvertor.InvertVisibility(IsCurrent), Mode=OneTime}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Filename, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Path, Mode=OneTime}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DurationText, Mode=OneTime}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- The empty queue, the same shape the other sections use
                         for an empty state. Its words are Home's empty strings
                         (nothing has been played yet describes both), and the
                         toolbar above stays reachable, so Add to is still there
                         when the queue has nothing in it. -->
                    <Grid
                        x:Name="QueueEmptyState"
                        Grid.Row="1"
                        MaxWidth="640"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="216" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <Viewbox
                            Grid.Column="0"
                            Width="216"
                            Height="216"
                            VerticalAlignment="Center">
                            <PathIcon
                                x:Name="QueueEmptyIcon"
                                Width="24"
                                Height="24"
                                Foreground="{StaticResource MpvEmptyStateIconBrush}" />
                        </Viewbox>
                        <StackPanel
                            Grid.Column="2"
                            Spacing="{StaticResource MpvSpaceM}"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="QueueEmptyTitle"
                                Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="QueueEmptyDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- The album page.

                 The reference player's album view: the cover and the album's
                 identity in one card at the top, its action row under it, then the
                 track table. Reached from the music library's Albums tab; it is a
                 surface in this page rather than a Page in the frame, because
                 libmpv binds the SwapChainPanel once and a Frame navigation
                 detaches it.

                 Canvas.ZIndex 3 puts it above both the library and the music
                 page: it is opened from the library, and closing it must reveal
                 whichever surface was underneath. -->
            <Grid
                x:Name="AlbumHost"
                Canvas.ZIndex="3"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="{StaticResource MpvBreadcrumbBarMargin}">

                    <!-- Back to the list. A plain button rather than a breadcrumb
                         control: the album is one level deep and the reference
                         player draws the same single chevron here. -->
                    <Button
                        x:Name="AlbumBackButton"
                        Margin="0,0,0,16"
                        Padding="8,4"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="AlbumBack_Click">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="{StaticResource MpvSpaceS}">
                            <FontIcon
                                FontFamily="{StaticResource MpvIconFontFamily}"
                                FontSize="14"
                                Glyph="&#xE72B;" />
                            <TextBlock
                                x:Name="AlbumBackText"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Button>

                    <!-- The album card: cover on the left, identity and actions on
                         the right, as one rounded surface. -->
                    <Grid
                        Padding="20"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        ColumnSpacing="24"
                        CornerRadius="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            Grid.Column="0"
                            Width="200"
                            Height="200">
                            <Border
                                Background="{ThemeResource MpvMusicArtworkFallbackBrush}"
                                CornerRadius="8">
                                <FontIcon
                                    x:Name="AlbumArtworkFallbackIcon"
                                    FontSize="64"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Border>
                            <Border CornerRadius="8">
                                <Image
                                    x:Name="AlbumArtwork"
                                    Stretch="UniformToFill"
                                    Visibility="Collapsed" />
                            </Border>
                        </Grid>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="{StaticResource MpvSpaceS}">
                            <TextBlock
                                x:Name="AlbumDetailTitle"
                                FontSize="30"
                                FontWeight="SemiBold"
                                MaxLines="2"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Name="AlbumArtist"
                                FontSize="{StaticResource MpvShellTitleFontSize}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock
                                x:Name="AlbumSummary"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />

                            <StackPanel
                                Margin="0,12,0,0"
                                Orientation="Horizontal"
                                Spacing="{StaticResource MpvSpaceS}">
                                <Button
                                    x:Name="AlbumPlayAllButton"
                                    Padding="{StaticResource MpvActionButtonPadding}"
                                    Click="AlbumPlayAll_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource MpvSpaceS}">
                                        <FontIcon
                                            FontFamily="{StaticResource MpvIconFontFamily}"
                                            FontSize="14"
                                            Glyph="&#xF605;" />
                                        <TextBlock
                                            x:Name="AlbumPlayAllText"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="AlbumShuffleButton"
                                    Padding="{StaticResource MpvActionButtonPadding}"
                                    Click="AlbumShuffle_Click">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource MpvSpaceS}">
                                        <FontIcon
                                            FontFamily="{StaticResource MpvIconFontFamily}"
                                            FontSize="14"
                                            Glyph="&#xE8B1;" />
                                        <TextBlock
                                            x:Name="AlbumShuffleText"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="AlbumAddToButton"
                                    Padding="{StaticResource MpvActionButtonPadding}"
                                    Click="AlbumAddTo_Click">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource MpvSpaceS}">
                                        <FontIcon
                                            FontFamily="{StaticResource MpvIconFontFamily}"
                                            FontSize="14"
                                            Glyph="&#xF109;" />
                                        <TextBlock
                                            x:Name="AlbumAddToText"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <ScrollViewer
                    Grid.Row="1"
                    Padding="{StaticResource MpvBrowseHostPadding}"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto">
                    <StackPanel>
                        <!-- Column headings, then one row template. A ListView
                             rather than an ItemsRepeater because rows are clicked
                             and the current one is highlighted. -->
                        <Grid
                            Padding="12,0"
                            ColumnSpacing="{StaticResource MpvSpaceL}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="160" />
                                <ColumnDefinition Width="2*" MinWidth="120" />
                                <ColumnDefinition Width="2*" MinWidth="120" />
                                <ColumnDefinition Width="Auto" MinWidth="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="AlbumColumnTitle"
                                Grid.Column="0"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock
                                x:Name="AlbumColumnArtist"
                                Grid.Column="1"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock
                                x:Name="AlbumColumnGenre"
                                Grid.Column="2"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock
                                x:Name="AlbumColumnLength"
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>

                        <TextBlock
                            x:Name="AlbumEmptyText"
                            Margin="12,24,12,0"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <ListView
                            x:Name="AlbumTrackList"
                            Background="Transparent"
                            BorderThickness="0"
                            IsItemClickEnabled="True"
                            ItemClick="AlbumTrackList_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style
                                    BasedOn="{StaticResource DefaultListViewItemStyle}"
                                    TargetType="ListViewItem">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:LibraryEntry">
                                    <Grid
                                        Height="44"
                                        ColumnSpacing="{StaticResource MpvSpaceL}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="160" />
                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                            <ColumnDefinition Width="2*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" MinWidth="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Title, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Artist, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Genre, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind DurationText, Mode=OneWay}"
                                            Visibility="{x:Bind DurationVisibility, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- The music page.

                 A page of its own rather than the video page with black bars:
                 audio has no frame to letterbox, so everything the video surface
                 shows - the swap chain, the zoom/aspect keys, the overlay
                 transport for fullscreen - is dead weight there. This is the
                 layout the reference players use: artwork on the left, the track
                 and its artist on the right, lyrics under them, and the transport
                 bar shared with the video page underneath.

                 It covers the video layer exactly like LibraryHost does, so
                 neither ever unmounts the SwapChainPanel: libmpv binds that panel
                 once and detaching it breaks playback. -->
            <Grid
                x:Name="MusicHost"
                Canvas.ZIndex="2"
                Background="{ThemeResource MpvMusicPageBrush}"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The page wash: the cover's own colour, darkened, over the
                     whole surface. This is what makes the page belong to the
                     album instead of being a picture pasted on a neutral
                     background, and it is why the extractor exists.

                     It replaced an oversized blurred copy of the cover. That read
                     as two pictures layered; a flat tint in the cover's hue reads
                     as one surface, costs one Fill instead of a scaled Image, and
                     leaves the artwork as the only sharp thing on screen.

                     Driven from ApplyPalette, so a coverless track sets the theme
                     brush here rather than leaving the previous album's colour. -->
                <Rectangle
                    x:Name="MusicPageWash"
                    Grid.RowSpan="2"
                    Fill="{ThemeResource MpvMusicPageBrush}" />

                <!-- The glow behind the cover: the saturated hue at low opacity,
                     so the artwork sits in light that came from itself. -->
                <Ellipse
                    x:Name="MusicArtworkGlow"
                    Grid.Row="0"
                    Width="520"
                    Height="520"
                    Margin="-80,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Opacity="0"
                    Fill="{ThemeResource MpvMusicArtworkFallbackBrush}" />

                <Grid
                    Grid.Row="0"
                    Padding="48,24,48,24"
                    ColumnSpacing="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cover art. mpv hands us the embedded picture through the
                         audio-display option; the fallback is the page's own
                         record-sleeve glyph, so a file with no artwork still has
                         something in the slot rather than a hole. -->
                    <Grid
                        Grid.Column="0"
                        Width="360"
                        Height="360"
                        VerticalAlignment="Center">
                        <Border
                            Background="{ThemeResource MpvMusicArtworkFallbackBrush}"
                            CornerRadius="12">
                            <FontIcon
                                x:Name="MusicArtworkFallbackIcon"
                                FontSize="96"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Border>
                        <Border CornerRadius="12">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                            <Image
                                x:Name="MusicArtwork"
                                Stretch="UniformToFill"
                                Visibility="Collapsed" />
                        </Border>
                    </Grid>

                    <!-- The reading column. Three bands, top to bottom: what
                         is playing, then the lyrics as the page's subject, then
                         nothing - the album line moved up into the header so the
                         lyrics get the rest of the height instead of whatever a
                         StackPanel left over.

                         The reference players are all built this way: the lyrics
                         are the page and the metadata serves them. Stacking all
                         five elements in one StackPanel was what made the lyrics
                         look like a footnote under a title. -->
                    <Grid
                        Grid.Column="1"
                        RowSpacing="{StaticResource MpvSpaceM}">
                        <Grid.RowDefinitions>
                            <!-- Header: auto, so a long title wraps rather than
                                 pushing the lyrics down. -->
                            <RowDefinition Height="Auto" />
                            <!-- Lyrics: the star row. They take the leftover
                                 height, which is what makes the reading position
                                 stable between songs of different title lengths. -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            Spacing="{StaticResource MpvSpaceXs}">
                            <TextBlock
                                x:Name="MusicTitle"
                                FontSize="34"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                x:Name="MusicArtist"
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="MusicAlbum"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- The reading frame.

                             A fixed-height column with the list centred inside it,
                             so the active line lands near the middle of the frame
                             rather than at its top edge. The spacers are the
                             mechanism: half the frame minus half a line is dead
                             space above the first line and below the last, which
                             is what lets the first and last lyric sit at the
                             reading position instead of pinned to an edge. -->
                        <Grid
                            Grid.Row="1"
                            MinHeight="200"
                            VerticalAlignment="Stretch">
                            <ListView
                                x:Name="MusicLyricsView"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                IsItemClickEnabled="True"
                                ItemClick="MusicLyricsView_ItemClick"
                                SelectionMode="None"
                                Visibility="Collapsed">
                                <ListView.ItemContainerStyle>
                                    <Style
                                        BasedOn="{StaticResource DefaultListViewItemStyle}"
                                        TargetType="ListViewItem">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Padding" Value="0,5" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="IsTabStop" Value="False" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:LyricLine">
                                        <!-- Scale and opacity both, not opacity
                                             alone: a colour step of 0.55 to 1.0 is
                                             barely visible on a dark page, and the
                                             size change is what a reader notices
                                             from a distance. 1.0 -> 1.18 is the
                                             step the reference players use. -->
                                        <TextBlock
                                            FontSize="{StaticResource MpvShellTitleFontSize}"
                                            Opacity="{x:Bind Opacity, Mode=OneWay}"
                                            Text="{x:Bind Text, Mode=OneWay}"
                                            TextWrapping="Wrap">
                                            <TextBlock.RenderTransform>
                                                <ScaleTransform
                                                    CenterX="0"
                                                    ScaleX="{x:Bind Scale, Mode=OneWay}"
                                                    ScaleY="{x:Bind Scale, Mode=OneWay}" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock
                                x:Name="MusicLyricsEmpty"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- The rhythm strip: bars between the page and the transport bar
                     that move with the audio, which is the "音乐律动" the request
                     asks for at the seam. A hand-built level meter rather than a
                     visualiser script: it needs to sit in this app's own layout,
                     and mpv's af visualiser draws into the video frame, not into
                     XAML. Driven by the audio peak mpv already reports. -->
                <Grid
                    x:Name="MusicRhythmStrip"
                    Grid.Row="1"
                    Height="36"
                    Padding="48,0,48,0"
                    ColumnSpacing="{StaticResource MpvSpaceXs}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Grid>

            <!-- The drop overlay: a full-window surface that says what will
                 happen before the file lands.
                 It covers the whole page rather than sitting on one card grid,
                 because the drop target is the whole page. Drawn above the panel
                 so a drop is visible whatever is on screen, and hit-test-inert so
                 it can never intercept the drag it is describing. -->

            <Grid
                x:Name="DropOverlay"
                Canvas.ZIndex="20"
                Background="{ThemeResource MpvDropOverlayBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed">

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="{StaticResource MpvSpaceM}">

                    <Border
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource MpvDropOverlayIconSurfaceBrush}"
                        CornerRadius="36">

                        <FontIcon
                            x:Name="DropOverlayIcon"
                            FontSize="32"
                            Glyph="&#xE768;" />

                    </Border>

                    <TextBlock
                        x:Name="DropOverlayTitle"
                        HorizontalAlignment="Center"
                        FontSize="{StaticResource MpvPanelTitleFontSize}"
                        FontWeight="SemiBold"
                        Style="{StaticResource SubtitleTextBlockStyle}" />

                    <TextBlock
                        x:Name="DropOverlayDescription"
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                </StackPanel>

            </Grid>

            <!-- The playlist, as an IN-LAYOUT side pane.

     This is the second reversal on this surface, so the reasoning is written
     down rather than left in a commit message.

     It was an in-layout pane, then a Popup that pops out over the window, and
     it is an in-layout pane again. The pop-out was chosen for a real reason:
     a docked panel takes width from the picture while it is up, and it is
     clipped to the window instead of floating past its edge. The requirement
     now is the opposite one - a large pane that slides out from the right and
     belongs to the layout - so the pop-out is reverted deliberately, not
     because it broke.

     What that costs, stated plainly so nobody rediscovers it: the pane is a
     grid column, so it cannot extend past the window edge, it cannot overlay
     the picture, and it must not be given a translucent surface as if it
     floated. It narrows the stage instead. That is the requested behaviour.

     What it buys: the queue can be long and still scroll to its last row
     (a Popup with ShouldConstrainToRootBounds="False" had to be clamped by
     hand, and before that clamp existed its lower half left the screen on a
     1366x768 display), it participates in the page's own layout and visual
     states, and it cannot end up behind another island window.

     The rows are the very same PlaylistItems the queue section binds to, so
     the two views cannot disagree about what is queued. -->
            <Border
                x:Name="PlaylistPanelSurface"
                Grid.Column="1"
                Width="{StaticResource MpvPlaylistPanelWidth}"
                Background="{ThemeResource MpvShellPaneBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Height="{StaticResource MpvPlaylistPanelHeaderHeight}"
                        Padding="16,0,8,0">
                        <TextBlock
                            x:Name="PlaylistPanelTitle"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource MpvPanelTitleFontSize}"
                            FontWeight="SemiBold" />
                        <Button
                            x:Name="PlaylistPanelCloseButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="{StaticResource MpvCompactButtonPadding}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PlaylistPanelCloseButton_Click">
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <ListView
                        x:Name="PlaylistPanelView"
                        Grid.Row="1"
                        Padding="4,0,4,8"
                        Background="Transparent"
                        BorderThickness="0"
                        ContextRequested="PlaylistPanelView_ContextRequested"
                        IsItemClickEnabled="True"
                        ItemClick="PlaylistPanelView_ItemClick"
                        ItemsSource="{x:Bind PlaylistItems, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style
                                BasedOn="{StaticResource DefaultListViewItemStyle}"
                                TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PlaylistItem">
                                <Grid Height="44">
                                    <Border
                                        Margin="8,1"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind IsCurrent, Mode=OneTime}" />
                                    <Grid
                                        Margin="12,0"
                                        ColumnSpacing="{StaticResource MpvSpaceM}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Grid.Column="0"
                                            FontSize="16"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Glyph="&#xE768;"
                                            Visibility="{x:Bind IsCurrent, Mode=OneTime}" />
                                        <FontIcon
                                            Grid.Column="0"
                                            FontSize="16"
                                            Glyph="&#xE8B2;"
                                            Visibility="{x:Bind bc:BindConvertor.InvertVisibility(IsCurrent), Mode=OneTime}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Filename, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Path, Mode=OneTime}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind DurationText, Mode=OneTime}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NormalWindow">
                    <VisualState.Setters />
                </VisualState>
                <VisualState x:Name="FullWindow">
                    <VisualState.Setters>
                        <Setter Target="MenuRow.Height" Value="0" />
                        <!-- One setter, deliberately.
                             The control bar lives in the shell now
                             (MainWindow.ShellPlayerBar), so there is nothing
                             to move here; the shell's ChangeFullWindow hides
                             the navigation chrome in step with this state.
                             An earlier version also re-dressed the playlist
                             toolbar here, with a negative top margin on a row
                             that clips it. That class of setter is now
                             forbidden by tools/check-visual-state-layout.py,
                             and the playlist column those setters addressed no
                             longer exists at all. -->
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
