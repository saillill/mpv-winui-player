<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="mpv_winui.Domains.Playback.Controls.LibraryCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--  A Button that draws nothing of its own.

              Reported as 「按钮在悬浮时应该是在半透明上再加一层遮罩，不是取消描边和原渲染」.
              The obstruction was not this control's code: WinUI's default Button
              template swaps two resources on PointerOver - ButtonBackgroundPointerOver
              (ControlFillColorSecondaryBrush) and ButtonBorderBrushPointerOver
              (ControlElevationBorderBrush), both confirmed in the SDK's generic.xaml.
              So the surface and the ring were being REPLACED by the template while the
              pointer was on the disc, and no amount of layering on top could stop it.
              It also explains 「选中后在悬浮时不要有变化，目前会半透明」 on the tick
              box: the same swap overwrote the accent fill.

              This template is a single ContentPresenter and nothing else. It has no
              VisualStateManager at all, so the control's Background, BorderBrush,
              BorderThickness and CornerRadius are exactly what markup sets, in every
              state, for the whole life of the control. Pointer feedback is the veil
              Border each control carries as a sibling - one thing changes on hover,
              and it is the thing the report asked to change.

              FocusVisualPrimaryThickness is set here because removing the default
              template also removes its focus rectangle, and a keyboard user would
              otherwise tab onto a disc with no visible focus. 2 DIP of the system
              focus colour is the mitigation. -->
        <Style x:Key="MpvCardIconButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualPrimaryThickness" Value="2" />
            <Setter Property="FocusVisualPrimaryBrush"
                    Value="{ThemeResource SystemControlFocusVisualPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!--  A Border, not a bare ContentPresenter: ContentPresenter
                              cannot draw a Background or a Border, so the disc's
                              surface and ring would vanish. The Border is the thing
                              that renders them, in every state, because this template
                              has no state at all. -->
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                Padding="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--  One library card: a media tile, two caption lines, and the hover layer.

          Why this is a UserControl and not a DataTemplate. The templates this
          replaces had to be driven from outside: ElementPrepared walked the
          visual tree looking for elements by NAME (FindDescendant(card,
          "AlbumCardCoverImage")) because a DataTemplate instance has no
          compiled handle on its own parts. A rename in XAML then produced no
          error at all - just a card whose cover silently never appeared. The
          cover has to be assigned from code (a bound Thumbnail does not
          deliver; measured 2025-10-31), so the card needs a code-behind that
          owns the parts it writes to.

          What still cannot be a binding, and why:
            * The cover. {x:Bind Thumbnail} compiles and paints nothing.
            * The square. A self-referential {Binding ActualWidth} collapses the
              tile to nothing in this layout - measured, the cover area vanished
              and only the fallback glyph's row remained.
          What is NOT a binding here for a different reason: the two captions.
          They could bind, but the card is handed its entry on every recycle and
          on every language change, so assigning them is both simpler and one
          notification fewer.

          The root is a Button rather than a Border: the card opens what it
          stands for, and a Border with a Tapped handler would give up keyboard
          focus and its automation name. -->

    <Button
        x:Name="RootButton"
        Padding="0"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        Background="Transparent"
        BorderThickness="0"
        Click="RootButton_Click">
        <!--  One Grid over the whole card: the tile AND its caption line.
              The hover frame has to wrap both, because they are one card - the
              report circled the picture on its own and said so: "the outermost
              hover frame should be the outlined one; what you framed is the
              thumbnail".

              This Grid IS the cell, and the cell is where the gutter lives. The
              spike measured that a grid cell clips whatever is drawn beyond it,
              so the frame cannot hang outside the cell: instead the cell is
              CardMetrics.CellWidthFor(content), 12 DIP wider than the picture,
              and the frame stretches this whole box while the content sits 6 DIP
              inside it. One Margin in the pair, on the content - see the comment
              below the frame for why. -->
        <Grid>
            <!--  The hover frame, drawn ON TOP of the content.

                  Reported: "the outermost hover frame should be the white outlined
                  one". This Border stretches over the whole card - picture and
                  caption - and the cell is 6 DIP wider than the content on every
                  side, so the outline traces the card's edge rather than any inner
                  element's.

                  It carries NO Margin of its own, deliberately. The content holds
                  the one inset and the frame takes its box from the cell: two
                  independent Margins is how a stroke and the content it traces
                  drift apart, and a test asserts this tag stays free of one.

                  Four things here were each measured rather than reasoned:

                    * Position. It is the LAST child with a Canvas.ZIndex above the
                      content, not the first. As the first child it drew behind a
                      thumbnail whose Image is UniformToFill and opaque, so the frame
                      existed in the tree, reported Visible, and put no pixels on
                      screen. On top, the stroke is drawn 6 DIP clear of the picture.
                    * No Opacity="0". MotionBehaviors.FadeIn animates the compositor
                      visual's opacity while a XAML Opacity is the element's own, so
                      an Opacity="0" in markup multiplied the frame to nothing through
                      the entire fade. Visibility alone hides it, and it is toggled
                      without a fade - a boundary that fades in reads as the card
                      resizing.
                    * No Background. A Border with no background and no child does not
                      get a composited visual on its own; the always-Transparent value
                      is left off for the same reason the Opacity is.
                    * Themed brush. MpvCardFrameBrush, one value per theme. The near
                      opaque MpvCardRingBrush it wore before is shared with the corner
                      buttons and the OSD capsule, so one value could not suit all
                      three.

                  12 is CardMetrics.HoverFrameCornerRadius = CornerRadius (6) +
                  HoverFrameInset (6): the arc sits one gutter outside the content's,
                  so it has to be that much larger to stay parallel to it. A literal
                  because CardMetrics is an internal static class and markup cannot
                  name it; CardMetricsTests pins the markup instead. -->
            <Border
                x:Name="HoverFrame"
                Canvas.ZIndex="10"
                BorderBrush="{ThemeResource MpvCardFrameBrush}"
                BorderThickness="1"
                CornerRadius="14"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

            <!--  The content: the ONE element that carries the gutter.

                  The 6 is CardMetrics.HoverFrameInset, resolved against the cell
                  rather than against another element, so the picture is the
                  reference's width and the frame's 6 DIP band is the cell's extra.
                  It is permanent - the same 6 whether or not the frame is showing -
                  which is what keeps the content from moving on hover.

                  Margin rather than padding so the thumbnail's own CornerRadius
                  still lines up with the frame's arc, and a literal because Margin
                  is a Thickness: an x:Double has no conversion for one, and the
                  assignment throws inside InitializeComponent where Frame.Navigate
                  swallows it into an empty window. CardMetricsTests pins it. -->
            <Grid x:Name="CardContent" Margin="6">
                <StackPanel>
            <!--  The media tile. Height is assigned from ApplyCoverHeight once
                  ActualWidth is known; see the class comment.

                  The hairline is the cover's, not the card's: "a faint grey-white
                  shadow stroke around the thumbnail" while the card is at rest, so
                  a resting card is not a hole in the grid. It is 1 DIP at alpha
                  0x14 (MpvCardCoverStrokeBrush), which is why it reads as an edge
                  and not as a border. It must stay on THIS Border: an outline
                  around the whole card would compete with HoverFrame, and the
                  hover frame is the one that means "this card". Drawn by
                  BorderThickness rather than by a second nested Border, so it
                  follows this element's radius instead of tracing a second arc. -->
            <Border
                x:Name="MediaBorder"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource MpvCardCoverStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <!--  The media-kind glyph shows until a cover arrives, and
                          for good when the file has none. The Viewbox is what
                          makes the 24-unit PathIcon actually 48px. -->
                    <Viewbox
                        x:Name="FallbackIcon"
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <PathIcon
                            x:Name="FallbackGlyph"
                            Width="24"
                            Height="24"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Viewbox>

                    <Image
                        x:Name="CoverImage"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />

                    <!--  The now-playing stripe, along the tile's bottom edge. -->
                    <Rectangle
                        x:Name="NowPlayingBar"
                        Height="2"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="Collapsed" />


                </Grid>
            </Border>

            <!--  The caption is part of the card, so it sits in the card's own
                  column and gets the card's width - not a narrower box that makes
                  the two lines look like a label stuck underneath.

                  The gap is CaptionTopGap and it is deliberately small: measured
                  against the reference, the title's cap line begins 6 DIP under
                  the tile. At the previous 10 the two read as a separate block
                  floating below the picture rather than as its label.

                  The bottom margin is TrailingCaptionSpace, half a line (11), and
                  it is not padding for its own sake: the hover frame wraps the
                  card, so with zero the caption's last line sits hard against the
                  card's lower edge and the frame reads as a border around the
                  picture plus an accident of text. It was 33 (a line and a half)
                  while the card carried one caption line; with the length line back
                  that reserved gap on top of it is what 「卡片标题下的留白过多」 was
                  pointing at. -->
            <StackPanel
                Margin="8,6,0,11"
                Spacing="{StaticResource MpvSpaceXxs}">
                <!--  Two lines, both in ONE typographic style.

                      They used to be a pair of sizes (15 SemiBold over 14 Regular,
                      secondary colour) that read as a heading with a caption under
                      it. Reported as "use the now-playing row's own type for every
                      card, and stop putting the smaller line underneath" - the
                      orange row was the one everything else was being measured
                      against, so it is the one that defines the style now.

                      So: same size, same weight, same line box on both lines. The
                      ONLY thing that varies is colour, and it varies by state, not
                      by which line you are on:

                        normal    TextFillColorPrimaryBrush  (white)
                        selected  AccentTextFillColorPrimaryBrush (orange)

                      Changing the size of one line is therefore not a styling
                      decision any more, which is what keeps a wrapped title and the
                      line under it from drifting apart.

                      LineHeight is written here as a literal, and that is a fix
                      rather than a tidy-up: the constants existed and the grid
                      sized its cells from them, but nothing in the card applied
                      them, so a 15px line measured ~32 DIP against the 22 the cell
                      had reserved for it. CaptionBandHeight came out 18 DIP short
                      of what the card actually drew, and the second line spilled
                      out of its cell - the "text sits on the cover" report.

                      Literals rather than a token because CardMetrics is an
                      internal static class and cannot be named from markup.
                      Assigning these from the code behind was tried and reverted:
                      setting LineHeight on a TextBlock straight after
                      InitializeComponent measured a card that never laid out at
                      all (UIA reported the whole card at -31384,-31698 and the
                      captions drew no pixels, while the same card at HEAD sat at
                      804,478). CardMetricsTests compares these two literals against
                      CardMetrics.TitleLineHeight / SubtitleLineHeight, so they
                      cannot drift silently. TextBlock's default
                      LineStackingStrategy is MaxHeight, which is what lets one
                      LineHeight govern every wrapped line. -->
                <TextBlock
                    x:Name="TitleText"
                    MaxLines="1"
                    FontSize="{StaticResource MpvCardTitleFontSize}"
                    FontWeight="{StaticResource MpvCardCaptionFontWeight}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    LineHeight="22"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <!--  The second line: the length.

                      It was collapsed for a round because it carried the entry's
                      subtitle - for a video the folder name, which repeated the
                      title or read "未知专辑 / 未知艺术家" on untagged audio. The
                      report asks for it back, carrying something that is never a
                      repeat: 「卡片出标题外下一行应该再交代视频、音乐的时间」.

                      Visibility is left Visible here and decided by the code
                      behind from DurationVisibility, because not every entry knows
                      its length: the watch history records no duration, so a float
                      or an untagged file has none and the line collapses rather
                      than showing an empty box. -->
                <TextBlock
                    x:Name="SubtitleText"
                    Visibility="Collapsed"
                    FontSize="{StaticResource MpvCardSubtitleFontSize}"
                    FontWeight="Normal"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    LineHeight="19"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

        </StackPanel>

            <!--  The hover layer, pinned to the TOP of the card.

                  VerticalAlignment="Top" is not cosmetic and it is the fix for
                  "the highlight sits too low and does not overlap the picture".
                  The code behind assigns this Grid the tile's height, and a Grid
                  with an explicit Height inside a taller parent stops stretching:
                  WPF and WinUI both centre it instead. So the wash and both
                  buttons were drawn half a caption band below the picture, and
                  the tile never got covered at all.

                  It stops at the tile's bottom edge on purpose. The wash marks
                  the thing you are about to play; the two caption lines stay
                  legible underneath, which is the reference's own behaviour. -->
            <Grid
                x:Name="HoverOverlay"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Visibility="Collapsed">

                <!--  The wash that used to sit here is gone.

                      It was a translucent fill with a black ring, inset into the
                      picture. That was the wrong shape: the report circled the
                      thumbnail and said "the black frame is inside the card; the
                      outermost hover frame should be the outlined one, and what
                      you framed is the video thumbnail". The highlight is now
                      HoverFrame around the whole card, so what remains here is
                      only the two corner buttons, anchored to the tile. -->

                <!--  Play at the tile's lower-left, overflow at its lower-right:
                      one button per corner, which is what the reference player
                      does and what the report asked for.

                      A Grid rather than a centred StackPanel. The stack put both
                      buttons side by side in the middle of the picture, which on
                      a 16:9 frame lands on the subject rather than on an edge.
                      Two alignments in one Grid means each button is anchored to
                      its own corner and cannot drift when the tile's width
                      changes.

                      Geometry, from CardMetrics, all three literal because
                      markup cannot name an internal static class: 36x36 discs
                      (PlayButtonSize / MoreButtonSize), inset 10 from the tile's
                      edges (CornerInset), radius 18 (half the diameter, the only
                      radius that keeps the ring concentric with the disc).

                      The 36 is the report's own arithmetic: 「原基础放大1.2倍左右」,
                      30 x 1.2 = 36, which is also the size before this branch
                      shrank them.

                      The SURFACE is MpvCardControlBrush, which is white in the
                      light theme and near-black in the dark one - 「在浅色模式下
                      按钮应该是白色」. The glyph follows the theme with it (see
                      MpvCardGlyphBrush); the RING is MpvCardButtonRingBrush and
                      only the ring is translucent, so the disc reads as a solid
                      control sitting on the frame rather than as a tinted hole. -->
                <Button
                    x:Name="PlayButton"
                    Width="30"
                    Height="30"
                    Margin="9"
                    Padding="0"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Bottom"
                    VerticalContentAlignment="Center"
                    Background="{ThemeResource MpvCardControlBrush}"
                    BorderBrush="{ThemeResource MpvCardButtonRingBrush}"
                    BorderThickness="1"
                    Click="PlayButton_Click"
                    CornerRadius="15"
                    Style="{StaticResource MpvCardIconButtonStyle}">
                    <!--  The glyph is centred in a Viewbox, not left to FontIcon.

                          Reported with a screenshot circling both discs: "the
                          icons are not centred; the play glyph sits off-centre
                          and its corner is clipped". Two separate causes, both
                          fixed here:

                            * Padding. A Button's default padding is not
                              symmetric around its content, so a 30x30 button
                              with a 15px glyph pushed the glyph up and right.
                              Every other fixed-size icon button in this
                              repository already sets Padding="0" - these two
                              were the only ones that did not.
                            * Vertical metrics. FontIcon lays its glyph out on a
                              text baseline, so the ink sits above the centre
                              line even with padding at zero. A Viewbox is sized
                              and centred as a shape, which is what makes the
                              triangle's centroid land on the disc's centre
                              instead of its box. -->
                    <Viewbox
                        Width="17"
                        Height="17"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <FontIcon
                            FontFamily="{StaticResource MpvIconFontFamily}"
                            FontSize="{StaticResource MpvPlayGlyphFontSize}"
                            Foreground="{ThemeResource MpvCardGlyphBrush}"
                            Glyph="&#xF605;" />
                    </Viewbox>
                </Button>

                <!--  The pointer-over darkening of the play disc.

                      Reported as 「现在鼠标在按钮上悬浮描边会缩成一个小圈，不应该这么渲染，
                      按钮不动在此基础上加一个变亮、变暗遮罩」. The previous attempt put a
                      second Border INSIDE the Button, and that is exactly what shrank:
                      the Button sets Padding="0" and HorizontalContentAlignment=Center,
                      so its content box is the 17px glyph, not the 36px disc - the
                      "highlight" drew a 17px ring around the glyph.

                      This one is a SIBLING of the Button, in a Grid sized to the disc,
                      so it covers the whole disc. It is a fill, not a stroke: the ring
                      is untouched, the glyph is untouched, and what changes is the
                      luminance of the surface under both - which is what a hover state
                      on a solid control looks like in Fluent.

                      Hit-test invisible: the Button must keep receiving the pointer, or
                      this would light up and then eat the click that turned it on. -->
                <Border
                    x:Name="PlayButtonHover"
                    Margin="9"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Width="30"
                    Height="30"
                    Background="{ThemeResource MpvCardButtonHoverBrush}"
                    BorderBrush="{ThemeResource MpvCardButtonHoverBrush}"
                    BorderThickness="1"
                    CornerRadius="15"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

                <Button
                    x:Name="MoreButton"
                    Width="30"
                    Height="30"
                    Margin="9"
                    Padding="0"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Bottom"
                    VerticalContentAlignment="Center"
                    Background="{ThemeResource MpvCardControlBrush}"
                    BorderBrush="{ThemeResource MpvCardButtonRingBrush}"
                    BorderThickness="1"
                    Click="MoreButton_Click"
                    CornerRadius="15"
                    Style="{StaticResource MpvCardIconButtonStyle}">
                    <!--  Geometry, not a glyph: E712 in FluentSystemIcons is not
                          three dots.

                          Same centring treatment as the play button above: the
                          Viewbox is the element that centres, and the PathIcon
                          inside it draws at its native 24. Without
                          Padding="0" the three dots drifted up and right the
                          same way the triangle did. -->
                    <Viewbox
                        Width="15"
                        Height="15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <PathIcon
                            Width="24"
                            Height="24"
                            Data="F1 M12 4C11.1716 4 10.5 4.67157 10.5 5.5C10.5 6.32843 11.1716 7 12 7C12.8284 7 13.5 6.32843 13.5 5.5C13.5 4.67157 12.8284 4 12 4ZM12 10.5C11.1716 10.5 10.5 11.1716 10.5 12C10.5 12.8284 11.1716 13.5 12 13.5C12.8284 13.5 13.5 12.8284 13.5 12C13.5 11.1716 12.8284 10.5 12 10.5ZM10.5 18.5C10.5 17.6716 11.1716 17 12 17C12.8284 17 13.5 17.6716 13.5 18.5C13.5 19.3284 12.8284 20 11.1716 20C10.5 19.3284 10.5 18.5 10.5 18.5Z"
                            Foreground="{ThemeResource MpvCardGlyphBrush}" />
                    </Viewbox>
                </Button>

                <!--  The pointer-over darkening of the overflow disc: the same
                      sibling overlay as the play button's, for the same reason and
                      with the same measured failure behind it. -->
                <Border
                    x:Name="MoreButtonHover"
                    Margin="9"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="30"
                    Height="30"
                    Background="{ThemeResource MpvCardButtonHoverBrush}"
                    BorderBrush="{ThemeResource MpvCardButtonHoverBrush}"
                    BorderThickness="1"
                    CornerRadius="15"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />

            </Grid>

            <!--  The tick box: the way INTO selection mode, not a readout of it.

                  It used to be a Border inside HoverOverlay, and each half of that
                  was a defect on its own:

                    * HoverOverlay carries IsHitTestVisible="False" and collapses
                      when the pointer leaves. A box inside it could not be clicked,
                      and a ticked card lost its mark as soon as the cursor moved
                      away. That is why the only way into selection mode was the
                      card's context menu, which nobody would go looking for.
                    * A Border with no handler reports a state; it cannot change
                      one. The entry owns the tick and the page owns the mode, so
                      the card asks rather than decides: this click raises
                      SelectionRequested and the page flips the entry.

                  A Button inside a card whose ROOT is also a Button is the trap
                  here: the root's Click opens the file, and a tick that also
                  started playback would be the defect this control introduces
                  rather than removes. WinUI's Click takes a plain RoutedEventArgs,
                  which carries no Handled flag, so there is nothing to set here;
                  what stops the outer click is ButtonBase marking the pointer
                  press and release handled while this button presses. That was
                  measured, not assumed - see SelectionBox_Click in the code
                  behind.

                  Placement: the 8 DIP Margin is measured from CardContent, which is
                  the picture's own box, so the box sits 8 DIP inside the PICTURE's
                  top-left corner - the same inset the two discs use at the tile's
                  lower corners, which is what makes the three read as one family.
                  Anchored to the cell instead (the outer Grid, 8 from the cell
                  edge) it would sit 2 DIP off the picture, inside the permanent 6
                  DIP gutter the hover frame traces, and read as chrome around the
                  card rather than as a mark on it.

                  Padding="0" and a centred content box for the measured reason the
                  two corner buttons give at length below: a Button's default
                  padding is not symmetric about its content, so a small glyph in a
                  fixed-size button drifts up and right.

                  CornerRadius 13 on a 26px box: a CIRCLE, not the 6 this wore
                  before. The box used to be 24 with radius 6, which reads as a
                  square with rounded corners sitting next to two round discs. The
                  report's 「里面包裹了一个正方形描边没有用」 was the glyph (now gone);
                  this makes the box itself round for the same reason the discs are.

                  The fill and border come from UpdateSelectionBoxForState through
                  MpvCardTickBoxFillBrush / MpvCardTickBoxRingBrush, because they
                  depend on whether the card is ticked: a ticked box is the accent
                  colour (「选择到的按钮应该是强调色」), an unticked one is the neutral
                  surface. They are not set here because markup cannot see the entry.

                  Visibility is not decided here either: the box shows when the entry
                  is in selection mode OR the pointer is on this card. That pair is
                  resolved in UpdateSelectionBoxForState, which runs on every recycle
                  as well - a recycled card arrives with the box already in the right
                  state for the file it now stands for. -->
            <Button
                x:Name="SelectionBox"
                Width="20"
                Height="20"
                Margin="14,9,0,0"
                Padding="0"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Center"
                VerticalAlignment="Top"
                VerticalContentAlignment="Center"
                BorderThickness="1"
                Click="SelectionBox_Click"
                CornerRadius="4"
                Style="{StaticResource MpvCardIconButtonStyle}"
                Visibility="Collapsed">
                <FontIcon
                    x:Name="SelectionGlyphIcon"
                    FontSize="{StaticResource MpvCardTickFontSize}" />
            </Button>

            <!--  The tick box's pointer-over veil, a sibling of the box for the same
                  reason the discs have one: a Button's content box is its glyph, so a
                  Border inside would draw a small ring rather than cover the control.

                  Shown only while the card is UNTICKED - 「选中后在悬浮时不要有变化」.
                  A ticked box is a statement (this file is in the selection) and
                  brightening it under the pointer would suggest the tick is a hover
                  artefact. An unticked box is just a target, so it responds like one. -->
            <Border
                x:Name="SelectionBoxHover"
                Width="20"
                Height="20"
                Margin="14,9,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource MpvCardButtonHoverBrush}"
                BorderBrush="{ThemeResource MpvCardButtonHoverBrush}"
                BorderThickness="1"
                CornerRadius="4"
                IsHitTestVisible="False"
                Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Button>
</UserControl>
