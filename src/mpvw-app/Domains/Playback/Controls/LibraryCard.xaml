<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="mpv_winui.Domains.Playback.Controls.LibraryCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  One library card: a media tile, two caption lines, and the hover layer.

          Why this is a UserControl and not a DataTemplate. The templates this
          replaces had to be driven from outside: ElementPrepared walked the
          visual tree looking for elements by NAME (FindDescendant(card,
          "AlbumCardCoverImage")) because a DataTemplate instance has no
          compiled handle on its own parts. A rename in XAML then produced no
          error at all - just a card whose cover silently never appeared. The
          cover has to be assigned from code (a bound Thumbnail does not
          deliver; measured 2025-10-31), so the card needs a code-behind that
          owns the parts it writes to.

          What still cannot be a binding, and why:
            * The cover. {x:Bind Thumbnail} compiles and paints nothing.
            * The square. A self-referential {Binding ActualWidth} collapses the
              tile to nothing in this layout - measured, the cover area vanished
              and only the fallback glyph's row remained.
          What is NOT a binding here for a different reason: the two captions.
          They could bind, but the card is handed its entry on every recycle and
          on every language change, so assigning them is both simpler and one
          notification fewer.

          The root is a Button rather than a Border: the card opens what it
          stands for, and a Border with a Tapped handler would give up keyboard
          focus and its automation name. -->

    <Button
        x:Name="RootButton"
        Padding="0"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalAlignment="Stretch"
        VerticalContentAlignment="Top"
        Background="Transparent"
        BorderThickness="0"
        Click="RootButton_Click">
        <!--  One Grid over the whole card: the tile AND its two caption lines.
              The hover layer has to be able to cover both, because they are one
              card - hovering the picture lit only the picture and left the text
              untouched, which reads as a picture with a label next to it rather
              than as a card. -->
        <Grid>
            <StackPanel>
            <!--  The media tile. Height is assigned from ApplyCoverHeight once
                  ActualWidth is known; see the class comment. -->
            <Border
                x:Name="MediaBorder"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="4">
                <Grid>
                    <!--  The media-kind glyph shows until a cover arrives, and
                          for good when the file has none. The Viewbox is what
                          makes the 24-unit PathIcon actually 48px. -->
                    <Viewbox
                        x:Name="FallbackIcon"
                        Width="48"
                        Height="48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <PathIcon
                            x:Name="FallbackGlyph"
                            Width="24"
                            Height="24"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Viewbox>

                    <Image
                        x:Name="CoverImage"
                        Stretch="UniformToFill"
                        Visibility="Collapsed" />

                    <!--  The now-playing stripe, along the tile's bottom edge. -->
                    <Rectangle
                        x:Name="NowPlayingBar"
                        Height="2"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="Collapsed" />


                </Grid>
            </Border>

            <!--  The caption is part of the card, so it sits in the card's own
                  column and gets the card's width - not a narrower box that makes
                  the two lines look like a label stuck underneath.

                  The gap is CaptionTopGap and it is deliberately small: measured
                  against the reference, the title's cap line begins 6 DIP under
                  the tile. At the previous 10 the two read as a separate block
                  floating below the picture rather than as its label. -->
            <StackPanel Margin="0,6,0,0" Spacing="{StaticResource MpvSpaceXxs}">
                <!--  Two lines, both in ONE typographic style.

                      They used to be a pair of sizes (15 SemiBold over 14 Regular,
                      secondary colour) that read as a heading with a caption under
                      it. Reported as "use the now-playing row's own type for every
                      card, and stop putting the smaller line underneath" - the
                      orange row was the one everything else was being measured
                      against, so it is the one that defines the style now.

                      So: same size, same weight, same line box on both lines. The
                      ONLY thing that varies is colour, and it varies by state, not
                      by which line you are on:

                        normal    TextFillColorPrimaryBrush  (white)
                        selected  AccentTextFillColorPrimaryBrush (orange)

                      Changing the size of one line is therefore not a styling
                      decision any more, which is what keeps a wrapped title and the
                      line under it from drifting apart.

                      LineHeight is written here as a literal, and that is a fix
                      rather than a tidy-up: the constants existed and the grid
                      sized its cells from them, but nothing in the card applied
                      them, so a 15px line measured ~32 DIP against the 22 the cell
                      had reserved for it. CaptionBandHeight came out 18 DIP short
                      of what the card actually drew, and the second line spilled
                      out of its cell - the "text sits on the cover" report.

                      Literals rather than a token because CardMetrics is an
                      internal static class and cannot be named from markup.
                      Assigning these from the code behind was tried and reverted:
                      setting LineHeight on a TextBlock straight after
                      InitializeComponent measured a card that never laid out at
                      all (UIA reported the whole card at -31384,-31698 and the
                      captions drew no pixels, while the same card at HEAD sat at
                      804,478). CardMetricsTests compares these two literals against
                      CardMetrics.TitleLineHeight / SubtitleLineHeight, so they
                      cannot drift silently. TextBlock's default
                      LineStackingStrategy is MaxHeight, which is what lets one
                      LineHeight govern every wrapped line. -->
                <TextBlock
                    x:Name="TitleText"
                    MaxLines="1"
                    FontSize="{StaticResource MpvCardTitleFontSize}"
                    FontWeight="{StaticResource MpvCardCaptionFontWeight}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    LineHeight="22"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <!--  The second line is gone.

                      Reported as "drop the date string and the repeated title,
                      keep only the top line, and make it the plain file name".
                      It used to carry a subtitle the entry happened to have -
                      for a video the folder name, which is why every card in a
                      scan showed a second line that repeated the first or said
                      "未知专辑 / 未知艺术家" for untagged audio. One line that
                      always says the file is both less to read and never wrong.

                      Kept in the tree as a collapsed element rather than
                      deleted: LibraryCard.xaml.cs assigns it on every recycle
                      and the selection/emphasis path writes to it, and a rename
                      here is exactly the kind of thing that used to break this
                      control silently. -->
                <TextBlock
                    x:Name="SubtitleText"
                    Visibility="Collapsed"
                    FontSize="{StaticResource MpvCardTitleFontSize}"
                    FontWeight="{StaticResource MpvCardCaptionFontWeight}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    LineHeight="19"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

        </StackPanel>

            <!--  The hover layer, pinned to the TOP of the card.

                  VerticalAlignment="Top" is not cosmetic and it is the fix for
                  "the highlight sits too low and does not overlap the picture".
                  The code behind assigns this Grid the tile's height, and a Grid
                  with an explicit Height inside a taller parent stops stretching:
                  WPF and WinUI both centre it instead. So the wash and both
                  buttons were drawn half a caption band below the picture, and
                  the tile never got covered at all.

                  It stops at the tile's bottom edge on purpose. The wash marks
                  the thing you are about to play; the two caption lines stay
                  legible underneath, which is the reference's own behaviour. -->
            <Grid
                x:Name="HoverOverlay"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Visibility="Collapsed">

                <!--  The wash, inset from the tile's edges and wearing its own
                      translucent black ring.

                      Reported twice. First "the highlight sits too low and does
                      not overlap the picture" - fixed by VerticalAlignment=Top
                      above. Then "the highlight and the picture have no gap, and
                      it needs a noticeably thicker translucent black border":
                      the wash shared the tile's exact bounds, so the lit region
                      and the picture were the same rectangle and only a colour
                      change separated them. Insetting it leaves a strip of
                      untouched picture all round, which is what makes the two
                      read as two shapes.

                      Margin and BorderThickness rather than shrinking the
                      parent: the parent stays pinned to the tile (the buttons
                      anchor to it) and only this Border moves inward.

                      The two numbers are literals because Margin and
                      BorderThickness are Thickness and must be - an x:Double
                      token throws inside InitializeComponent, and
                      Frame.Navigate swallows that into an empty window. They
                      mirror CardMetrics.HoverInset (6) and HoverRingThickness
                      (2); the typography baseline records the same constraint
                      for this file's other Margin. -->
                <Border
                    Margin="6"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{StaticResource MpvCardHoverRingBrush}"
                    BorderThickness="2"
                    CornerRadius="6"
                    IsHitTestVisible="False" />

                <!--  Play at the tile's lower-left, overflow at its lower-right:
                      one button per corner, which is what the reference player
                      does and what the report asked for.

                      A Grid rather than a centred StackPanel. The stack put both
                      buttons side by side in the middle of the picture, which on
                      a 16:9 frame lands on the subject rather than on an edge.
                      Two alignments in one Grid means each button is anchored to
                      its own corner and cannot drift when the tile's width
                      changes. -->
                <Button
                    x:Name="PlayButton"
                    Width="36"
                    Height="36"
                    Margin="10"
                    Padding="0"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Bottom"
                    VerticalContentAlignment="Center"
                    Background="{StaticResource MpvCardControlBrush}"
                    BorderBrush="{StaticResource MpvCardRingBrush}"
                    BorderThickness="1.5"
                    Click="PlayButton_Click"
                    CornerRadius="18">
                    <!--  The glyph is centred in a Viewbox, not left to FontIcon.

                          Reported with a screenshot circling both discs: "the
                          icons are not centred; the play glyph sits off-centre
                          and its corner is clipped". Two separate causes, both
                          fixed here:

                            * Padding. A Button's default padding is not
                              symmetric around its content, so a 36x36 button
                              with a 15px glyph pushed the glyph up and right.
                              Every other fixed-size icon button in this
                              repository already sets Padding="0" - these two
                              were the only ones that did not.
                            * Vertical metrics. FontIcon lays its glyph out on a
                              text baseline, so the ink sits above the centre
                              line even with padding at zero. A Viewbox is sized
                              and centred as a shape, which is what makes the
                              triangle's centroid land on the disc's centre
                              instead of its box. -->
                    <Viewbox
                        Width="15"
                        Height="15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <FontIcon
                            FontFamily="{StaticResource MpvIconFontFamily}"
                            FontSize="{StaticResource MpvPlayGlyphFontSize}"
                            Foreground="{StaticResource MpvCardRingBrush}"
                            Glyph="&#xF605;" />
                    </Viewbox>
                </Button>

                <Button
                    x:Name="MoreButton"
                    Width="36"
                    Height="36"
                    Margin="10"
                    Padding="0"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Bottom"
                    VerticalContentAlignment="Center"
                    Background="{StaticResource MpvCardControlBrush}"
                    BorderBrush="{StaticResource MpvCardRingBrush}"
                    BorderThickness="1.5"
                    Click="MoreButton_Click"
                    CornerRadius="18">
                    <!--  Geometry, not a glyph: E712 in FluentSystemIcons is not
                          three dots.

                          Same centring treatment as the play button above: the
                          Viewbox is the element that centres, and the PathIcon
                          inside it draws at its native 24. Without
                          Padding="0" the three dots drifted up and right the
                          same way the triangle did. -->
                    <Viewbox
                        Width="13"
                        Height="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <PathIcon
                            Width="24"
                            Height="24"
                            Data="F1 M12 4C11.1716 4 10.5 4.67157 10.5 5.5C10.5 6.32843 11.1716 7 12 7C12.8284 7 13.5 6.32843 13.5 5.5C13.5 4.67157 12.8284 4 12 4ZM12 10.5C11.1716 10.5 10.5 11.1716 10.5 12C10.5 12.8284 11.1716 13.5 12 13.5C12.8284 13.5 13.5 12.8284 13.5 12C13.5 11.1716 12.8284 10.5 12 10.5ZM10.5 18.5C10.5 17.6716 11.1716 17 12 17C12.8284 17 13.5 17.6716 13.5 18.5C13.5 19.3284 12.8284 20 11.1716 20C10.5 19.3284 10.5 18.5 10.5 18.5Z"
                            Foreground="{StaticResource MpvCardRingBrush}" />
                    </Viewbox>
                </Button>

                <!--  The tick box. Shown only in selection mode; the whole card is
                      the hit target, so this is an indicator. -->
                <Border
                    x:Name="SelectionBox"
                    Width="24"
                    Height="24"
                    Margin="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <FontIcon
                        x:Name="SelectionGlyphIcon"
                        FontSize="{StaticResource MpvCardTickFontSize}" />
                </Border>
            </Grid>
        </Grid>
    </Button>
</UserControl>
