<UserControl
    x:Class="mpv_winui.Domains.Playback.PlayerTrackSelectorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:mpv_winui.Domains.Playback"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="TrackListViewItemStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="{StaticResource MpvPopupRowMinHeight}" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <!--
          A SelectorBar is only the tab strip: unlike the Pivot it replaces it
          has no content host, so the four lists are stacked in one Grid cell
          and swapped by Visibility from TrackSelectorBar_SelectionChanged.
          Both rows live in this inner Grid so the Pivot's Padding and
          MinHeight move here with the content they used to wrap.

          Every SelectorBarItem is Text + Icon only. The item template in WinUI
          2.3.9 presents exactly two things: PART_IconVisual bound to Icon and
          PART_TextVisual bound to Text, and leaves Child behind a bare
          "Placeholder for Child UIElement" comment, so a composite header put
          in Child would render an empty tab and raise nothing. The old Pivot
          header was icon + caption + count; the count is folded into Text
          instead, which is why the captions are composed in code.
        -->
        <Grid MinHeight="240" Padding="{StaticResource MpvPopupContentPadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar
                x:Name="TrackSelectorBar"
                IsTabStop="False"
                SelectionChanged="TrackSelectorBar_SelectionChanged">
                <SelectorBarItem x:Name="SubtitleTab" IsSelected="True">
                    <SelectorBarItem.Icon>
                        <FontIcon FontSize="{StaticResource MpvPopupIconSize}" Glyph="&#xED1E;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="SecondSubtitleTab">
                    <SelectorBarItem.Icon>
                        <FontIcon FontSize="{StaticResource MpvPopupIconSize}" Glyph="&#xED1E;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="VideoTab">
                    <SelectorBarItem.Icon>
                        <FontIcon FontSize="{StaticResource MpvPopupIconSize}" Glyph="&#xE8B2;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="AudioTab">
                    <SelectorBarItem.Icon>
                        <FontIcon FontSize="{StaticResource MpvPopupIconSize}" Glyph="&#xE8D6;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <Grid Grid.Row="1">
                <ListView
                    x:Name="SubtitleListView"
                    Margin="{StaticResource MpvPopupListMargin}"
                    IsItemClickEnabled="True"
                    IsTabStop="False"
                    ItemClick="SubtitleListView_ItemClick"
                    ItemContainerStyle="{StaticResource TrackListViewItemStyle}"
                    ItemsSource="{x:Bind SubtitleItems, Mode=OneWay}"
                    SelectionChanged="SubtitleListView_SelectionChanged"
                    SelectionMode="Single"
                    SingleSelectionFollowsFocus="False"
                    Visibility="Visible">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TrackItem">
                            <TextBlock
                                MaxLines="2"
                                FontSize="{StaticResource MpvPopupLabelFontSize}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Label, Mode=OneTime}"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind Label, Mode=OneTime}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ListView
                    x:Name="SecondSubListView"
                    Margin="{StaticResource MpvPopupListMargin}"
                    IsItemClickEnabled="True"
                    IsTabStop="False"
                    ItemClick="SecondSubListView_ItemClick"
                    ItemContainerStyle="{StaticResource TrackListViewItemStyle}"
                    ItemsSource="{x:Bind SecondSubItems, Mode=OneWay}"
                    SelectionChanged="SecondSubListView_SelectionChanged"
                    SelectionMode="Single"
                    SingleSelectionFollowsFocus="False"
                    Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TrackItem">
                            <TextBlock
                                FontSize="{StaticResource MpvPopupLabelFontSize}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Label, Mode=OneTime}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind Label, Mode=OneTime}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ListView
                    x:Name="VideoListView"
                    Margin="{StaticResource MpvPopupListMargin}"
                    IsItemClickEnabled="True"
                    IsTabStop="False"
                    ItemClick="VideoListView_ItemClick"
                    ItemContainerStyle="{StaticResource TrackListViewItemStyle}"
                    ItemsSource="{x:Bind VideoItems, Mode=OneWay}"
                    SelectionChanged="VideoListView_SelectionChanged"
                    SelectionMode="Single"
                    SingleSelectionFollowsFocus="False"
                    Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TrackItem">
                            <TextBlock
                                FontSize="{StaticResource MpvPopupLabelFontSize}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Label, Mode=OneTime}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind Label, Mode=OneTime}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ListView
                    x:Name="AudioListView"
                    Margin="{StaticResource MpvPopupListMargin}"
                    IsItemClickEnabled="True"
                    IsTabStop="False"
                    ItemClick="AudioListView_ItemClick"
                    ItemContainerStyle="{StaticResource TrackListViewItemStyle}"
                    ItemsSource="{x:Bind AudioItems, Mode=OneWay}"
                    SelectionChanged="AudioListView_SelectionChanged"
                    SelectionMode="Single"
                    SingleSelectionFollowsFocus="False"
                    Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:TrackItem">
                            <TextBlock
                                FontSize="{StaticResource MpvPopupLabelFontSize}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Label, Mode=OneTime}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTipService.ToolTip="{x:Bind Label, Mode=OneTime}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SecondSubGroupStates">
                <VisualState x:Name="NormalState" />
                <VisualState x:Name="SecondSubState">
                    <VisualState.Setters>
                        <Setter Target="SecondSubtitleTab.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
