<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <RootNamespace>mpv_winui</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Platforms>x64;ARM64</Platforms>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <PublishProfile>win-$(Platform).pubxml</PublishProfile>
        <UseWinUI>true</UseWinUI>
        <WinUISDKReferences>false</WinUISDKReferences>
        <EnableMsixTooling>true</EnableMsixTooling>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <CsWinRTIncludes>mpv_winrt</CsWinRTIncludes>
        <IsAotCompatible>true</IsAotCompatible>
        <PublishAot>true</PublishAot>
        <PublishTrimmed>true</PublishTrimmed>
        <SelfContained>true</SelfContained>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <ApplicationIcon>App.ico</ApplicationIcon>
        <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
        <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    </PropertyGroup>

    <PropertyGroup>
        <EnabledXamlOptionalChanges>DefaultStyleOptimizations,OptimizeApplyStyles,IconNoGridOptimization,DeferContextFlyoutInit</EnabledXamlOptionalChanges>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Assets\SplashScreen.scale-200.png" />
        <Content Include="Assets\LockScreenLogo.scale-200.png" />
        <Content Include="Assets\Square150x150Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
        <Content Include="Assets\Wide310x150Logo.scale-200.png" />
        <Content Include="Assets\FluentSystemIcons-Regular.ttf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Manifest Include="$(ApplicationManifest)" />
    </ItemGroup>

    <!--
      Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
      Tools extension to be activated for this project even if the Windows App SDK Nuget
      package has not yet been restored.
    -->
    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <ProjectCapability Include="Msix" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260610101">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!--
          WinUI analyzer: the WUI0xxx-WUI4xxx rules for WinUI 3 correctness
          (UWP API remnants, layout and binding pitfalls, MVVM, interop).

          Added because nothing was checking those rules: before this reference the
          only diagnostics were the XAML compiler's WMC warnings and the CsWinRT
          source-generator analyzers, so a review could say "the build is clean"
          while never having run the checks this project needs most. It found 214
          findings on the first run, and the first thing it found was that one of
          its own rules was wrong (WUI2003 claims Pivot is UWP-only; `winapp
          find-api` reports Microsoft.UI.Xaml.Controls.Pivot with 308 members).

          PrivateAssets=all: it must not flow to consuming projects.
        -->
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.7.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!--
          Windows App SDK: referenced as the meta-package, pinned as one version.

          The split packages this replaced (Base 2.0.4 / Foundation 2.3.9 /
          InteractiveExperiences 2.1.6 / WinUI 2.3.6 / Runtime 2.4.0) matched no
          shipped meta-package: every meta-package from 2.3.x through 2.5.x pins
          Foundation/IE/WinUI to a matching triple and pins Runtime with an exact
          version (e.g. [2.5.1]), so taking components from four different places
          produced a combination Microsoft never tested, and NuGet could not warn
          about it, because each split package only depends on Base, so the
          mismatch is invisible to restore.

          2.5.1 is the choice because it is the closest shipped family to what the
          project was already resolving: the old set was ahead of the 2.3.1 family
          in every component (Runtime 2.4.0 vs [2.3.1], Foundation 2.3.9 vs 2.3.5,
          WinUI 2.3.6 vs 2.3.0, IE 2.1.6 vs 2.1.3) and behind the 2.5.1 family, so
          both candidates are a convergence; 2.5.1 converges forward instead of
          downgrading Runtime. Its transitive set is
          Base 2.0.4 / Foundation 2.3.12 / IE 2.1.9 / WinUI 2.3.9 /
          DWrite 2.1.0 / Runtime [2.5.1].

          Known cost, accepted deliberately: the meta-package also pulls in
          WindowsAppSDK.Widgets, .AI, .ML and .Search. They carry no code this app
          references, but they do appear in the restore graph, which is the price
          of a tested-as-a-whole version set. If the extra reference graph ever
          becomes a problem, the honest way back is to pin the exact set above as
          five individual packages rather than to float one of them.
        -->
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
        <!--
          Excluding the four feature areas the meta-package drags in that this app
          never calls.

          Those references are not inert. With WindowsAppSDKSelfContained the
          framework payload of every referenced component is copied into the
          published output, and the AI/ML components bring real runtimes with
          them: a Release x64 build measured 20.7 MB of onnxruntime.dll,
          17.8 MB of DirectML.dll, Microsoft.ML.OnnxRuntime.dll and AI Fabric
          assemblies, none of which a video player loads. Excluding their assets
          keeps what the meta-package is actually wanted for, a version set that
          Microsoft tests together, without shipping a machine-learning stack to
          watch films.

          The versions are spelled out because a PackageReference needs one. They
          are exactly what the 2.5.1 meta-package pins, so they agree today; if a
          later meta-package raises one of them, these lines produce an NU1605
          downgrade error rather than silently diverging, which is the intended
          failure. Delete a line here and that component's payload comes back.
        -->
        <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" ExcludeAssets="all" />
        <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="2.1.94" ExcludeAssets="all" />
        <PackageReference Include="Microsoft.WindowsAppSDK.Search" Version="2.5.5" ExcludeAssets="all" />
        <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" ExcludeAssets="all" />
        <!--
          One level deeper, and the reason this cannot be left out: WindowsAppSDK.ML
          depends on Microsoft.Windows.AI.MachineLearning, and that package's
          buildTransitive targets hard-fail the build below Windows 10 19H1:

            Microsoft.Windows.AI.MachineLearning requires SupportedOSPlatformVersion
            Windows 10 19H1 (build 18362) or later.

          This app targets 17763. Excluding only the four named components left
          that target in the graph and produced exactly that error. Pulling it in
          needs its own exclusions, so the AI stack is excluded at both levels.
        -->
        <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="all" />
        <PackageReference Include="NAudio" Version="2.2.1" />
        <PackageReference Include="NLog" Version="6.2.0" />
        <PackageReference Include="System.Management" Version="10.0.11" />
    </ItemGroup>
    <!--
      Build modes:
      - Local (default): mpv_winrt is built separately by build.ps1 with VS MSBuild,
        and referenced from ..\bin\$(Platform)\$(Configuration)\mpv_winrt\.
        `dotnet build` cannot build the C++ project (VCTargetsPath is a VS component).
      - CI: pass /p:BuildMpvWinrtWithReference=true so the C++ project is built
        as a ProjectReference (matches upstream GitHub Actions / msbuild).
    -->
    <ItemGroup Condition="'$(BuildMpvWinrtWithReference)' == 'true'">
        <ProjectReference Include="..\mpvw-native\mpv-winrt.vcxproj" />
    </ItemGroup>
    <ItemGroup Condition="'$(BuildMpvWinrtWithReference)' != 'true'">
        <Reference Include="mpv_winrt.winmd">
            <HintPath>..\bin\$(Platform)\$(Configuration)\mpv_winrt\mpv_winrt.winmd</HintPath>
        </Reference>
        <Content Include="..\bin\$(Platform)\$(Configuration)\mpv_winrt\mpv_winrt.dll" Link="mpv_winrt.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <Page Update="Domains\Playback\MpvPlayerPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </Page>
    </ItemGroup>
    <ItemGroup>
        <Content Include="Languages\**\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\mpv-winui-lazy\input.conf">
            <Link>Config\input.conf</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Menus\menus.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Option metadata for the mpv.conf editor, generated from the mpv build's
         own list-options output by tools/gen-mpv-options.py. Shipped so the
         editor has definitions on a fresh install; a user-supplied
         mpv-conf-editor directory still takes precedence at runtime. -->
    <ItemGroup>
        <Content Include="MpvConfOptions\mpv-options.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Bundled mpv config layer: copied next to the exe so ConfigDeployer can
         seed %LOCALAPPDATA%\mpv-winui\mpv on first run (portable zip + MSI).
         Runtime dirs (cache) and the user-override menus.json are excluded. -->
    <ItemGroup>
        <Content Include="..\..\mpv-winui-lazy\**\*" Exclude="..\..\mpv-winui-lazy\cache\**;..\..\mpv-winui-lazy\_cache\**">
            <Link>mpv-winui-lazy\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!--
      mpv and MediaInfo are per-architecture native DLLs, so they are resolved
      from libs\bin\$(Platform)\.

      These used to be two hardcoded x64 pairs (Debug|x64 and Release|x64, one
      item each for the two files). The effect was not that ARM64 lacked the
      DLLs but that it built "successfully" without them: no item matched, so
      nothing was copied, and the package shipped with no mpv engine in it. The
      Include is conditioned on existence so that the item list stays clean, and
      the CheckNativeRuntimeLibraries target below turns the absent case into a
      build error instead of a silently incomplete package.
    -->
    <ItemGroup>
        <Content Include="..\libs\bin\$(Platform)\mpv-2.dll" Condition="Exists('..\libs\bin\$(Platform)\mpv-2.dll')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\libs\bin\$(Platform)\MediaInfo.dll" Condition="Exists('..\libs\bin\$(Platform)\MediaInfo.dll')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <None Update="App.ico">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <!--
      Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
      Explorer "Package and Publish" context menu entry to be enabled for this project even if
      the Windows App SDK Nuget package has not yet been restored.
    -->
    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>

    <!-- Publish Properties -->
    <PropertyGroup>
        <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
        <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
        <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
        <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
        <!--
          SupportedOSPlatformVersion is deliberately NOT set here.

          This group used to assign it 10.0.22000.0 unconditionally. Property
          assignment is last-wins, so that line silently replaced the 10.0.17763.0
          declared at the top of the file, and the effective floor became Windows
          11 for every configuration, including Debug. Nothing else agreed with
          it: TargetPlatformMinVersion above, app.manifest, and
          Package.appxmanifest all say 17763.

          17763 is the correct value, not 22000: the Windows App SDK 2.5.1
          assemblies this app references ship under lib\net6.0-windows10.0.17763.0\,
          so 17763 is the floor the framework itself supports. Leaving the stray
          override in place did not make the app Windows 11 only, it only made
          the analyzer believe so, which is the worse outcome: CA1416 would stay
          silent about genuinely Windows 11 only APIs while the package manifest
          kept promising support for 1809 and later.

          With the override gone, SupportedOSPlatformVersion falls back to
          TargetPlatformMinVersion (17763) and all four declarations agree. Any
          API that needs a newer build now produces a CA1416 warning at compile
          time, which is the point.
        -->
        <PackageCertificateThumbprint>103E497FCC93E634D6CF01D48A6779F3788332CD</PackageCertificateThumbprint>
        <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
        <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
        <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
        <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
        <AppxSymbolPackageEnabled>True</AppxSymbolPackageEnabled>
        <GenerateTestArtifacts>False</GenerateTestArtifacts>
        <AppxBundle>Never</AppxBundle>
        <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
        <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
        <AssemblyName>mpvw</AssemblyName>
        <!--
          TargetName must match AssemblyName: the Windows App SDK XAML targets build the
          MarkupCompilePass2 LocalAssembly path from $(TargetName)$(TargetExt), while
          MarkupCompilePass1 writes the intermediate assembly using $(AssemblyName). If the
          two disagree, Pass2 cannot find its local assembly and silently emits 0-byte .g.cs
          for every XAML in the project (WMC1509 -> WMC0001/WMC9999 -> bogus CS0101).
        -->
        <TargetName>$(AssemblyName)</TargetName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
      <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
      <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
      <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
      <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    </PropertyGroup>

    <!--
      Unpackaged WinUI 3 apps may look for either resources.pri or <AppName>.pri
      depending on the Windows App SDK version; keep both names in the output.
    -->
    <Target Name="CopyPriAsAppName" AfterTargets="Build;Publish" Condition="Exists('$(OutputPath)resources.pri')">
        <Copy SourceFiles="$(OutputPath)resources.pri" DestinationFiles="$(OutputPath)$(AssemblyName).pri" SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(OutputPath)resources.pri" DestinationFiles="$(PublishDir)$(AssemblyName).pri" SkipUnchangedFiles="true" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
    </Target>

    <!--
      Framework localization trimming.

      Windows App SDK ships WinUI's .mui resources once per culture, and each
      culture lands in its own folder in the output - 87 folders holding two
      .mui files each, which is most of the directory count in a deployment
      whose actual app content is a handful of folders.

      The app's own UI strings do not come from there: they come from
      Languages\*.json (the nine files below). What the .mui files localize is
      framework-internal text, so keeping exactly the cultures the app ships
      leaves no supported locale without its framework resources and drops 78
      near-empty folders from the output.

      Implemented as a post-build sweep rather than by excluding items from the
      Windows App SDK payload target: that target is an internal name, and an
      AfterTargets hook on a name that later changes would silently stop
      running, whereas this one is driven by what is actually on disk.
    -->
    <PropertyGroup>
        <ShippedLocaleCultures>en-us;de-DE;es-ES;fr-FR;ja-JP;ko-KR;ru-RU;zh-CN;zh-TW</ShippedLocaleCultures>
    </PropertyGroup>

    <Target Name="TrimFrameworkLocales" AfterTargets="Build;Publish">
        <ItemGroup>
            <!-- Derive the folders from the .mui files themselves: file globs are
                 reliable, directory globs are not. -->
            <_LocaleMuiFile Include="$(OutDir)*\*.mui" />
            <_LocaleMuiFile Include="$(PublishDir)*\*.mui" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
            <_LocaleDir Include="@(_LocaleMuiFile->'%(RootDir)%(Directory)')" />

            <!-- The kept folders must be spelled the same way as the ones being
                 filtered: both sides go through %(RootDir)%(Directory), so the
                 comparison is absolute-vs-absolute. $(OutDir) is relative to the
                 project directory, and mixing the two silently matches nothing -
                 which deletes the languages that were supposed to be kept. -->
            <_LocaleKeep Include="$(OutDir)en-us\*.mui" />
            <_LocaleKeep Include="$(OutDir)de-DE\*.mui" />
            <_LocaleKeep Include="$(OutDir)es-ES\*.mui" />
            <_LocaleKeep Include="$(OutDir)fr-FR\*.mui" />
            <_LocaleKeep Include="$(OutDir)ja-JP\*.mui" />
            <_LocaleKeep Include="$(OutDir)ko-KR\*.mui" />
            <_LocaleKeep Include="$(OutDir)ru-RU\*.mui" />
            <_LocaleKeep Include="$(OutDir)zh-CN\*.mui" />
            <_LocaleKeep Include="$(OutDir)zh-TW\*.mui" />
            <_LocaleKeep Include="$(PublishDir)en-us\*.mui" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
            <_LocaleKeep Include="$(PublishDir)de-DE\*.mui" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
            <_LocaleKeep Include="$(PublishDir)es-ES\*.mui" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
            <_LocaleKeep Include="$(PublishDir)fr-FR\*.mui" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
            <_LocaleKeep Include="$(PublishDir)ja-JP\*.mui" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
            <_LocaleKeep Include="$(PublishDir)ko-KR\*.mui" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
            <_LocaleKeep Include="$(PublishDir)ru-RU\*.mui" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
            <_LocaleKeep Include="$(PublishDir)zh-CN\*.mui" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
            <_LocaleKeep Include="$(PublishDir)zh-TW\*.mui" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
            <_LocaleKeepDir Include="@(_LocaleKeep->'%(RootDir)%(Directory)')" />

            <_LocaleDir Remove="@(_LocaleKeepDir)" />
        </ItemGroup>
        <RemoveDir Directories="@(_LocaleDir)" />
        <Message Importance="normal" Text="Trimmed @(_LocaleDir->Count()) unused framework locale folder(s); kept: $(ShippedLocaleCultures)" />
    </Target>

    <!--
      Fails the build when the native runtime libraries for the target
      architecture are missing.

      This is the guard that the x64-only Content conditions never provided. The
      app loads mpv-2.dll at runtime, so a package built without it does not fail
      at build time, at package time, or even at launch: it fails when the user
      presses play, with a missing-DLL error, after a package has already been
      shipped. An absent per-architecture runtime library is a packaging defect
      and is reported as one here, before anything is copied.

      Runs before the build rather than before publish so the ordinary developer
      build catches it too.
    -->
    <Target Name="CheckNativeRuntimeLibraries" BeforeTargets="BeforeBuild">
        <PropertyGroup>
            <_NativeRuntimeDir>$(MSBuildThisFileDirectory)..\libs\bin\$(Platform)\</_NativeRuntimeDir>
        </PropertyGroup>
        <Error Condition="!Exists('$(_NativeRuntimeDir)mpv-2.dll')"
               Text="The mpv runtime library for platform '$(Platform)' is missing: '$(_NativeRuntimeDir)mpv-2.dll'. Native libraries are per-architecture and live in libs\bin\&lt;Platform&gt;\. Run tools\fetch-mpv-libs.ps1 (or .\build.ps1 -FetchMpvLibs) for x64. For ARM64 an aarch64 build of mpv-2.dll must be supplied and placed at that path; without it this configuration would produce a package with no player in it, which is why the build stops here." />
        <Error Condition="!Exists('$(_NativeRuntimeDir)MediaInfo.dll')"
               Text="The MediaInfo runtime library for platform '$(Platform)' is missing: '$(_NativeRuntimeDir)MediaInfo.dll'. It ships alongside mpv-2.dll in libs\bin\&lt;Platform&gt;\ and is loaded by the app for media information; without it the media-information panel fails at runtime." />
    </Target>
</Project>
