<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows App SDK entries below are pinned as one whole group, mirroring the
  exact versions that the app's Microsoft.WindowsAppSDK 2.5.1 meta-package
  resolves (see mpv-winui/mpv-winui/mpv-winui.csproj). mpv_winrt.dll is loaded
  in the app's process next to the framework binaries, so its components must
  come from the same family the app ships; that, not the entry names, is what
  keeps the two sides consistent.

  Why the meta-package id itself is not listed here: packages.config is flat, and
  the meta-package's own native targets ship a guard
  (WindowsAppSDKVerifyTransitiveDependencies, in
  build/native/Microsoft.WindowsAppSDK.targets) that fails the build unless
  packages.config names EVERY dependency in the meta-package nuspec. For 2.5.1
  that means also listing Widgets, AI, ML and Search, which a native video
  component never links against. Listing the family members directly, at the
  versions the meta-package pins, gives the same whole-group guarantee without
  pulling four unused packages into a C++ restore.

  The durable fix is to migrate this project to PackageReference, where the
  meta-package resolves its own dependencies and this duplication disappears.
  That is a build-system change that cannot be compiled in the environment that
  produced this edit, so it is deliberately left as a follow-up rather than
  applied blind.
-->
<packages>
  <package id="Microsoft.Web.WebView2" version="1.0.4129.50" targetFramework="native" />
  <package id="Microsoft.Windows.CppWinRT" version="3.0.260818.1" targetFramework="native" />
  <package id="Microsoft.Windows.ImplementationLibrary" version="1.0.260126.7" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.BuildTools" version="10.0.28000.2526" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.BuildTools.MSIX" version="1.7.260610101" targetFramework="native" developmentDependency="true" />
  <package id="Microsoft.WindowsAppSDK.Base" version="2.0.4" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.DWrite" version="2.1.0" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.Foundation" version="2.3.12" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.InteractiveExperiences" version="2.1.9" targetFramework="native" />
  <package id="Microsoft.WindowsAppSDK.WinUI" version="2.3.9" targetFramework="native" />
</packages>
